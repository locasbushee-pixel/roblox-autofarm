-- الأسماء اللي يحتاجها الكود تحت — تبقى في الـ chunk، والباقي كلّه داخل do/end ويطلع من العد
local UI, panels, LogBox, LogText, StatusText, SpeedText, PointsText = {}, {}, nil, nil, nil, nil, nil
local ToggleBtn, CloseBtn, MoveBtn, DropBtn, DelivBtn, CopyBtn, ClearBtn, syncNumBoxes
