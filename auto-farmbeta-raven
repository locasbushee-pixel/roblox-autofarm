  -- 9 تبويبات (كانت 6 بعرض 91، ثم 8 بعرض 66). العرض = (576 - 8×6) / 9 = 58 — والأسماء بلا «ال»
  -- عشان «القياسات» ما تنقطع على الجوال. الفرق 6px = ما تلصق الأزرار ببعض (قاعدة touch-spacing).
  local TAB_Y, TAB_H, TAB_W, TAB_P = 102, 34, 58, 6
  local function showTab(nm)
    for _, t in ipairs(REG.tabs) do
      local on = (t.name == nm)
      t.btn.BackgroundColor3 = on and COL.SURF or COL.BG
      t.btn.TextColor3 = on and COL.TEXT or COL.CAP
      t.btn.Font = on and Enum.Font.GothamBold or Enum.Font.Gotham
      t.ind.BackgroundColor3 = on and COL.ACCENT or COL.LINE
      t.ind.BackgroundTransparency = on and 0 or 0.75
      t.panel.Visible = on
    end
  end
  local function mkTab(nm, txt)
    local i = #REG.tabs + 1
    local b = uiBtn(MainFrame, 12 + (i - 1) * (TAB_W + TAB_P), TAB_Y, TAB_W, TAB_H, COL.BG, txt, "Tab_" .. nm, 11)
    local ind = Instance.new("Frame")
    ind.BorderSizePixel = 0
    ind.Parent = b
    place(ind, 6, 30, 46, 3)
    pcall(function()
      local c = Instance.new("UICorner")
      c.CornerRadius = UDim.new(1, 0)
      c.Parent = ind
    end)
    local p = Instance.new("Frame")
    p.BackgroundColor3 = COL.PANEL
    p.BackgroundTransparency = 0.1
    p.BorderSizePixel = 0
    p.Visible = false
    p.Parent = MainFrame
    place(p, 12, 142, 576, 300)
    round(p, 10)
    stroke(p, COL.LINE, 1)
    b.MouseButton1Click:Connect(function() showTab(nm) end)
    REG.tabs[i] = { name = nm, btn = b, panel = p, ind = ind }
    panels[nm] = p
    return p
  end
  -- إيقاع 8px: صفّ عادي 40 (زر 32 + فراغ 8) — وصفحات الحركة/الدفاع/القياسات مكتظة فـ 29 (زر 24)
  local function row(i) return 8 + (i - 1) * 40 end
