-- ====================================================================
local isRunning = false
local START_POS = Vector3.new(-36.28, 74.17, -3082.30)
local startingPoints = 0
local gainedPoints = 0

-- متابعة النقاط
task.spawn(function()
    local leaderstats = lp:WaitForChild("leaderstats", 5)
    if leaderstats then
        for _, val in ipairs(leaderstats:GetChildren()) do
            if string.find(val.Name, "نقا") or val.Name:lower():find("point") then
                startingPoints = val.Value
                val.Changed:Connect(function(newVal)
                    gainedPoints = newVal - startingPoints
                    PointsText.Text = "النقاط المكتسبة: +" .. tostring(gainedPoints)
                end)
                break
            end
        end
    end
end)

-- دالة المشي كـ NPC مع نظام فك التعليق الذكي
local function walkToTarget(destination)
    local char = lp.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end

    -- إعداد مسار آمن يتفادى العوائق ويسمح بالقفز
    local path = PathfindingService:CreatePath({
        AgentRadius = 2.5,
        AgentHeight = 5.0,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 4.0
    })

    local success = pcall(function()
        path:ComputeAsync(root.Position, destination)
    end)

    if not success or path.Status ~= Enum.PathStatus.Success then
        -- إذا لم يجد مسار، يمشي للأمام مع مراقبة المسافة
        hum:MoveTo(destination)
        local t = tick()
        while isRunning and (tick() - t < 4) do
            if (root.Position - destination).Magnitude <= 4 then break end
            task.wait(0.1)
        end
        return true
    end

    local waypoints = path:GetWaypoints()
    for i, wp in ipairs(waypoints) do
        if not isRunning then break end

        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end

        hum:MoveTo(wp.Position)

        -- 🛡️ نظام المراقبة وفك التعليق (Watchdog)
        local moveStart = tick()
        local lastPos = root.Position
        
        while isRunning do
            local currentDist = (root.Position - wp.Position).Magnitude
            if currentDist <= 3.5 then
                break
            end

            -- فحص هل الشخصية متوقفة في مكانها (علق بعمود/تيل/جدار)
            if tick() - moveStart > 1.8 then
                local moved = (root.Position - lastPos).Magnitude
                if moved < 1.0 then
                    addLog("⚠️ رصد تعليق بعائق! جاري فك التعليق والقفز...")
                    hum.Jump = true
                    
                    -- إعطاء دفعة للأمام لتخطي العمود (Micro-Bypass)
                    local dir = (destination - root.Position).Unit
                    root.CFrame = root.CFrame + Vector3.new(dir.X * 3.5, 1.2, dir.Z * 3.5)
                    task.wait(0.2)
                    break
                end
                lastPos = root.Position
                moveStart = tick()
            end
            task.wait(0.05)
        end
    end
    return true
end

-- دالة الضغط على زر [E]
local function triggerChestPrompt()
    local prompt = nil
    local starter = Workspace:FindFirstChild("DeliveryCrates") 
        and Workspace.DeliveryCrates:FindFirstChild("CratesStarter")
        and Workspace.DeliveryCrates.CratesStarter:FindFirstChild("TakeChest")
    
    if starter then
        prompt = starter:FindFirstChildWhichIsA("ProximityPrompt")
    end

    if not prompt then
        for _, p in ipairs(Workspace:GetDescendants()) do
            if p:IsA("ProximityPrompt") and (p.ActionText:find("صندوق") or p.ActionText:find("اخذ") or (p.Parent and p.Parent.Name == "TakeChest")) then
                prompt = p
                break
            end
        end
    end

    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
            fireproximityprompt(prompt, 1)
            fireproximityprompt(prompt)
        end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
        return true
    end
    return false
end

-- البحث عن الهدف النشط
local function findDeliveryTarget()
    local char = lp.Character
    local dcFolder = Workspace:FindFirstChild("DeliveryCrates")
    if dcFolder then
        for _, child in ipairs(dcFolder:GetDescendants()) do
            if child:IsA("BasePart") and child.Name ~= "CratesStarter" and not child:IsDescendantOf(char) then
                if child.Transparency < 1 and (child.Position - START_POS).Magnitude > 25 then
                    return child.Position, child
                end
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Beam") or obj:IsA("Highlight") or obj:IsA("BillboardGui")) and not obj:IsDescendantOf(char) then
            local part = obj.Parent
            if part and part:IsA("BasePart") and (part.Position - START_POS).Magnitude > 25 then
                return part.Position, part
            end
        end
    end

    return Vector3.new(-388.96, 73.00, -2665.44), nil
end

-- دورة الفارم المستمرة
local function runFarmCycle()
    task.spawn(function()
        while isRunning do
            local char = lp.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if not root or not hum then task.wait(1) continue end

            -- 1. المشي لنقطة الصناديق
            StatusText.Text = "الحالة: 🚶 مشي نحو نقطة الصناديق..."
            addLog("المشي نحو TakeChest...")
            walkToTarget(START_POS)
            task.wait(0.3)

            -- 2. أخذ الصندوق
            StatusText.Text = "الحالة: ✋ استلام الصندوق [E]..."
            triggerChestPrompt()
            task.wait(0.6)

            -- 3. تحديد نقطة التسليم
            StatusText.Text = "الحالة: 🔍 رصد موقع التسليم..."
            local targetPos, targetPart = findDeliveryTarget()
            addLog(string.format("هدف التسليم: Vector3.new(%.1f, %.1f, %.1f)", targetPos.X, targetPos.Y, targetPos.Z))

            -- 4. المشي نحو نقطة التسليم مع فك التعليق
            StatusText.Text = "الحالة: 🚚 التوجه لتسليم الصندوق..."
            walkToTarget(targetPos)
            task.wait(0.4)

            -- لمس النقطة
            if targetPart and firetouchinterest and root then
                firetouchinterest(root, targetPart, 0)
                task.wait(0.1)
                firetouchinterest(root, targetPart, 1)
            end

            addLog("تم الوصول والتسليم! الدورة التالية بعد ثانية...")
            task.wait(1.5)
        end
    end)
end

