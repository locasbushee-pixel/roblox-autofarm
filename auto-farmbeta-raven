local PRMAP = {}
-- v2h: برومبت أبوه Model بلا PrimaryPart كان يرجّع nil ← dd=999 ← walkToTarget(nil) ← انهيار الدورة.
-- GetPivot يغطي أي Model/PVInstance، وPrimaryPart احتياط بعده.
local function prHostPos(d)
  local h = d.Parent
  if not h then return nil end
  local ok, p = pcall(function() return h.Position end)
  if ok and p then return p end
  local okP, pv = pcall(function() return h.GetPivot and h:GetPivot().Position end)
  if okP and pv then return pv end
  local pp = (h.PrimaryPart or (h.FindFirstChild and h:FindFirstChild("HumanoidRootPart")))
  local ok2, p2 = pcall(function() return pp and pp.Position or nil end)
  return (ok2 and p2) or nil
end
local SWEEP_DONE = false
local GYM_WORDS = { "نادي", "تدريب", "رياض", "لياق", "تمرين", "gym", "train" }
local GYM_SEEN = setmetatable({}, { __mode = "k" })   -- (48) مفاتيح ضعيفة: keys=برومبتات، تنمسح معهم
local function gymProbe(d, info)
