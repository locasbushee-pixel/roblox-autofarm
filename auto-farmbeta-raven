end)

local function heldByGame()
  local r, hum = rootOf()
  if hum then
    local ok, ws = pcall(function() return hum.WalkSpeed end)
    if ok and ws == 0 then return "WS=0 (مقيّد)" end
    local okS, st = pcall(function()
      -- GetState = حالتك الحية. GetStateEnabled = «هل هذي الحالة مسموحة» = صحيحة دائمًا
      -- وأنت تمشي طبيعي، فقبل كنا نرجع PlatformStand على طول → AUTO_PAUSE يوقف 120 ثانية
      -- كل دورة (شكواك «السكربت يوقف لحاله»).
      local cur = hum.GetState and hum:GetState()
      if cur == Enum.HumanoidStateType.PlatformStand or cur == Enum.HumanoidStateType.Ragdoll
        or cur == Enum.HumanoidStateType.Physics or cur == Enum.HumanoidStateType.FallingDown
        or cur == Enum.HumanoidStateType.Dead then   -- ميت = مقيّد: ما نمشي بشخصية طايحة
        return tostring(cur.Name)
      end
      return nil
    end)
    if okS and st then return st end
  end
  local okJ, j = pcall(function()
    for _, c in ipairs(lp:GetChildren()) do
      local jt = c:FindFirstChild("Time")
      if jt and tonumber(jt.Value) and tonumber(jt.Value) > 0 then
        return c.Name .. "=" .. tostring(jt.Value) .. "ث"
      end
    end
    return nil
  end)
  if okJ and j then return "سجن " .. tostring(j) end
  -- (30) ربط خارجي: طرف من الـWeld/Motor6D/Constraint داخل شخصيتك والثاني براها = محمول/مكلبش
  --        بحاجز. مقصود مطفي افتراضيًا: التعلّق بنفس الشكل حق مقود السيارة والمقعد، ولو حسبناه
  --        قيدًا كان الفرم يوقف كل ما ركبتم. root.Anchored حالة واضحة (ما يركّبونه وأنت تمشي).
  if CFG.ATTACH_SEE then
    local okA, a = pcall(function()
      local c = lp.Character
      if not c then return nil end
      if r and r.Anchored then return "Anchored" end
      for _, ins in ipairs(c:GetChildren()) do
        if CLINK[ins.ClassName] then
          local p0, p1 = ins.Part0, ins.Part1
          if not (p0 and p1) then
            local at0, at1 = ins.Attachment0, ins.Attachment1
            if at0 and at1 then p0, p1 = at0.Parent, at1.Parent end
          end
          if p0 and p1 then
            local in0, in1 = (p0.Parent == c), (p1.Parent == c)
            if in0 ~= in1 then return "مربوط بـ" .. tostring((in0 and p1 or p0).Name) end
          end
        end
      end
      return nil
    end)
    if okA and a then return a end
  end
  return nil
end

-- ═══════════ الدورة ═══════════
-- إعادة التشغيل ما كانت توقف الثريد القديم: Events + 10 حلقات مراقبة كانت تبقى حية،
-- فتنسخ السكربت (اثنان يضغطان E ويمشّيان بنفس الوقت). الحين: RUN.id = جيل الدورة،
-- وALIVE = مفتاح كل الحلقات، وdisconnectAll تفصل الاتصالات — والنسخة الجديدة تنادي shutdown.
_G.RAVEN_STOP = function() shutdown("إعادة تشغيل") end

local function cycle()
  RUN.id = RUN.id + 1
  RUN.carryChecked = false   -- (46) كل تشغيل جديد يستاهل فحص «عليه مهمة من قبل؟» مرة وحدة
  RUN.restUntil = 0          -- (46) راحة الجلسة السابقة ما توقف تشغيلك الجديد
  local myId = RUN.id
  RUN.thread = task.spawn(function()
    local retryDeliver = false   -- ما لمسنا نقطة التسليم = المهمة لسه شغالة، نرجع لها بدون استلام جديد
    local retryN = 0
    while ALIVE and isRunning and RUN.id == myId do
      local r, hum = rootOf()
      if not r or not hum then task.wait(1) continue end

      -- 0) متّ = السكربت يوقف، ما يكمّل على الشخصية الجديدة (شكوى المنشور: «لو مات اللاعب ما يوقف»)
      --    تحت المراقبة: RUN.dead يمسّيها الـ Died handler، والـ DEATH_STOP يقرّر لو نقف نهائي
      if RUN.dead then
        log("zDEATH hold — أنت ميت: الدورة واقفة، ما نمشي ولا نضغط E")
        while ALIVE and isRunning and RUN.dead do task.wait(0.5) end
        continue
      end

      -- 0) (46) راحة مؤقتة: الحارس قال «صحة واطية/اشتباك/سقوط» = ننتظر ثواني ونكمّل لحالنا.
      --    الفرق عن قبل: ما يصير halt() ولا «دوس تشغيل بنفسك» — السكربت يبقى شغالًا.
      if RUN.restUntil and tick() < RUN.restUntil then
        pcall(function() StatusText.Text = "⏸ راحة " .. math.ceil(RUN.restUntil - tick()) .. "ث — وبعدها نكمّل" end)
        task.wait(0.5)
        continue
      end

      -- 0) لو اللعبة كلبتك أو سجنتك: نستنى شوية لحالها، كمّلنا بعدها (ما نفك قيد ولا نهرب).
      --    (46) كانت 120 ثانية = «انكلبت = الفرم يوقف» وهذا اعتراضك؛ صارت مطفية افتراضيًا وسقفها PAUSE_MAX
      if CFG.AUTO_PAUSE then
        local why = heldByGame()
        if why then
          local tw = tick()
          local cap = math.max(1, tonumber(CFG.PAUSE_MAX) or 8)
          while isRunning and heldByGame() and (tick() - tw < cap) do
            pcall(function() StatusText.Text = "⏸ " .. tostring(why) .. " — نستنى" end)
            task.wait(0.5)
          end
          log(("zPAUSE %s — وقّفنا الحركة %ds ثم كمّلنا لحالنا (ما نفك شي)"):format(
            tostring(why), math.floor(tick() - tw)))
          if not isRunning then break end
        end
      end

      -- 0) صندوق نازل موجود قبل ما نشغّل الدورة: نقفله أول (ما ننتظر حدث)
      if DROP_ON and LOCK_ON and not crateBusy then sweepCrates("دورة") end

      -- 1) دروب (لو مفعل) — (43) أولوية فعلية: فيه دروب حي = النافذة مفتوحة والتسليم يستنى،
      --    حتى لو علينا مهمة نشطة (قبل كان COMMIT يبلع الدروب وترجع له الدورة من بعيد)
      MISSION_HOT = false
      local carrying = false
      pcall(function() carrying = missionLive() end)
      local prio = DROP_ON and DP.want("طور-الدروب")
      if prio then
        dropPhase(CFG.DROP_WINDOW, true)
      elseif DROP_ON and carrying and CFG.COMMIT then
        log("zCOMMIT carrying — علينا مهمة نشطة وما فيه دروب حي: نسلّم")
      elseif DROP_ON and tick() < FLIP.lockUntil then
        log(("zFLIP hold — ما فيه دروب حي، مقفل على التسليم %.0fث"):format(FLIP.lockUntil - tick()))
      elseif DROP_ON then
        dropPhase(CFG.DROP_HUNT, false)
      end
      if not isRunning then break end

      if not DELIV_ON then task.wait(1) continue end

      local endPos, endPart, why, actT = nil, nil, nil, -1
      local pBefore = pts()
      local pressOK, pressWhy = true, "ما-استلمنا-هالround"

      -- (أ) فيه مهمة ما سلمناها (اللمس ما صار) — ما نستلم صندوق ثاني فوقها، نرجع لنفس النقطة
      if retryDeliver then
        log("zLEG retry-deliver — المهمة لسه على عاتقنا، بدون استلام جديد")
        endPos, endPart, why, actT = waitActiveEnd(6)
        if not endPos then retryDeliver = false end
      end

      -- (أ2) (46) طفيته وأعدت تشغيله وأنت بنص المهمة: ما نستلم صندوق فوقها — مرة وحدة لكل تشغيل،
      -- نروح ندوّر نقطة التسليم الحية. ما تنعاد إلا بدوس تشغيل جديد (وإلا حصرنا أنفسنا للأبد).
      if not endPos and not retryDeliver and carrying and not RUN.carryChecked then
        RUN.carryChecked = true
        retryDeliver = true
        log("zLEG carry-over — المهمة لسه علينا من قبل الإيقاف: بلا استلام جديد، نبلش بنقطة التسليم")
      end

      -- (ب) ما علينا مهمة: كول داون تحت أول (ما نمشي 300 متر عشان ننتظر 8 ثوانٍ) ثم استلام
      if not endPos and not retryDeliver then
        -- 2) الكول داون: ما نضغط على بارد — نستنى تحت ونصيد دروب
        if tick() < chestCdUntil then
          StatusText.Text = "انتظار الكول داون..."
          local tc = tick()
          while isRunning and DELIV_ON and tick() < chestCdUntil do
            if DROP_ON and not crateBusy then tryDrop() end
            task.wait(0.4)
          end
          if not isRunning then break end
          local waitedCd = tick() - tc
          log(("zCD ready waited=%.1f"):format(waitedCd))
          pcall(function() UI.CdLbl.Text = string.format("الكول داون الأخير: %.1fث (ما ضغطنا على بارد)", waitedCd) end)
        end

        -- 3) مشي لنقطة الصناديق
        StatusText.Text = "مشي لنقطة الصناديق..."
        local okWalk = timedWalk(CFG.START_POS, "chest", true)
        if dropInterrupt then dropInterrupt = false; tryDrop() end
        if not isRunning then break end
        if not okWalk then
          log("zLEG walk-fail — ما نضغط شي على بعد، نعيد المحاولة بعد 3ث")
          task.wait(3)
          continue
        end
        task.wait(0.2)

        -- 4) الاستلام ثم انتظار نقطة التسليم الحية
        StatusText.Text = "استلام الصندوق [E]..."
        pressOK, pressWhy = triggerChestPrompt()
        if pressOK then
          endPos, endPart, why, actT = waitActiveEnd(CFG.CHEST_WAIT)
        else
          -- ما ضغطنا (اللعبة مقفلة البرومبت غالبًا = علينا مهمة): ما نضيع 22ث واقفين
          local live, proof = missionLive()
          if live then
            local wp, wpart, wwhy = wideEnd(proof)
            if wp then endPos, endPart, why = wp, wpart, wwhy end
          end
          if not endPos then
            pressNo = pressNo + 1
            log(("zNO-E press=%s live=%s — ما في برومبت ينفتح ولا نقطة نسلّم لها، ننتظر الكول داون"):format(
              tostring(pressWhy), tostring(live)))
            chestCdUntil = tick() + CFG.CHEST_CD
            task.wait(CFG.LEG_WAIT)
            continue
          end
        end
      end
      if not isRunning then break end
      -- لو شغّل «تخمين الوجهة» من الواجهة: نرجع للطريقة القديمة (Beam/Billboard) بعد المهلة
      if not endPos and CFG.TGT_GUESS then
        local gp, gpart, gwhy = findDeliveryTarget()
        if gp then endPos, endPart, why = gp, gpart, gwhy or "guess" end
      end
      -- نقطة التسليم ما بانت — بس السيرفر يقول علينا مهمة؟ نوسّع داخل الفولدر ونسلّم.
      -- هذا يقطع اللوب: قبل كان «zCD no-mission» → نعيد الاستلام على بارد للأبد.
      if not endPos then
        local live, proof = missionLive()
        if live then
          log(("zLIVE mission=%s end=none press=%s — نوسّع البحث ونسلّم، ما نعيد الاستلام"):format(
            proof, tostring(pressWhy)))
          local wp, wpart, wwhy = wideEnd(proof)
          if wp then
            endPos, endPart, why = wp, wpart, wwhy
            wideOK = wideOK + 1
          end
        end
      end
      if not endPos then
        chestCdUntil = tick() + CFG.CHEST_CD
        log(("zCD no-mission t=%.1f press=%s — ما انفتح صندوق، ننتظر %.0fث بلا هرجلة"):format(
          actT or -1, tostring(pressWhy), CFG.CHEST_CD))
        task.wait(CFG.LEG_WAIT)
        continue
      end
      log(("zTGT %.1f, %.1f, %.1f part=%s why=%s after=%.1f d=%.0f"):format(
        endPos.X, endPos.Y, endPos.Z, asc(endPart and endPart:GetFullName() or "nil"),
        why, actT, (function() local rr = rootOf(); return rr and (rr.Position - endPos).Magnitude or -1 end)()))

      -- هدف بعيد/معلّق بالسما = مو نقطة تسليم (ما نتبعه)
      local rNow = rootOf()
      if rNow and (rNow.Position - endPos).Magnitude > CFG.TGT_MAXD then
        log(("zTGT reject d=%.0f>%d — مو وجهة تسليم، نعيد الاستلام"):format(
          (rNow.Position - endPos).Magnitude, CFG.TGT_MAXD))
        chestCdUntil = tick() + CFG.CHEST_CD
        task.wait(CFG.LEG_WAIT)
        continue
      end

      -- 5) المشي للتسليم — ولو طلع دروب بالطريق: نخلصه ونكمل نفس السكة
      StatusText.Text = "التوجه للتسليم..."
      dropInterrupt = false
      MISSION_HOT = true                       -- إحنا حاملين مهمة: قواعد COMMIT تسري
      local okDeliv = timedWalk(endPos, "deliver", true)
      if dropInterrupt and isRunning then
        dropInterrupt = false
        local gotDrop = tryDrop()
        if not gotDrop then
          noteFlip("interrupt-no-pickup")
          log("zDROP interrupt — وقّفنا المشية والدروب ما انأخذ: نكمّل التسليم، ما نلف وراه")
        elseif DP.on then
          -- (43) أخذناه وفيه دروب ثاني حي: نخلص الدروب قبل التسليم. المهمة على عاتقنا وما تروح،
          -- والرجوع لنفس نقطة التسليم مضمون بشق retryDeliver تحت — ما فيه استلام جديد فوقها.
          log("zPRIO interrupt — الدروب انأخذ ولسه فيه دروب: نكمّله، والتسليم مستني")
          retryDeliver = true
          continue
        end
        okDeliv = timedWalk(endPos, "deliver2", true)
      end
      MISSION_HOT = false
      if not isRunning then break end

      -- 6) لمس النقطة (مثل v1.3) — بس إذا وصلت فعلًا، ونتأكد بالنتيجة مو بالتخمين
      local delivered = false
      local r2 = rootOf()
      if okDeliv and endPart and firetouchinterest and r2 and TOUCH_ON then
        local dd = (r2.Position - endPos).Magnitude
        log(("zTOUCH d=%.1f"):format(dd))
        if dd <= 12 then
          pcall(function() firetouchinterest(r2, endPart, 0) end)
          task.wait(0.1)
          pcall(function() firetouchinterest(r2, endPart, 1) end)
          task.wait(0.9)
          local still = activeEnd()
          local gain = pts() - pBefore
          delivered = (still == nil) or (gain > 0)
          log(("zTOUCH after live=%s +pts=%d"):format(tostring(still ~= nil), gain))
        else
          log("zTOUCH skip — بعيدة، ما نسوّي لمس من بعد")
        end
      elseif not okDeliv then
        log("zDELIV walk-fail — ما نسلم من بعد")
      end
      if delivered then
        delivOK = delivOK + 1
        chestCdUntil = tick() + CFG.CHEST_CD
        retryDeliver, retryN = false, 0
        pcall(function()
          UI.CdLbl.Text = string.format("تسليمات الجلسة: %d  |  الكول داون الأخير: %.1fث", delivOK, CFG.CHEST_CD)
        end)
      else
        retryN = retryN + 1
        retryDeliver = retryN < 3
        if retryN >= 3 then retryN, chestCdUntil = 0, tick() + CFG.CHEST_CD end
      end
      log(("zCYCLE done delivered=%s +pts=%d retry=%s cd=%.0f"):format(
        tostring(delivered), pts() - pBefore, tostring(retryDeliver), CFG.CHEST_CD))
      task.wait(CFG.LEG_WAIT)
    end
    -- طلعنا من الحلقة = إيقاف أو جيل جديد أو نمت الحلقة — كلها تبيّن بالسجل، ما تختفي بصمت
    log(("zCYCLE exit gen=%d alive=%s running=%s"):format(myId, tostring(ALIVE), tostring(isRunning)))
    if RUN.thread == coroutine.running() then RUN.thread = nil end
  end)

  -- حارس الدورة: الجسم ما نلفّه بpcall لأنه يـ yield (task.wait)، والمنفّذات القديمة ترمي
  -- «yield across C-call boundary». فالرقابة خارجية: لو الثريد مات والسكربت المفروض شغال
  -- = خطأ داخلي. قبل كان يموت بصمت وتظل الواجهة تقول «شغال» والفาร์ม واقف.
  task.spawn(function()
    local th = RUN.thread
    while ALIVE and isRunning and RUN.thread == th do
      task.wait(2)
      if coroutine.status(th) == "dead" and RUN.thread == th then
        RUN.thread = nil
        RUN.deaths = RUN.deaths + 1
        if RUN.deaths >= 5 and (tick() - (RUN.lastDeath or 0)) < 300 then
          isRunning = false
          releaseHold(nil, nil)
          log("zCYCLE STOP — 5 انهيارات ورا بعض: وقّفنا. أرسل السجل كامل، فيه سبب الخطأ")
          pcall(function()
            StatusText.Text = "متوقف — انهيارات متكررة"
            StatusText.TextColor3 = COL.WARN
            ToggleBtn.Text = "تشغيل"
            ToggleBtn.BackgroundColor3 = COL.ACCENT
          end)
          break
        end
        RUN.lastDeath = tick()
        log(("zCYCLE crashed (death #%d) — نعيد الدورة بعد 3ث"):format(RUN.deaths))
        task.wait(3)
        if ALIVE and isRunning then cycle() end
        break
      end
    end
  end)
end

local function halt()
  local c = lp.Character
  local h = c and c:FindFirstChildOfClass("Humanoid")
  local r = c and c:FindFirstChild("HumanoidRootPart")
  if h and r then h:MoveTo(r.Position) end
end

-- ═══ «سرعة ثابتة» (طلب locas — v2h) ═══
-- الاستثناء الوحيد في السكربت كله: نكتب Humanoid.WalkSpeed ونثبّته على CFG.SPD_LOCK_WS (32).
-- قبل كان قسم السرعة قراءة فقط + زر الركض حق الماب، والكتابة تنروح للسيرفر = أكشف من إدخال،
-- لكن طلبك صريح («تبقى 32 لين السكربت ينطفي»)، فالقرار لك والطباعة أمان.
-- التثبيت ثلاث طبقات حتى تكون «دائمًا» صحيحة فعلًا:
--   1) GetPropertyChangedSignal("WalkSpeed") — يرجّعها نفس لحظة ما اللعبة تغيّرها
--   2) مراقبة 0.4ث (تحت، مع باقي المراقبين) — تغطّي ما لو الـ signal ما وصل
--   3) إعادة ربط لما ينشئ الماب Humanoid جديد (respawn)
-- ولا نكتب أبدًا وأنت مقيّد (WS=0 / كلبشة / سجن): هذا يفكّ قيد اللعبة = تجاوز حماية، مو سرعة.
local function lockSpeedNow(src)
  local r, hum = rootOf()
  if not hum then return false end
  local want = tonumber(CFG.SPD_LOCK_WS) or 32
  local okC, cur = pcall(function() return hum.WalkSpeed end)
  local have = okC and tonumber(cur) or nil
  if have == nil then return false end
  if math.abs(have - want) <= 0.01 then return true end
  if have <= 0 or heldByGame() then return false end
  -- بعد كل مطاطية نكفّ 2.5ث: إعادة الكتابة فورًا = ندفن الرقم فوق رجعة السيرفر فتتكرر الرجعة
  if SPD.relaxUntil and tick() < SPD.relaxUntil then
    SPD.relaxN = (SPD.relaxN or 0) + 1
    return false
  end
  local okW = pcall(function() hum.WalkSpeed = want end)
  if not okW then
    if tick() - SPD.lockLog > 20 then
      SPD.lockLog = tick()
      log("zSPEEDLOCK fail — منفذك ما سمح بكتابة WalkSpeed")
    end
    return false
  end
  SPD.lockWrites = SPD.lockWrites + 1
  if tick() - SPD.lockLog > 4 then
    SPD.lockLog = tick()
    SPD.lockFix = SPD.lockFix + 1
    log(("zSPEEDLOCK fix#%d %s: WS %s -> %s (نثبت على %s) writes=%d"):format(
      SPD.lockFix, tostring(src or "?"), tostring(math.floor(have + 0.5)),
      tostring(math.floor(want + 0.5)), tostring(math.floor(want + 0.5)), SPD.lockWrites))
  end
  return true
end
local function bindSpeedLock()
  local r, hum = rootOf()
  if not hum or hum == SPD.lockHum then return end
  if SPD.lockConn then pcall(function() SPD.lockConn:Disconnect() end) SPD.lockConn = nil end
  pcall(function()
    SPD.lockConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
      if ALIVE and CFG.SPD_LOCK then lockSpeedNow("signal") end
    end)
  end)
  SPD.lockHum = hum
  log(("zSPEEDLOCK bound %s — نعيد التثبيت لحظيًا كل ما الماب غيّرت WS"):format(
    tostring(SPD.lockConn and "signal+watch" or "watch-only")))
end
local function unlockSpeed()
  if SPD.lockConn then pcall(function() SPD.lockConn:Disconnect() end) SPD.lockConn = nil end
  SPD.lockHum = nil
  local back = SPD.lockBase
  SPD.lockBase = nil
  if not back then return end
  local r, hum = rootOf()
  if hum and back > 0 then
    pcall(function() hum.WalkSpeed = back end)
    log(("zSPEEDLOCK off — رجّعنا WalkSpeed لـ%s (رقمك قبل ما نثبّت) fixes=%d writes=%d"):format(
      tostring(math.floor(back + 0.5)), SPD.lockFix, SPD.lockWrites))
  end
end
local function engageSpeedLock()
  local r, hum = rootOf()
  if not hum then
    if tick() - SPD.lockLog > 15 then
      SPD.lockLog = tick()
      log("zSPEEDLOCK no-humanoid — ما فيه شخصية الحين، نعيد المحاولة كل نص ثانية")
    end
    return false
  end
  local okB, b = pcall(function() return hum.WalkSpeed end)
  SPD.lockBase = (okB and tonumber(b)) or nil
  SPD.lockFix, SPD.lockWrites, SPD.lockLog = 0, 0, 0
  bindSpeedLock()
  lockSpeedNow("engage")
  log(("zSPEEDLOCK on=%s target=%s base=%s — ثابتة لين تطفّي الزر أو السكربت"):format(
    tostring(CFG.SPD_LOCK), tostring(math.floor((tonumber(CFG.SPD_LOCK_WS) or 32) + 0.5)),
    tostring(SPD.lockBase and math.floor(SPD.lockBase + 0.5) or "?")))
  return true
end

-- (55) فكّ التثبيت تلقائيًا لما يكون هو سبب المطاطية: كتابة WalkSpeed فوق رقم الماب
-- (أساسك 24 والثابتة 32) = السيرفر يردّك خطوات كل شوية. بدل ما نعيد القفل كل 2.5ث ونحارب
-- السيرفر لين تعلق السكة، نرجّع رقمك ونكمّل مشي طبيعي. الزر يبقى بيدك — ترجّعه متى ما تبغى.
yieldSpeedLock = function(why)
  if not CFG.SPD_LOCK then return end
  CFG.SPD_LOCK = false
  unlockSpeed()
  SPD.lockDirty = true
  log(("zSPEEDLOCK yield (%s) — الرجعات كانت من كتابة السرعة: طفّينا التثبيت ورجّعنا رقمك، نكمّل بلا محاربة السيرفر"):format(
    tostring(why or "?")))
end

-- ═══ إيقاف كامل (v2h) ═══
-- قبل كان زر X يشيل ScreenGui بس ويترك 10 حلقات مراقبة + اتصالات شغالة تحت:
-- الشخصية تمشي وتضغط E وأنت ما تشوف واجهة، وما تقدر توقفها. الحين يغلق كل شي:
-- الحلقات (ALIVE)، الاتصالات (disconnectAll)، إمساك E، الإضاءة المعدّلة، والواجهة.
-- ما نلفّه بpcall — كل خطوة محفوظة بنفسها، والترتيب مهم: نوقف قبل ما نفصل.
shutdown = function(why)
  if not ALIVE then return end
  ALIVE = false
  isRunning = false
  RUN.id = RUN.id + 1
  releaseHold(nil, nil)
  halt()
  -- «سرعة ثابتة» شغّالة = نرجّع رقمك قبل ما نفصل الاتصالات، ما نطلع ونترك WS مكتوب
  if CFG.SPD_LOCK then CFG.SPD_LOCK = false; unlockSpeed() end
  -- «تيسير»: ما نطلع ونترك JumpHeight/FOV مكتوبين — نرجّع أرقامك ونمسح الرسومات.
  -- ونطفّل الزر نفسه: الإعداد المحفوظ ما يرجّعك على كتابة فيزياء وأنت ما تدري.
  CFG.HJUMP, CFG.INF_JUMP = false, false
  if DP.on then DP.close("إيقاف") end
  if DEF.qolStop then pcall(DEF.qolStop) end
  disconnectAll()
  log(("=== shutdown (%s) — حلقات + اتصالات + واجهة موقوفة ==="):format(tostring(why)))
  _G.RAVEN_STOP = nil
  task.delay(0.2, function() pcall(function() ScreenGui:Destroy() end) end)
end

