-- قراءة حية لخصائص البرومبت: ريفن ممكن تخلق برومبت الصندوق وهو مقفل (Enabled=false)
-- وتفكّه لما يلمس الأرض. لو اكتفينا بالنسخة المخزّنة من لحظة الإضافة ما بنشوف الدروب أبدًا.
local GATED = setmetatable({}, { __mode = "k" })
local function refreshLive(d, info)
  local okE, en = pcall(function() return d.Enabled end)
  if okE and en ~= nil then info.en = en end
  local okH, h = pcall(function() return d.HoldDuration end)
  if okH and tonumber(h) then info.hold = tonumber(h) end
  local okD, dd = pcall(function() return d.MaxActivationDistance end)
  if okD and tonumber(dd) then info.dist = tonumber(dd) end
end

local RANK = { drop = 1, fresh = 2, other = 3 }
local function nearPrompts(maxDist)
  local r = rootOf()
  if not r then return {} end
  local out = {}
  for d, info in pairs(PRMAP) do
    if d.Parent and not charHosted(d) then
      local kind, why = classify(info)
      -- ما نترشّى على أي برومبت: «drop» (كلمة صريحة) أو «fresh» (ظهر بعد الكنس الأول = دروب حي)
      if kind == "drop" or kind == "fresh" then
        refreshLive(d, info)
        if info.en == false then
          -- مرشّح دروب موجود بس مقفول: نسجّلها مرة وحدة عشان نعرف السبب (مو هلوسة)
          if not GATED[d] then
            GATED[d] = tick()
            log(("zPR gated txt=%s hold=%s mad=%s — موجود ومقفل، نستنى يفك"):format(
              info.txt, tostring(info.hold), tostring(info.dist)))
          end
        else
          local hp = prHostPos(d)
          if hp then
            local dd = (hp - r.Position).Magnitude
            -- المدى الحقيقي = MaxActivationDistance حق البرومبت نفسه (مقروء عندك)
            local cap = math.max(maxDist, (info.dist or 0) + 2)
            if dd <= cap then
              out[#out + 1] = { p = d, info = info, dist = dd, kind = kind, why = why or "", host = hp }
            end
          end
        end
      end
    end
  end
  table.sort(out, function(a, b)
    local ra, rb = RANK[a.kind] or 9, RANK[b.kind] or 9
    if ra ~= rb then return ra < rb end
    return a.dist < b.dist
  end)
  return out
end

-- ═══════════ مدة الإمساك ═══════════
-- البرومبت اللي عنده HoldDuration حقيقي (الدروب = 5) نصدّقه، ما نfloor على 7 ثانية
-- لأن الصندوق من الهبوط للسرقة ما يعمر أكثر من ~15 ثانية
local function holdSecs(info)
  local h = tonumber(info and info.hold) or 0
  if h > 0.2 then
    local s = h + CFG.HOLD_PAD
    if s < CFG.HOLD_MIN then s = CFG.HOLD_MIN end
    if s > CFG.HOLD_MAXT then s = CFG.HOLD_MAXT end
    return s
  end
  return CFG.HOLD_SECS
end

-- ═══════════ إمساك E الحقيقي (مش ضغطة) ═══════════
local function releaseHold(d, key)
  holding = false
  pcall(function() if d then d:InputHoldEnd() end end)
  pcall(function() VirtualInputManager:SendKeyEvent(false, key or Enum.KeyCode.E, false, game) end)
end
local function finishHold(d, key, why, t0, keyName)
  releaseHold(d, key)
  log(("zHOLD %s t=%.1f key=%s"):format(tostring(why), tick() - (t0 or tick()), asc(keyName or "?")))
  return why
end
-- يرجع: "ok" | "out" (طلعنا من المدى) | "stop" (اقفل) | "gone"
-- v2f — هذا سبب «يوقف نص العدّة»: اللعبة تعيد خلق البرومبت (سجلك: البرومبت ينخلّق عند الهبوط)
-- والقديم كان يطلع بـ"gone" من أول 0.15ث، ولو طاحت المسافة (مطاطية 14-24 متر) يطلع بـ"out" بعد 1.2ث.
-- الحين: ننتقل للبرومبت الجديد ونكمل على نفس العدّة، ولو طاحت المسافة نخطو للهدف ونعيد الإمساك.
local function beginHold(d, key)
  pcall(function() d:InputHoldBegin() end)
  local ok = pcall(function() VirtualInputManager:SendKeyEvent(true, key, false, game) end)
  if not ok then
    ok = pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
  end
  return ok
end
local function swapPrompt(host, info, old)
  for d2, i2 in pairs(PRMAP) do
    if d2 ~= old and i2 and d2.Parent then
      local sameHost = false
      pcall(function() sameHost = (host ~= nil) and (d2.Parent == host) end)
      if sameHost or (i2.txt == info.txt and i2.hold == info.hold) then return d2, i2 end
    end
  end
  return nil
end
local function holdPrompt(entry, secs)
  local d, info = entry.p, entry.info
  local key = info.key
  local keyName = tostring(key)
  local host = nil
  pcall(function() host = d.Parent end)
  -- (48) إمساكان بنفس الوقت: الثاني كان يبلع الأول — finishHold يمسّي holding العام
  -- فتنطفي حلقة الثاني والمفتاح لسه مضغوط (هذي «العدّة توصل نصها» اللي شكيت منها).
  -- الحين نحبس الثاني حتى يخلص الأول، بسقف 20 ثانية حتى ما نقفل على نفسنا.
  if holding then
    local tw = tick()
    while holding and isRunning and (tick() - tw < 20) do task.wait(0.1) end
    -- طفا السكربت وهو مستنى دوره: ما نضغط E بعد الإيقاف (الزر «إيقاف» يعني إيقاف)
    if not isRunning then return "stop" end
  end
  holding = true
  beginHold(d, key)
  local t0, nextPing, outRun, swaps = tick(), 0, 0, 0
  local lastKeep, keepN = t0, 0   -- (47) «متأكد إنك ضاغط؟»: نبض إعادة إنزال المفتاح
  local deadline = t0 + secs
  -- سقف للمشيّة الراجعة: بلا سقف، مطاطية خانقة تخليك تمسك وتطلق للأبد
  local hardStop = t0 + math.max(secs * 2.5, secs + 8)
  local paused, bestDd, lastCloseAt = false, nil, tick()
  while holding and isRunning and (tick() < deadline) do
    if not d.Parent then
      local nd, ni = swapPrompt(host, info, d)
      if not nd then return finishHold(d, key, "gone", t0, keyName) end
      swaps = swaps + 1
      d, info = nd, ni
      key = info.key or key
      paused = false
      beginHold(d, key)
      log(("zHOLD swap#%d t=%.1f/%.1f — اللعبة غيّرت البرومبت، كمّلنا نفس العدّة"):format(
        swaps, tick() - t0, secs))
    end
    local r, hum = rootOf()
    local hp = prHostPos(d)
    if not hp then pcall(function() hp = host and host.Position end) end
    if r and hp then
      local dd = (hp - r.Position).Magnitude
      local lim = tonumber(info.dist) or 10
      if dd > lim + 3 then
        -- خارج المدى: نحرّر الإدخال مرة وحدة (مو نعيد InputHoldBegin كل 0.6ث — التكرار يصفّر
        -- عدّة اللعبة من الصفر، وهذا سبب «يوصل نص العدّة»)، ونمشي له ونمدّد المهلة على قد الطريق
        outRun = outRun + 1
        if not paused then
          paused = true
          pcall(function() d:InputHoldEnd() end)
          pcall(function() VirtualInputManager:SendKeyEvent(false, key or Enum.KeyCode.E, false, game) end)
          log(("zHOLD OUT d=%.1f max=%s key=%s — حرّرنا الإمساك، نمشي له ونمسك مرة وحدة لما نوصل"):format(
            dd, tostring(info.dist), asc(keyName)))
        end
        if outRun % 3 == 1 then
          -- (47) ما نمشي لمركز الصندوق (نقطة داخل حاجز = وقفة بلا حركة): نوقف على مدى الإمساك
          -- (48) hum ممكن يكون nil (الشخصية انبدلت/ميتة): pcall كان يبلع الخطأ فنقف بلا حركة
          if hum then pcall(function() hum:MoveTo(DEF.approach(r.Position, hp, lim)) end) end
        end
        if tick() < hardStop then deadline = deadline + 0.15 end
        if not bestDd or dd < bestDd - 1 then bestDd, lastCloseAt = dd, tick() end
        if tick() - lastCloseAt > 4 or tick() >= hardStop then
          return finishHold(d, key, "out", t0, keyName)
        end
      else
        outRun = 0
        -- رجعنا للمدى: نعيد الإمساك مرة وحدة بس، هنا تنكمّل العدّة من أول ثانية داخل المدى
        if paused and dd <= lim then
          paused = false
          beginHold(d, key)
          log(("zHOLD BACK d=%.1f t=%.1f/%.1f — مسكنا من جديد والعدّة شغّالة"):format(dd, tick() - t0, secs))
        end
        -- (47) نبض إبقاء: نعيد إنزال المفتاح كل 3ث (إدخال لوحة، مو InputHoldBegin — هذا ما يصفّر
        -- عدّة اللعبة، بعكس إعادة InputHoldBegin اللي كانت «توصل نص العدّة»). يغطّي الحالة
        -- اللي تبتلع فيها اللعبة/السيرفر الإدخال فنقف ننتظر عدّة ما تشتغل.
        if tick() - lastKeep >= 3 then
          lastKeep = tick()
          keepN = keepN + 1
          pcall(function() VirtualInputManager:SendKeyEvent(true, key or Enum.KeyCode.E, false, game) end)
          log(("zHOLD keep#%d t=%.1f/%.1f d=%.1f — أعدنا إنزال المفتاح والعدّة ما تنصفّ"):format(
            keepN, tick() - t0, secs, dd))
        end
      end
      if VERBOSE and tick() - nextPing >= 2 then
        nextPing = tick()
        log(("zHOLD t=%.1f/%.1f d=%.1f hold=%s"):format(tick() - t0, secs, dd, tostring(info.hold)))
      end
    end
    task.wait(0.15)
  end
  -- «ok» لازم تعني إنّا خلّصنا العدّة ونحن داخل المدى — لا ترجع ok والمهلة طاحت ونحن طالع من المدى
  local why = (paused and "out") or (holding and (isRunning and "ok" or "stop") or "stop")
  return finishHold(d, key, why, t0, keyName)
end

-- ═══════════ أدوات مشتركة: قفزة، رِماك العوائق، انتقال متأكد ═══════════
-- قفزة وحدة: نرجّع Jump=false بعد ربع ثانية (لو بقيت true ينط طول السكة)
local function jumpNow(hum)
  if not hum then return end
  pcall(function() hum.Jump = true end)
  task.delay(0.42, function()
    local _, h2 = rootOf()
    if h2 then pcall(function() h2.Jump = false end) end
  end)
end

local AJ = { last = 0, hops = 0, scan = 0, logAt = 0 }
local RCACHE, RJail = nil, 0
local function filterEnum()
  local ok, v = pcall(function() return Enum.RaycastFilterType.Exclude end)
  if ok and v then return v end
  local ok2, v2 = pcall(function() return Enum.RaycastFilterType.Blacklist end)
  if ok2 and v2 then return v2 end
  return nil
end
local function rayParams()
  if RCACHE then return RCACHE end
  if tick() < RJail then return nil end
  local ft = filterEnum()
  local ok, q = pcall(function()
    local p = Instance.new("RaycastParams")
    p.FilterType = ft
    p.IgnoreWater = true
    p.FilterDescendantsInstances = { lp.Character }
    return p
  end)
  if not ok or not q or not ft then
    RJail = tick() + 600
    log("zJUMP no-Raycast-API عندك — القفز الاستباقي مطفي هالجلسة (الباقي يشتغل)")
    return nil
  end
  RCACHE = q
  return q
end

-- رِماك بمستوى الركبة + رِماك فوق الرأس: حاجر وطي (صندوق/سور) = نطي، جدار طويل = القفز ما يفيد.
-- هذا نفس ما يسويه لاعب دوس مسافة — ما نلمس CFrame ولا سرعة.
local function obstacleHop(r, hum, toward)
  if not CFG.AUTO_JUMP or not r or not hum or not toward then return false end
  if tick() - AJ.scan < 0.25 then return false end
  AJ.scan = tick()
  local q = rayParams(); if not q then return false end
  local dir = (toward - r.Position); dir = Vector3.new(dir.X, 0, dir.Z)
  if dir.Magnitude < 1.5 then return false end
  dir = dir.Unit
  pcall(function() q.FilterDescendantsInstances = { lp.Character } end)
  local okL, low = pcall(function()
    return Workspace:Raycast(r.Position + Vector3.new(0, -1.8, 0) + dir * 1.0, dir * CFG.JUMP_LOOK, q)
  end)
  if not okL or not low then return false end
  local okH, high = pcall(function()
    return Workspace:Raycast(r.Position + Vector3.new(0, 2.6, 0) + dir * 1.0, dir * CFG.JUMP_LOOK, q)
  end)
  if not okH or high then return false end   -- حائط أو سقف فوقه: ما نخبط راسنا فيه
  if tick() - AJ.last < CFG.JUMP_CD then return false end
  AJ.last, AJ.hops = tick(), AJ.hops + 1
  jumpNow(hum)
  if tick() - AJ.logAt > 6 then
    AJ.logAt = tick()
    log(("zHOP ahead=%.0f part=%s hops=%d — حاجز واطي قدامنا، طيناه"):format(
      CFG.JUMP_LOOK, asc((low.Instance and low.Instance.Name) or "?"), AJ.hops))
  end
  return true
end

-- ═══════════ v2g: قطع الزوايا + طلعة الرادّة + مواصلات الماب (قسم السرعة والقفز) ═══════════
-- القاعدة: MoveTo + قفز بإدخال (Humanoid.Jump) + رِماك للقراءة. ما نكتب WalkSpeed ولا
-- JumpPower ولا Gravity ولا CFrame — الكتابة هذي مخاطرة كشف، وما تصير إلا بالزر الأحمر اللي
-- تشغّله أنت: (28) سرعة ثابتة، (34) انتقال لصديق، (37) نطة عالية. الحركة نفسها إدخال.
-- اللي يسوّي القسم: يقطع الزاوية اللي يقدر يمرّ منها، يطلع الرادّة اللي قدامه بقفزة،
-- ويستخدم وسائل النقل اللي الماب نفسه حاطّها للاعبين (بزر تضغطه أنت، مو أوتوماتيك).
local LOS = { cuts = 0, saved = 0, bad = 0, jail = 0, last = 0, next = 0 }
local SU  = { hops = 0, last = 0, logAt = 0 }
local JMP = { n = 0, since = 0, meters = 0, hops0 = 0, cuts0 = 0, saved0 = 0 }
local PADST = { seen = 0, uses = 0, refused = 0 }
local LC  = { wps = nil, acc = nil }

-- أطوال السكة المتبقية من كل نقطة (نخزّنها، ونعيد الحساب فقط لو المسار تغيّر)
local function pathLens(wps, destination)
  if LC.wps == wps and LC.acc then return LC.acc end
  local acc = {}
  if #wps == 0 then LC.wps, LC.acc = wps, acc; return acc end
  acc[#wps] = (wps[#wps].Position - destination).Magnitude
  for i = #wps - 1, 1, -1 do
    acc[i] = acc[i + 1] + (wps[i].Position - wps[i + 1].Position).Magnitude
  end
  LC.wps, LC.acc = wps, acc
  return acc
end

-- خط نظر نظيف على مستويين–ثلاثة (ركبة/صدر/راس) وبنفس الدور تقريبًا
-- الرِماكات تطلع من مستوى الأرض (مو من مركز HRP): لو طلعنا من فوق مركزنا بنطير فوق
-- الحواجز الواطية (رادّة 1.2م) ونقطع لها ثم نعلق فيها — الحارس zLOS bad يمسكها، بس أفضل نراها.
local LOS_H = { 0.6, 1.7, 2.9 }
local function losClear(from, to)
  local q = rayParams()
  if not q then return false end
  local d = (to - from).Magnitude
  if d < CFG.WP_DONE then return false end
  if math.abs(to.Y - from.Y) > 3.5 then return false end  -- مو نفس الدور: ما نقطع فوق حفرة
  local dir = (to - from) / d
  pcall(function() q.FilterDescendantsInstances = { lp.Character } end)
  local base = from
  local okG, ground = pcall(function()
    return Workspace:Raycast(from, Vector3.new(0, -6, 0), q)
  end)
  if okG and ground then base = Vector3.new(from.X, ground.Position.Y, from.Z) end
  local rise = to.Y - base.Y
  if rise > 1.5 then return false end   -- النهاية أعلى من قدرتنا على الطلعة: ما نقطع لها
  -- LOS_RAYS=1 يفحص الركبة فقط (يقطع أكثر، يطيح فوق حواجز واطية) — 3 = أحوط
  local rays = math.max(1, math.min(#LOS_H, tonumber(CFG.LOS_RAYS) or 3))
  for i = 1, rays do
    local hy = LOS_H[i]
    local ok, hit = pcall(function()
      return Workspace:Raycast(base + Vector3.new(0, hy, 0), dir * (d - 1.5), q)
    end)
    if not ok then return false end
    if hit then return false end
  end
  return true
end

-- نقطع لأبعد نقطة واضحة توفّر LOS_MINSAVE متر فعليًا من السكة (مو من نقطة وحدة)
-- حرس أداء: التقطيع يفحص بأشعة، فنمنعه يشتغل أكثر من مرة كل 1.2ث، ونحدّه بـ 8 تجارب
-- رِماكة لكل فحص. بدون هذا، مسار فيه 40 نقطة = 120 رِماكة كل عيّنة = لعبة تهنّق.
local LOS_SCAN_MAX = 8
local function pruneIdx(wps, idx, destination)
  if not CFG.LOS_PRUNE or tick() < LOS.jail or tick() < LOS.next then return idx end
  if #wps < 2 or idx > #wps then return idx end
  local r = rootOf()
  if not r then return idx end
  LOS.next = tick() + 1.2
  local p = r.Position
  local acc = pathLens(wps, destination)
  local now = (p - wps[idx].Position).Magnitude + (acc[idx] or 0)
  -- نقطع لأبعد نقطة تحقق شرط التوفير — نقطع لنقطة من المسار نفسه (مو للوجهة على طول)،
  -- عشان المشي يكمّل طبيعي بعدها وما نطيح بحالة «قطعنا ونسين نMoveTo»
  -- (ب) أبعد نقطة نص السكة واضحة
  local tries = 0
  for k = #wps, idx + 1, -1 do
    local cand = (p - wps[k].Position).Magnitude + (acc[k] or 0)
    if now - cand >= CFG.LOS_MINSAVE and losClear(p, wps[k].Position) then
      LOS.cuts, LOS.saved = LOS.cuts + 1, LOS.saved + (now - cand)
      LOS.last = tick()   -- نوثّق وقت آخر قطعة: لو علّقنا بعدها بـ6ث نوقف القطع (حارس)
      if LOS.cuts == 1 or LOS.cuts % 5 == 0 then
        log(("zLOS #%d cut=%.0fm (left %.0f -> %.0f) idx=%d/%d"):format(
          LOS.cuts, now - cand, now, cand, k, #wps))
      end
      return k
    end
    tries = tries + 1
    if tries >= LOS_SCAN_MAX then break end
  end
  return idx
end

-- رادّة قدامنا أعلى 1.2–STEP_MAX متر وفيها مجال فوقها؟ نطي = نفس ما يسوي لاعب دوس مسافة
local function stepUpHop(r, hum, toward)
  if not CFG.STEP_UP or not r or not hum or not toward then return false end
  if tick() - SU.last < CFG.JUMP_CD then return false end
  local q = rayParams()
  if not q then return false end
  SU.last = tick()
  pcall(function() q.FilterDescendantsInstances = { lp.Character } end)
  local dir = (toward - r.Position)
  dir = Vector3.new(dir.X, 0, dir.Z)
  if dir.Magnitude < 2 then return false end
  dir = dir.Unit
  local near, far
  pcall(function() near = Workspace:Raycast(r.Position + Vector3.new(0, 3.0, 0) + dir * 1.6, Vector3.new(0, -9, 0), q) end)
  pcall(function() far  = Workspace:Raycast(r.Position + Vector3.new(0, 3.0, 0) + dir * 4.6, Vector3.new(0, -9, 0), q) end)
  if not near or not far then return false end
  local rise = far.Position.Y - near.Position.Y
  if rise < 1.2 or rise > CFG.STEP_MAX then return false end
  local ceil
  pcall(function() ceil = Workspace:Raycast(far.Position + Vector3.new(0, 1.2, 0), Vector3.new(0, 3.4, 0), q) end)
  if ceil then return false end  -- فيه سقف فوق الرادّة: ما نخبط راسنا
  SU.hops, AJ.hops = SU.hops + 1, AJ.hops + 1
  jumpNow(hum)
  if tick() - SU.logAt > 6 then
    SU.logAt = tick()
    log(("zSTEP up=%.1f part=%s hops=%d — رادّة قدامنا، طلعناها بقفزة"):format(
      rise, asc((far.Instance and far.Instance.Name) or "?"), SU.hops))
  end
  return true
end

-- وسائل النقل حق الماب نفسه: نسمّيها، ونستخدمها بضغطة منك. ما ننتقل لماب/سيرفر ثاني أبدًا.
local PAD_WORDS = { "مصعد", "مصف", "تاكسي", "سيارة", "باص", "مركبة", "طائرة", "قارب", "درج",
                    "lift", "elevator", "taxi", "car", "bus", "boat", "train", "tram", "gondola", "zipline" }
local PAD_NO    = { "ماب", "سيرفر", "otherplace", "place", "server", "teleport", "انتقال" }
local function padList(maxD)
  local out = {}
  local rr = rootOf()
  if not rr or not CFG.PAD_SEE then return out end
  for d, info in pairs(PRMAP) do
    if info and d.Parent then
      local low = (tostring(info.raw) .. " " .. tostring(info.path)):lower()
      local yes = anyIn(low, PAD_WORDS)
      if yes and not anyIn(low, PAD_NO) then
        local hp = prHostPos(d)
        if hp then
          local dd = (hp - rr.Position).Magnitude
          if dd <= (maxD or CFG.PAD_R) then
            out[#out + 1] = { p = d, info = info, dist = dd, key = yes, pos = hp }
          end
        end
      end
    end
  end
  table.sort(out, function(a, b) return a.dist < b.dist end)
  PADST.seen = #out
  return out
end

-- (50) نقاط نقل الماب اللي أكّدها الفحص: Workspace.OtherPlaceTps («ماب الشات» / «ماب ال afk»).
-- هذي للرسم والرادار فقط. ما نضغطها ولا نمرّرها لـ useNearestPad: الانتقال لماب ثاني يقطع
-- الرحلة من جذورها (المهمة تسقط) — فالمكان تعرفه، والزر ما لمسته يدنا.
local TP_WORDS = { "انتقال", "otherplacetps" }
local function tpList(maxD)
  local out = {}
  local rr = rootOf()
  if not rr or not CFG.TP_SEE then return out end
  local lim = tonumber(maxD) or 400
  for d, info in pairs(PRMAP) do
    if info and d.Parent then
      -- بوابة classify: ما نرسم دروب/جديد هنا (ولاعب أبدًا) — و«انتقال» كلمة البرومبت نفسه
      local k = classify(info)
      local low = (tostring(info.raw) .. " " .. tostring(info.path)):lower()
      if k ~= "drop" and k ~= "fresh" and anyIn(low, TP_WORDS) then
        local hp = prHostPos(d)
        if hp then
          local dd = (hp - rr.Position).Magnitude
          if dd <= lim then
            out[#out + 1] = { p = d, info = info, dist = dd, pos = hp }
          end
        end
      end
    end
  end
  table.sort(out, function(a, b) return a.dist < b.dist end)
  return out
end
-- استخدام وسيلة النقل اللي واقف عليها: تشترط إنك داخل مدى البرومبت نفسه (قاعدة اللعبة)
-- ولو طاحت المسافة أو ما كان البرومبت مفعّل — نقول ونسكت، ما نضغط من بعد.
local function useNearestPad()
  local list = padList(CFG.PAD_R)
  if #list == 0 then
    log("zPAD none — ما فيه وسيلة نقل بالماب قربك (مدى " .. tostring(CFG.PAD_R) .. "م)")
    return false
  end
  local e, info = list[1], list[1].info
  local txt = tostring(info.txt or "?")
  local reach = math.min(info.dist or 10, 14)
  if e.dist > reach then
    PADST.refused = PADST.refused + 1
    log(("zPAD far d=%.1f>%.1f — نتمشى لها أول، ما نضغط نقل من بعد: [%s]"):format(
      e.dist, reach, txt))
    return false
  end
  if info.en == false then
    PADST.refused = PADST.refused + 1
    log("zPAD locked — البرومبت مقفل (Enabled=false)، ما نفك شي: [" .. txt .. "]")
    return false
  end
  PADST.uses = PADST.uses + 1
  log(("zPAD use d=%.1f [%s] hold=%s"):format(e.dist, txt, tostring(info.hold)))
  if (info.hold or 0) > 0.3 then
    holdPrompt(e, math.max(0.6, (info.hold or 0) + CFG.HOLD_PAD))
  else
    pcall(function()
      if fireproximityprompt then fireproximityprompt(e.p) end
    end)
  end
  return true
end

-- ═══════════ انتقال يتأكد بنفسه. «الانتقال الفوري ما يشتغل» كان له سببين، كل واحد أصلحناه:
--   1) الدروب لسه نازل من السماء: ننتقل له وهو على 300 متر = نطيح وتموت، فالانتقال يبان فاشل.
--   2) ما فيه تحقق بعد الكتابة: السيرفر يرجّعك للمكان الثاني والسكربت ما يدري.
local TP = { n = 0, kept = 0, band = 0, air = 0, logAt = 0, btnDirty = false }
local function tpTo(pos, why)
  local r = rootOf()
  if not r or not pos then return false end
  local before = (pos - r.Position).Magnitude
  if pos.Y - r.Position.Y > CFG.TP_Y_MAX then
    TP.air = TP.air + 1
    if tick() - TP.logAt > 4 then
      TP.logAt = tick()
      log(("zTP air why=%s y=%.0f->%.0f d=%.0f — لسه نازل من السماء، ننتظره يلمس الأرض"):format(
        asc(tostring(why)), r.Position.Y, pos.Y, before))
    end
    return false
  end
  local target = pos + Vector3.new(0, CFG.TP_ABOVE, 0)
  pcall(function()
    r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    r.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
  end)
  local ok = pcall(function() r.CFrame = CFrame.new(target) end)
  TP.n = TP.n + 1
  task.wait(CFG.TP_VERIFY)
  local r2 = rootOf()
  local after = (r2 and (pos - r2.Position).Magnitude) or 999
  local kept = ok and (after <= math.max(8, before * 0.4))
  if kept then
    TP.kept = TP.kept + 1
    TP.band = 0
  else
    TP.band = TP.band + 1
    -- قاطع الانهيار: كل رجعة من السيرفر بعد كتابة CFrame تعني إن الماب ما يقبل النقل هنا.
    -- الإصرار = «يرجعك خطوات ورا» كل دروب، فنطفي انتقال الدروب من نفسنا ونمشي على الأقدام.
    -- نعدّ الرجعات المتتابعة بس (TP.band ينصفّ مع كل نجاح) — عثرة وحدة قديمة ما تطفّي الميزة.
    if TP.band >= CFG.TP_MAXBAND and CFG.DROP_TP then
      CFG.DROP_TP = false
      TP.btnDirty = true
      log(("zTP breaker — %d رجعة: أطفينا «انتقال فوق الدروب» وصار المشي هو الطريقة (تقدر تشعله من طاب «دروب»)")
        :format(TP.band))
    end
  end
  log(("zTP %s ok=%s d=%.0f->%.0f kept=%s n=%d (نجح %d/رجّعك %d) — %s"):format(
    asc(tostring(why)), tostring(ok), before, after, tostring(kept), TP.n, TP.kept, TP.band,
    kept and "السيرفر خلّاك" or "ما خلّاك: نكمل مشي، ما نكرر"))
  return kept
end

-- ═══════════ المشي: pathfinding + فك تعليق (والانتقال فقط لو فلّجته بنفسك) ═══════════
local function newPath()
  local ok, path = pcall(function()
    return PathfindingService:CreatePath({
      AgentRadius = 2.5, AgentHeight = 5.0, AgentCanJump = true, AgentCanClimb = CFG.CLIMB,
      WaypointSpacing = CFG.WSPACING,
    })
  end)
  if ok then return path end
  return nil
end

-- انتقال وقت الضرورة: كتابة CFrame واحدة، بس لو الفلّاجة شغّالة وعندك سبب حقيقي
-- (tpCount معرّف فوق عند حالة الجلسة، عشان نسخة الإعدادات تقدر تقرأه)
-- (46) «هرب بالانتقال» (ESC_TP) = نفس الباب بس بسبب ضرر (اشتباك/سقوط) بدل التعليق
local function autoTp(destination, reason)
  if not (CFG.AUTO_TP or CFG.ESC_TP) then return false end
  if tpCount >= CFG.AUTOTP_MAX then
    log(("zTP cap — ما نزيد، مطاطيات=%d"):format(rubberHits))
    return false
  end
  local r = rootOf()
  if not r then return false end
  tpCount = tpCount + 1
  return tpTo(destination, reason or "auto")
end

-- متتبّع غير محجوز: يحسب مسار حقيقي كل شوية ويمشي نقطة-نقطة (للصندوق النازل من السماء)
local function makeTracker(spacing)
  local st = { wps = {}, idx = 1, nextCalc = 0, lastP = nil, lastT = 0, stuck = 0 }
  -- قفزة ما تنكفل: نرجع Jump=false بعد ربع ثانية (وإلا يظل ينط طول السكة)
  local function hop(hum)
    if JUMP_ON then jumpNow(hum) end
  end
  return function(destination)
    local r, hum = rootOf()
    if not r or not hum then return false end
    if tick() >= st.nextCalc then
      local np = newPath()
      local ok = np and pcall(function() np:ComputeAsync(r.Position, destination) end)
      if ok and np and np.Status == Enum.PathStatus.Success then
        st.wps = np:GetWaypoints(); st.idx = 1
      else
        st.wps = {}
      end
      st.nextCalc = tick() + (spacing or 1.2)
    end
    if #st.wps > 0 then
      while st.idx <= #st.wps and (r.Position - st.wps[st.idx].Position).Magnitude <= CFG.WP_DONE do
        st.idx = st.idx + 1
      end
      local wp = st.wps[st.idx]
      if wp then
        if wp.Action == Enum.PathWaypointAction.Jump then hop(hum) end
        hum:MoveTo(wp.Position)
        obstacleHop(r, hum, wp.Position)
      else
        hum:MoveTo(destination)
        obstacleHop(r, hum, destination)
      end
    else
      hum:MoveTo(destination)
      obstacleHop(r, hum, destination)
    end
    if not st.lastP then
      st.lastP, st.lastT = r.Position, tick()
    elseif tick() - st.lastT > 1.4 then
      if (r.Position - st.lastP).Magnitude < 1.2 then
        st.stuck = st.stuck + 1
        local dir = (destination - r.Position); dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude > 0.5 then
          hop(hum)
          hum:MoveTo(r.Position + dir.Unit * 8)
          log(("zFOLLOW stuck#%d — تجاوز عائق"):format(st.stuck))
        end
        if st.stuck >= CFG.STUCK_TP then autoTp(destination, "follow-stuck"); st.stuck = 0 end
      else
        st.stuck = 0
      end
      st.lastP, st.lastT = r.Position, tick()
    end
    return true
  end
end

-- ═══════════ زر «مشي/ركض» حق اللعبة نفسها ═══════════
-- طلبك: كل ما تشوف WS نزل لـ16 ادوس الزر. هذا زر يطلعه الماب لكل لاعب والسيرفر يثق فيه —
-- ما نكتب Humanoid.WalkSpeed ولا نغيّر شي replicated من طرفنا. لو ما لقينا الزر: نقول ونسكت.
local runBtn, runFails, runBackoff, runPresses, runAt = nil, 0, 0, 0, 0
local RUN_WORDS = { "ركض", "ركض/مشي", "مشي/ركض", "اجري", "امشي", "مشي", "run", "walk", "sprint" }
-- v2g RUN_HOLD: أول زر يثبّت إنه يرفع WS فعليًا نثبّته (ما نعيد كنس PlayerGui كل مرة)،
-- وأي زر يبيّن إنه كذاب (يفيد مرتين بلا نتيجة) ينحجز بقائمة سوداء ضعيفة forever.
-- ضعيفة (__mode="k") عشان الزر لو انشال من الشجرة ما يخلّف ذاكرة.
local RUNHOLD = { good = nil, dead = setmetatable({}, { __mode = "k" }),
                  cnt = setmetatable({}, { __mode = "k" }), deadN = 0 }
local function runVisible(g)
  local okV, vis = pcall(function() return g.Visible end)
  return not (okV and vis == false)
end
local function findRunButton()
  if CFG.RUN_HOLD and RUNHOLD.good and RUNHOLD.good.Parent and runVisible(RUNHOLD.good) then
    return RUNHOLD.good
  end
  local pg = lp:FindFirstChild("PlayerGui")
  if not pg then return nil end
  for _, g in ipairs(pg:GetDescendants()) do
    if g:IsA("GuiButton") then
      local okT, t = pcall(function() return tostring(g.Text) end)
      local hay = (okT and (t .. " " .. tostring(g.Name))) or tostring(g.Name)
      for _, k in ipairs(RUN_WORDS) do
        if hay:find(k, 1, true) then
          if runVisible(g) and not RUNHOLD.dead[g] then return g end
        end
      end
    end
  end
  return nil
end
local function wsNow()
  local _, h = rootOf()
  local ok, v = pcall(function() return h and h.WalkSpeed end)
  return (ok and tonumber(v)) or nil
end
local function pressRunButton(why)
  if not CFG.RUN_BTN or tick() < runBackoff then return false end
  if runBtn and not runBtn.Parent then runBtn = nil end
  if not runBtn then runBtn = findRunButton() end
  if not runBtn then
    runBackoff = tick() + 120
    log("zRUN no-button — ما لقينا زر مشي/ركض في PlayerGui — ما نكتب سرعة، نكتفي بالقياس")
    return false
  end
  local before = wsNow() or SPD.ws
  if not (tonumber(before) and before > 0) then before = nil end
  pcall(function() runBtn:Activate() end)
  task.wait(0.7)
  local after = wsNow()
  if not (after and before and after > before + 1) then
    -- Activate ما كفى (بعض الواجهات تقرأ إدخال حقيقي): ضغطة ماوس على مكان الزر نفسه
    local okP, cx, cy = pcall(function()
      local a, s = runBtn.AbsolutePosition, runBtn.AbsoluteSize
      return a.X + s.X / 2, a.Y + s.Y / 2
    end)
    if okP and cx then
      pcall(function()
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
      end)
      task.wait(0.7)
      after = wsNow()
    end
  end
  runAt = tick()
  if after and before and after > before + 1 then
    runPresses, runFails = runPresses + 1, 0
    if CFG.RUN_HOLD then RUNHOLD.good = runBtn end
    log(("zRUN %s ok ws=%d->%d btn=%s presses=%d%s"):format(
      tostring(why), math.floor(before), math.floor(after), asc(runBtn.Name), runPresses,
      CFG.RUN_HOLD and " held" or ""))
    return true
  end
  -- (48) ما قرأنا سرعة قبل الضغط (الشخصية تنبدل / السيرفر ما رد هاللحظة):
  -- لا نحسبها فشلة ولا نحجز الزر — الحجز على قراية بايطة كان يطفّل زر الركض الصح
  -- ويبطل «زيادة السرعة» من أول دورتين.
  if not before then
    log(("zRUN unmeasured %s — ما فيه قراية قبل الضغط: نعيد القياس لاحقًا بدون حجز"):format(tostring(why)))
    return false
  end
  runFails = runFails + 1
  local deadName, deadText = "?", ""
  pcall(function()
    if runBtn then deadName, deadText = tostring(runBtn.Name), tostring(runBtn.Text or "") end
  end)
  if CFG.RUN_HOLD and runBtn then
    local n = (RUNHOLD.cnt[runBtn] or 0) + 1
    RUNHOLD.cnt[runBtn] = n
    if n >= 2 and not RUNHOLD.dead[runBtn] then
      RUNHOLD.dead[runBtn], RUNHOLD.deadN = true, RUNHOLD.deadN + 1
      runBtn = nil   -- نبحث عن زر ثاني بدل ما نظل ندوس على الكذاب
      log(("zRUN dead#%d btn=%s text=%s — هالزر ما يرفع السرعة مرتين، حجزناه وما نرجع له"):format(
        RUNHOLD.deadN, asc(deadName), asc(deadText)))
    end
  end
  if runFails >= 3 then runBackoff, runBtn, runFails = tick() + 180, nil, 0 end
  log(("zRUN %s no-effect ws=%s->%s btn=%s fails=%d dead=%d"):format(
    tostring(why), tostring(before), tostring(after), asc(deadName), runFails, RUNHOLD.deadN))
  return false
end

-- يرجع true = وصل، false = وقف/اُقفل
-- allowDropHunt = نصيد الدروب أثناء المشي الطويل (نطفيها لما نكون ماشين لدروب أصلًا)
local dropInterrupt = false

-- ═══════════ v2g-2: «يثبت على أمر واحد» ═══════════
-- العَرَض اللي شكت فيه: يروح للدروب، يتجاهله، يكمّل المهمة، وبعدين يلفّ بينهم ساعة.
-- السبب البنيوي: كل برومبت دروب داخل 24 متر كان يقدر يوقف مشية التسليم (ويكررها كل 2.5ث)،
-- فمهما كان الدروب بعيد عن طريقنا أو ما فيه برومبت بعد = نفس المشية تنقطع وترجع.
-- الحل: (1) MISSION_HOT = إحنا حاملين مهمة → ما نقاطّع إلا على التفاف صغير محسوب
--       (2) ميزانية مقاطعة لكل مشية + حجز البرومبت اللي ما أفاد
--       (3) حارس تبديلات: أكثر من 4 تهليلات بالنافذة = نقفل على التسليم مدة ونريح الدروب
local MISSION_HOT = false
local HUNT = { skips = 0, blocked = 0, fails = 0, lastHoldLog = 0, lastBusyLog = 0, lastFailLog = 0 }
local FLIP = { n = 0, t0 = 0, lockUntil = 0, logged = 0 }
-- «نافذة أولوية الدروب» (43): أول ما نشوف دروب حي نعلّق التسليم، ونرجع له لما الدروب ينأخذ
-- أو يختفي أو نجمع DROP_GOAL نقطة أو يخلص سقف DROP_WINDOW. السبب: التسليم كان يبلع الدروب
-- (COMMIT + FLIP.lockUntil + HUNT_MAX=1) وبعدين الدورة تلف وترجع له من بعيد — شكواك بالضبط.
local DP = { on = false, since = 0, pts0 = 0, n = 0, live = 0, lastScan = 0,
             strikes = 0, lockUntil = 0 }   -- (46) نافذتين ورا بعض بلا غنيمة = الدروب يقعد على الرفّ شوية
local function noteFlip(why)
  if tick() - FLIP.t0 > CFG.FLIP_WIN then FLIP.t0, FLIP.n = tick(), 0 end
  FLIP.n = FLIP.n + 1
  if FLIP.n >= CFG.FLIP_MAX and tick() >= FLIP.lockUntil then
    FLIP.lockUntil = tick() + CFG.FLIP_LOCK
    log(("zFLIP #%d %s — بدّلنا دروب↔تسليم %d مرات بـ%.0fث: نخلّص التسليم %dث بلا مقاطعة دروب"):format(
      FLIP.n, tostring(why), FLIP.n, CFG.FLIP_WIN, CFG.FLIP_LOCK))
  end
end
-- التفاف محسوب: كم تضيف هالمقاطعة للسكة الحالية؟ (متر، على المستوى ثلاثي الأبعاد)
local function detourCost(from, pad, destination)
  return (pad - from).Magnitude + (pad - destination).Magnitude - (from - destination).Magnitude
end
local function walkToTarget(destination, allowDropHunt)
  local r, hum = rootOf()
  if not r or not hum then return false end
  -- الوجهة لازم تكون نقطة صحيحة: prHostPos كان يرجّع nil على موبل بلا Position،
  -- و hum:MoveTo(nil) يرمي خطأ داخل الدورة (الميتة الصامتة اللي شكت منها).
  if typeof(destination) ~= "Vector3" or destination.X ~= destination.X then
    log("zWALK bad-destination — ما نمشي لوجهة مو نقطة")
    return false
  end
  -- سقف زمني للمشية: بدونه كان يلفّ حول نفس العائق للأبد والدورة ما ترجع
  local deadline = tick() + CFG.WALK_MAX
  tpCount = 0
  -- عدّاد تراكمي لكل مشي: «انتقال وقت الضرورة» ما كان يشتغل أبدًا لأن tries كان يصفّر عند كل نقطة
  local stuckAll = 0
  local nextHunt = ((allowDropHunt or DP.on) and DROP_ON) and (tick() + 2.5) or math.huge
  local huntN = 0                                     -- كم مرة دروب وقّفنا هالمشية
  local skipped = setmetatable({}, { __mode = "k" })   -- برومبتات جرّبناها وما أفادت (ما نعيد المقاطعة عليها)
  local detourSeen = setmetatable({}, { __mode = "k" })-- برومبتات قلنا «مو على طريقنا» مرة (ما نكرر السطر)

  local path = newPath()
  local okCompute = false
  if path then
    okCompute = pcall(function() path:ComputeAsync(r.Position, destination) end)
  end

  local wps
  if okCompute and path and path.Status == Enum.PathStatus.Success then
    wps = path:GetWaypoints()
  else
    log("zPATH fail — مشي مباشر للوجهة")
    hum:MoveTo(destination)
    local t = tick()
    while isRunning and not RUN.dead and (tick() - t < 5) do
      local rr = rootOf()
      if rr and (rr.Position - destination).Magnitude <= CFG.ARRIVE then return true end
      task.wait(CFG.POLL)
    end
    autoTp(destination, "path-fail")
    -- ما وصلنا: نبلّغ فشل بصراحة (كان يرجع true ويخلي السكربت يهلوس بأنه سلّم)
    local rr2 = rootOf()
    if rr2 and (rr2.Position - destination).Magnitude <= CFG.ARRIVE * 2 then return true end
    log(("zPATH fail-end d=%.1f"):format(rr2 and (rr2.Position - destination).Magnitude or -1))
    return false
  end

  local rubTotal, repaths = 0, 0
  local stuckRep = 0
  local wpTries = 0   -- (47) كم مناورة على نفس النقطة: «tries» ينصفّ مع كل نقطة فما يخلّنا نقدر نقول كفى
  local idx = 1
  JMP.n, JMP.meters = 0, 0
  -- عدّات هذه الرحلة فقط (zSEG يطبع الفرق، مو المجموع طوال الجلسة)
  LOS.t0c, LOS.t0s, SU.t0h = LOS.cuts, LOS.saved, SU.hops
  while ALIVE and isRunning and not RUN.dead and RUN.restUntil <= tick() and idx <= #wps and tick() < deadline do
    -- قفل دروب شغال بثريد ثاني يمشّيان: ما نكتب MoveTo فوق إدخاله، نستناه يخلص
    if crateBusy then
      local wt = tick()
      while crateBusy and ALIVE and isRunning and (tick() - wt < 10) do task.wait(0.2) end
      if crateBusy then log("zWALK busy>10s — نكمّل، والحارس نفكه") end
    end
    -- 📐 قطع الزوايا: لو الخط لأبعد نقطة واضح ويوفّر متر فعلي، اقطع لها (MoveTo بس)
    idx = pruneIdx(wps, idx, destination)
    if idx > #wps then break end
    local wp = wps[idx]
    local rr0 = rootOf()
    if not rr0 then break end
    -- (48) لو انبدلت الشخصية (موت/ريساون) أثناء المشية، hum القديم كائن مفقود:
    -- hum:MoveTo عليه يرمي خطأ يقتل ثريد المشي = «السكربت وقف والمشي تعطل». نعيد الربط كل نقطة.
    if rr0 ~= r or not hum then
      r = rr0
      hum = rr0:FindFirstChildOfClass("Humanoid")
      if not hum then task.wait(0.5) continue end
    end
    if wp.Action == Enum.PathWaypointAction.Jump then
      jumpNow(hum)
      JMP.n = JMP.n + 1
    end
    if hum then hum:MoveTo(wp.Position) end

    local lastP, stuckT, lastSeenD, tries = rr0.Position, tick(), (rr0.Position - wp.Position).Magnitude, 0
    local repathed = false
    local idxBefore = idx
    while ALIVE and isRunning and not RUN.dead and RUN.restUntil <= tick() and tick() < deadline do
      local rr = rootOf()
      if not rr then break end
      -- (48) انبدلت الشخصية نص المشية (موت/ريساون)؟ hum القديم كائن مفقود وأي
      -- MoveTo عليه يقتل الثريد. نعيد الربط ونبلش من أول لو طاح الـ Humanoid.
      if rr ~= r then
        r = rr
        hum = rr:FindFirstChildOfClass("Humanoid")
        if not hum then break end
      end
      local p = rr.Position
      local curDist = (p - wp.Position).Magnitude
      if curDist <= CFG.WP_DONE then break end
      -- (47) وصلنا الوجهة أفقيًا؟ نرجع نجاح على طول. قبل كان يلفّ على آخر نقطة داخل الصندوق
      -- (الوجهة = مركز دروب/صندوق) فما يتحرك، والعدّاد يسمّي الوقفة «تعليق» ويبدأ مناورة جانبية
      -- كل 1.8ث = العرجة اللي شكت منها، مع إن الدروب قدامه والإمساك ممكن من نفس المكان.
      -- والشرط النازل ما يخلّنا نقول «وصلنا» ونحن تحت صندوق على سقف: نفس المستوى تقريبًا.
      local toEnd = Vector3.new(destination.X - p.X, 0, destination.Z - p.Z)
      if toEnd.Magnitude <= CFG.ARRIVE and math.abs(destination.Y - p.Y) <= CFG.ARRIVE * 2.5 then
        return true
      end
      -- 🛡 (30-32) حراس المشي: كل نص ثانية (مو كل عيّنة — heldByGame تقيل شوي).
      -- قيد = ما ندفع شخصية مربوطة، وسقوط تحت آخر أرض آمنة = ما نمشي وأنت طايح.
      -- الحارس يوقف المشية ويرجّعها للدورة: هي تقرر إعادة الحساب، مو هو.
      if DEF.probe and tick() >= DEF.nextChk then
        DEF.nextChk = tick() + 0.5
        DEF.probe(p, hum)
        if DEF.stopWalk then
          DEF.frozenN = DEF.frozenN + 1
          hum:MoveTo(p)
          return false
        end
      end
      -- قرب النقطة وعمود/حاجز بيننا وبينها: لا نحرق ثانيتين عليها، تجاوزها (هذا كان يبطّئ السكة كلها)
      local nearWp = curDist <= CFG.WP_DONE * 2
      if nearWp and (tick() - stuckT > 0.7) then break end
      -- 🦘 القفز الاستباقي: رِماك قدامنا = حاجز وطي؟ نطي بدل ما نعلق ونسمّيه «تعليق»
      obstacleHop(rr, hum, wp.Position)
      -- 🪜 طلعة الرادّة: الأرض قدامنا أعلى بشوي و فيها مجال فوق = نطي ونطلع (سلالم/حافة)
      stepUpHop(rr, hum, wp.Position)

      --  صيد الدروب أثناء المشي الطويل: التوجه للتسليم كان يبلع 40 ثانية ما نشوف فيها شي
      -- تصحيح من سجلك: برومبت «اخذ صندوق» حق نقطة الاستلام كان يوقف المشي ويحسبه دروب
      -- (zDROP during-walk txt=[اخذ صندوق] ثم zSEG ... ok=false) — نستثنيه مثل tryDrop
      -- (43) النافذة مفتوحة = نصيد حتى لو caller ما سمح بالصيد: الدروب صار أعلى من السكة
      if (allowDropHunt or DP.on) and DROP_ON and not crateBusy and tick() >= nextHunt then
        nextHunt = tick() + 2.5
        local real = nil
        for _, e in ipairs(nearPrompts(CFG.DROP_RADIUS)) do
          if not (e.info.path and (e.info.path:find("CratesStarter", 1, true)
              or e.info.path:find("DeliveryCrates", 1, true)))
              and not skipped[e.p] then
            real = e break
          end
        end
        if real then
          -- إحنا حاملين مهمة؟ نفحص الالتفاف: دروب على 24 متر بس خلف سور = يكلّفنا 120 متر، ما نقطع له
          local hp = real.host
          local extra = (hp and MISSION_HOT) and detourCost(p, hp, destination) or 0
          local tooFar = MISSION_HOT and hp and (hp - destination).Magnitude > (p - destination).Magnitude + CFG.DETOUR
          if MISSION_HOT and not DP.on and tick() < FLIP.lockUntil then
            HUNT.blocked = HUNT.blocked + 1
            if tick() - (HUNT.lastHoldLog or 0) > 8 then
              HUNT.lastHoldLog = tick()
              log(("zHUNT hold d=%.1f txt=[%s] — مقفل على التسليم (%.0fث باقي): ما نقاطّع المهمة"):format(
                real.dist, real.info.txt, FLIP.lockUntil - tick()))
            end
          elseif huntN >= CFG.HUNT_MAX + (DP.on and 4 or 0) then
            -- داخل نافذة الأولوية نسمح بمقاطعات أكثر: الدروب هو الشغل الحين، مو زحمة على الطريق
            skipped[real.p] = true
            HUNT.skips = HUNT.skips + 1
            log(("zHUNT skip#%d d=%.1f txt=[%s] — جرّبنا مقاطعة واحدة وهالمشية ما تنقطع مرة ثانية"):format(
              HUNT.skips, real.dist, real.info.txt))
          elseif tooFar and not DP.on then
            -- ما نحجزه: الالتفاف يحسب من مكاننا الحالي، فكل ما قربنا من طريقه يصير مسموح.
            -- نكرر الفحص كل 2.5ث بس ما نغرق السجل — سطر واحد لكل برومبت بكل مشية
            if not detourSeen[real.p] then
              detourSeen[real.p] = true
              HUNT.skips = HUNT.skips + 1
              log(("zHUNT detour=%.0f>%d d=%.1f txt=[%s] — مو على طريقنا: نكمّل التسليم ونرجع له"):format(
                extra, CFG.DETOUR, real.dist, real.info.txt))
            end
          else
            huntN = huntN + 1
            dropInterrupt = true
            log(("zDROP during-walk d=%.1f txt=[%s] — وقّفنا المشي، الدروب أول"):format(
              real.dist, real.info.txt))
            hum:MoveTo(p)
            return false
          end
        end
      end

      -- 🛡️ كاشف «يرجع للور»: على المستوى الأفقي فقط (السقوط مو مطاطية)، وعتبة تتبع سرعتك
      -- سرعتك 65 = 6.5 متر/عيّنة (0.1ث) — عتبة 4.5 ثابتة كانت تحسب كل خطوة طبيعية مطاطية وتوقف المشي
      local dx, dz = p.X - lastP.X, p.Z - lastP.Z
      local step = math.sqrt(dx * dx + dz * dz)
      if step < 12 then JMP.meters = JMP.meters + step end
      local rubLim = math.max(CFG.RUBBER_STEP, SPD.now * CFG.POLL * CFG.RUB_FACTOR)
      if RUB_DETECT and step > rubLim then
        local dl = destination - lastP
        dl = Vector3.new(dl.X, 0, dl.Z)
        local along = Vector3.new(dx, 0, dz):Dot((dl.Magnitude > 0.5 and dl.Unit) or Vector3.new(0, 0, 0))
        if along < -1 then
          rubTotal = rubTotal + 1
          rubberHits = rubberHits + 1
          -- المواجهة تزيد الرجعة: نكفّ عن تثبيت السرعة 2.5ث عشان السيرفر يلحق موقعنا،
          -- ولو كان السبب كتابة CFrame فنكفّ عنها كمان (شوف قاطع الانهيار فوق في tpTo)
          SPD.relaxUntil = tick() + 2.5
          -- (55) التثبيت فوق رقم الماب هو أكبر مولّد للرجعة: بعد مطاطيتين بنفس المشية نفكّه
          -- بدل ما نعيد كتابته كل 2.5ث ونحارب السيرفر (علّة «يرجع اللاعب خطوات / يعلق»).
          if CFG.SPD_LOCK and rubTotal >= 2 and yieldSpeedLock then yieldSpeedLock("rubber") end
          log(("zRUBBER #%d step=%.1f along=%.1f lim=%.1f idx=%d/%d d=%.1f mode=%s — خفّفنا الدفع 2.5ث"):format(
            rubTotal, step, along, rubLim, idx, #wps, curDist, CFG.MOVE_MODE))
          if CFG.MOVE_MODE == "walk" and repaths < 3 then
            -- ما ندفع ضد السيرفر: نستنى شوية ونعيد حساب المسار من مكاننا
            task.wait(0.6)
            local np = newPath()
            local okN = np and pcall(function() np:ComputeAsync(rootOf().Position, destination) end)
            if okN and np and np.Status == Enum.PathStatus.Success then
              repaths = repaths + 1
              wps = np:GetWaypoints()
              idx = 1
              repathed = true
              wpTries = 0   -- (48) مسار جديد = خطة جديدة: عدّاد المناورات يرجع للصفر
              break
            end
          end
          -- (48) الشرط القديم كان ما يشتغل أبدًا: وضع legacy ما يدخل بلوك إعادة الحساب
          -- (مشروط بـ walk) فيبقى repaths = 0 أبدًا → «rrepaths>=3» ما تصير true،
          -- فالحماية من المطاطية كانت مطفية والسكربت يدفع ضد السيرفر لين يعلق.
          local repathSpent = (CFG.MOVE_MODE ~= "walk") or repaths >= 3
          if RUB_STOPACT and rubTotal >= CFG.RUBBER_STOP and repathSpent then
            log(("zRUBBER stop — %d رجعة و%d مسار جديد (mode=%s)، نوقف السكة هذي ونعيد الحساب"):format(
              rubTotal, repaths, CFG.MOVE_MODE))
            if hum then hum:MoveTo(p) end
            return false
          end
        end
      end
      lastP = p

      -- فك تعليق: مشي + قفز فقط (ما نلمس CFrame في وضع walk)
      -- (47) مقياس التعليق صار «قرّبنا ولا لا» مو «تحركنا ولا لا»: لمّة جانبية أو قفزة أو
      -- رجعة مطاطية كانت تُحسب تقدّم وتخلي الشخصية تدور حول نفسها، والعكس — مشي بطيء نحو
      -- الهدف كان يُسمّى تعليق وتبدأ مناورة جانبية كل 1.8ث = العرجة.
      if tick() - stuckT > 1.8 then
        if curDist > lastSeenD - 0.75 then
          tries = tries + 1
          wpTries = wpTries + 1
          stuckAll = stuckAll + 1
          log(("zSTUCK #%d all=%d d=%.1f idx=%d/%d"):format(tries, stuckAll, curDist, idx, #wps))
          -- لو علّقنا بعد قطع زاوية = التقطيع غلطان بهالمكان: نوقفه 20 ثانية ونكمل بالمسار
          if CFG.LOS_PRUNE and tick() - LOS.last < 6 then
            LOS.bad, LOS.jail = LOS.bad + 1, tick() + 20
            log(("zLOS bad#%d — علّقنا بعد تقطيع، نوقف القطع 20ث (total cuts=%d saved=%.0fm)"):format(
              LOS.bad, LOS.cuts, LOS.saved))
          end
          -- التعليق الحقيقي: نعيد حساب المسار من مكاننا، بدل ما نتجاوز نقطة على بعد 73 متر ونتركها
          if CFG.REPATH and CFG.MOVE_MODE == "walk" and stuckRep < 2 and curDist > CFG.ARRIVE * 3 then
            local oldIdx, oldN = idx, #wps
            local np = newPath()
            local okN = np and pcall(function() np:ComputeAsync(p, destination) end)
            if okN and np and np.Status == Enum.PathStatus.Success then
              stuckRep = stuckRep + 1
              wps = np:GetWaypoints()
              idx = 1
              repathed = true
              wpTries = 0   -- (48) مسار جديد من مكاننا = نقطة مختلفة: نبدأ عدّ من الصفر
              log(("zREPATH #%d cut=%d/%d new=%d d=%.1f"):format(stuckRep, oldIdx, oldN, #wps, curDist))
              break
            end
          end
          local dir = toEnd
          if dir.Magnitude > 0.5 then
            dir = dir.Unit
            -- وقت الضرورة: بعد ما تعالت المحاولات (يفلّجها المستخدم من قسم السلامة)
            -- stuckAll تراكمي: tries كان يصفّر مع كل نقطة فما يوصل الحد أبدًا (شكواك: ما في انتقال)
            if stuckAll >= CFG.STUCK_TP and autoTp(destination, "stuck") then
              local rr3 = rootOf()
              if rr3 and (rr3.Position - destination).Magnitude <= CFG.ARRIVE * 2 then return true end
              break
            end
            if CFG.MOVE_MODE == "walk" then
              if JUMP_ON then jumpNow(hum) end
              hum:MoveTo(p + dir * 8)
              task.wait(0.45)
              if wpTries >= 2 then
                local r2 = rootOf()
                if r2 then
                  local side = Vector3.new(-dir.Z, 0, dir.X) * ((wpTries % 2 == 0) and 7 or -7)
                  hum:MoveTo(r2.Position + side)
                  task.wait(0.4)
                  hum:MoveTo(r2.Position + dir * 8)
                  task.wait(0.4)
                end
              end
            else
              -- سلوك v1.3 القديم (دفعة CFrame) — محفوظ، يشتغل فقط لو قلّبت MOVE_MODE = "legacy"
              pcall(function()
                local r3 = rootOf()
                if r3 then r3.CFrame = r3.CFrame + Vector3.new(dir.X * 3.5, 1.2, dir.Z * 3.5) end
              end)
              task.wait(0.2)
            end
          end
          -- (47) بعد 4 مناورات على نفس النقطة نطلع للمنادي يقرر (نعيد الحساب/نسلّم/نصيد دروب):
          -- قبل كان idx++ يبلع النقطة ونلفّ حول العائق لين سقف المشية (75ث) — «يقف ويعلق» بعينه.
          if wpTries >= 4 then
            log(("zSTUCK bail#%d d=%.1f idx=%d/%d — أربع مناورات على نفس النقطة: نطلع للدورة تقرر"):format(
              wpTries, curDist, idx, #wps))
            hum:MoveTo(p)
            return false
          end
          -- ما نبلع النقطة: إحنا ما وصلناها، جرّبنا ناوَرها. النقطه الجاية = نفس النقطة بمسار جديد.
          repathed = true
          break
        end
        lastSeenD, stuckT = curDist, tick()
      end
      task.wait(CFG.POLL)
    end
    if not repathed then idx = idx + 1 end
    -- (48) «أربع مناورات على نفس النقطة» تُعدّ على النقطة مو على عمر المشية: كل ما تبدّلت
    -- النقطة (تقدّم عادي أو مسار جديد من مكاننا) يصفّر العدّاد. قبل كان يصفّر عند التقدّم
    -- فقط، فأي إعادة حساب كانت تبلع العدّاد وتوقف المشية كاملة بعد 4 لفّات = «يمشي شوي ويوقف».
    if idx ~= idxBefore then wpTries = 0 end
  end

  local rr = rootOf()
  if tick() >= deadline then
    log(("zWALK timeout=%ds idx=%d/%d — وقّفنا هالمشية بدل لفّ حول نفس العائق"):format(
      CFG.WALK_MAX, idx, #wps))
  end
  return (rr ~= nil) and ((rr.Position - destination).Magnitude <= CFG.ARRIVE * 2)
end

-- مشي محسوب الوقت: يقول لك زمن كل مرحلة ومتوسط سرعتك فيها — هنا تعرف وين يضيع الوقت
local function timedWalk(destination, tag, allowDropHunt)
  local r0 = rootOf()
  local d0 = r0 and (r0.Position - destination).Magnitude or -1
  local t0 = tick()
  local ok = walkToTarget(destination, allowDropHunt)
  local secs = tick() - t0
  local avg = (secs > 0.3 and d0 > 0) and (d0 / secs) or 0
  local r1 = rootOf()
  local rest = r1 and (r1.Position - destination).Magnitude or -1
  log(("zSEG %s dist=%.0f secs=%.1f avg=%.1f ok=%s rest=%.0f ws=%s rub=%d | cuts=%d saved=%.0fm hops=%d jumps=%d walked=%.0fm"):format(
    tostring(tag), d0, secs, avg, tostring(ok), rest, tostring(SPD.ws or 0), rubberHits,
    LOS.cuts - (LOS.t0c or 0), LOS.saved - (LOS.t0s or 0), SU.hops - (SU.t0h or 0), JMP.n, JMP.meters))
  return ok
end

-- ═══════════ الصندوق (v1.3) + دعم الإمساك ═══════════
local activeEnd   -- تعريفها تحت، ونحتاجها هنا نتأكد بيها إن الضغط نجح (بلا forward يصير nil صامت)
local function findChestPrompt()
  local dc = Workspace:FindFirstChild("DeliveryCrates")
  if dc then
    -- البحث الكلي: برومبت «اخذ صندوق» مو شرط يكون ابن مباشر لـ TakeChest
    -- (البحث المباشر وحده كان يرجّع nil = zCHEST no-prompt = ما نضغط أبدًا)
    local tc = dc:FindFirstChild("CratesStarter", true)
    tc = tc and (tc:FindFirstChild("TakeChest", true) or tc)
    local p = tc and tc:FindFirstChildWhichIsA("ProximityPrompt")
    if not p and tc then p = tc:FindFirstChild("ProximityPrompt", true) end
    if p then return p end
  end
  for d, info in pairs(PRMAP) do
    if d.Parent and classify(info) ~= "block"
        and (info.raw:lower():find("takechest", 1, true)
        or info.raw:find("صندوق", 1, true) or info.raw:find("اخذ", 1, true)
        or info.path:find("TakeChest", 1, true)) then
      return d
    end
  end
  return nil
end

-- يرجع: ضغطت؟ + سبب (حتى السجل يقول ليش ما ضغطنا، مو يسكت)
local function triggerChestPrompt()
  local prompt = findChestPrompt()
  if not prompt then log("zCHEST no-prompt") return false, "no-prompt" end
  local info = PRMAP[prompt] or { hold = 0, key = Enum.KeyCode.E, dist = 8 }
  -- قراءة حية: لو اللعبة مقفلة البرومبت (لسا كول داون أو علينا مهمة) ما نضغط على بارد
  refreshLive(prompt, info)
  if info.en == false then
    log("zCHEST disabled — البرومبت موجود بس اللعبة مقفله — علينا مهمة لسه ما سلمناها")
    return false, "locked"
  end
  local r, _ = rootOf()
  local hp = prHostPos(prompt)
  local dd = (r and hp) and (hp - r.Position).Magnitude or 999
  log(("zCHEST d=%.1f hold=%s key=%s"):format(dd, tostring(info.hold), asc(tostring(info.key))))
  if dd > (info.dist + 2) then
    walkToTarget(hp)
    local r2b = rootOf()
    dd = (r2b and hp) and (hp - r2b.Position).Magnitude or 999
    log(("zCHEST after-walk d=%.1f need=%s"):format(dd, tostring(info.dist)))
    if dd > (info.dist + 2) then
      log("zCHEST skip — ما وصلنا المدى، ما نضغط من بعد")
      return false, "far"
    end
  end
  local how
  if (tonumber(info.hold) or 0) > 0.15 then
    -- برومبت إمساك: ضغطة سريعة ما تفتح شي — نيمسك المدة اللي يعلنها البرومبت نفسه
    how = "hold"
    holdPrompt({ p = prompt, info = info }, holdSecs(info))
  else
    how = "tap"
    if fireproximityprompt then
      pcall(function() fireproximityprompt(prompt, 0) end)
      pcall(function() fireproximityprompt(prompt, 1) end)
      pcall(function() fireproximityprompt(prompt) end)
    end
    pcall(function()
      VirtualInputManager:SendKeyEvent(true, info.key or Enum.KeyCode.E, false, game)
      task.wait(0.12)
      VirtualInputManager:SendKeyEvent(false, info.key or Enum.KeyCode.E, false, game)
    end)
  end
  -- نتأكد بالنتيجة: بعد الضغط المفروض تنشط نقطة تسليم (أو تطلع مهمة)
  task.wait(0.35)
  local live = false
  pcall(function() live = (activeEnd() ~= nil) end)
  log(("zCHEST pressed=%s liveAfter=%s en=%s d=%.0f"):format(
    how, tostring(live), tostring(info.en), dd))
  return true, how
end

-- ═══════════ هدف التسليم ═══════════
-- live = جزء ظاهر (Transparency<1) داخل DeliveryCrates وبعيد >25 عن نقطة البداية — نفس اللي ينطبر بكشفك
-- nil  = ما فيه مهمة شغالة (الكول داون) ← ما نمشي على تخمين، ونستنى بدل الهرجلة
-- seen = كم جزء موجود فعلًا (ولو مخفي) — لو seen>0 و live=0 معناها البوابة المخفية هي الوجهة
activeEnd = function()
  local dc = Workspace:FindFirstChild("DeliveryCrates")
  if not dc then return nil, nil, "no-folder", 0, 0 end
  local char = lp.Character
  local starter = dc:FindFirstChild("CratesStarter")
  local r = rootOf()
  local best, live, seen = nil, 0, 0
  for _, ch in ipairs(dc:GetDescendants()) do
    if ch:IsA("BasePart") and ch.Name ~= "CratesStarter"
       and not (starter and ch:IsDescendantOf(starter))
       and not (char and ch:IsDescendantOf(char))
       and (ch.Position - CFG.START_POS).Magnitude > 25 then
      seen = seen + 1
      local okT, tr = pcall(function() return ch.Transparency end)
      if okT and tr and tr < 1 then
        live = live + 1
        local d = r and (ch.Position - r.Position).Magnitude or 0
        if not best or d < best.d then best = { pos = ch.Position, part = ch, d = d } end
      end
    end
  end
  if best then return best.pos, best.part, "live", live, best.d, seen end
  return nil, nil, "none", live, 0, seen
end

-- ── مراقب فولدر التسليم (قراءة فقط كل 2ث، بدون أي hook): «متى بدأت المهمة فعلًا» ──
-- (55) الدليل الوحيد هنا: نقطة تسليم انقلت من مخفية إلى ظاهرة. أي شي ثاني (جزء جديد
-- شفاف، PointerPart، ديكور يتكوّن، نقطة اختفت بعد التسليم) مو «مهمة مفتوحة».
local TRMAP = setmetatable({}, { __mode = "k" })
local trSeeded = false
local folderChanged, folderChangedWhat = 0, "?"
local function folderFresh()
  return folderChanged > 0 and (tick() - folderChanged) <= CFG.LIVE_WIN
end
local folderLogAt = 0
task.spawn(function()
  while ALIVE do
    task.wait(2)
    local dc = isRunning and Workspace:FindFirstChild("DeliveryCrates") or nil
    if dc then
      local now = setmetatable({}, { __mode = "k" })
      -- نراقب وجهات التسليم فقط: سجلك طلع DecorCrates/Platform «جديد» كل شوي = ديكور يتكوّن من
      -- جديد، ولو حسبناه دليل مهمة صرنا نوسّع البحث بلا سبب
      local eps = dc:FindFirstChild("CratesEndPoints")
      for _, ch in ipairs(dc:GetDescendants()) do
        -- نقاط التسليم الحقيقية فقط: «PointerPart» والديكور الجديد كان يُحسب بداية مهمة
        -- ويخلي missionLive يهلوس إن علينا شغل لـ 150 ثانية — فطحنّاه من هنا.
        if ch:IsA("BasePart") and (
            (eps and ch:IsDescendantOf(eps)) or ch.Name:find("EndPoint", 1, true)) then
          local okT, tr = pcall(function() return ch.Transparency end)
          now[ch] = (okT and tonumber(tr)) or -1
        end
      end
      local ev = nil
      if trSeeded then
        for ch, tr in pairs(now) do
          -- الدليل الوحيد: نقطة تسليم صارت ظاهرة (tr<1) الآن. جزء جديد شفاف (tr=1) أو
          -- تبدّلت شفافيّته وهو مخفي، أو اختفى (انسلّم) — ما أي واحد منهم «مهمة مفتوحة».
          if tr < 1 then
            local old = TRMAP[ch]
            if old == nil or old >= 1 then
              ev = string.format("ظهرت نقطة=%s tr=%s", asc(ch.Name), tostring(tr))
              break
            end
          end
        end
      end
      TRMAP = now
      trSeeded = true
      if ev then
        folderChanged = tick()
        folderChangedWhat = ev
        if tick() - folderLogAt > 3 then
          folderLogAt = tick()
          log(("zFOLDER %s"):format(ev))
        end
      end
    end
    -- مطفي = نعيد البذرة، حتى أول تغيير بعد التشغيل يكون تغييرًا حقيقيًا مو فرق قديم
    if not isRunning then
      trSeeded = false
      TRMAP = setmetatable({}, { __mode = "k" })
    end
  end
end)

-- الجزء اللي عليه Beam/Highlight داخل فولدر التسليم = علامة اللعبة نفسها على الوجهة
local function partMarked(ch)
  for _, o in ipairs(ch:GetChildren()) do
    if o:IsA("Beam") or o:IsA("Highlight") or o:IsA("BillboardGui") then return true end
  end
  return false
end

-- المهمة شغالة (missionLive) بس activeEnd ما لك نقطة: نوسّع داخل DeliveryCrates ONLY.
-- ما نلمس Map/Assets — نفس الهرجلة القديمة (HoveringText y=1540) ما نرجع لها.
local function wideEnd(tag)
  if not CFG.WIDE_END then return nil end
  local dc = Workspace:FindFirstChild("DeliveryCrates")
  if not dc then return nil end
  local char = lp.Character
  local starter = dc:FindFirstChild("CratesStarter")
  local r = rootOf()
  local cand, n = {}, 0
  for _, ch in ipairs(dc:GetDescendants()) do
    if ch:IsA("BasePart") and not (char and ch:IsDescendantOf(char))
       and not (starter and ch:IsDescendantOf(starter))
       and (ch.Position - CFG.START_POS).Magnitude > 25 then
      n = n + 1
      local okT, tr = pcall(function() return ch.Transparency end)
      cand[#cand + 1] = {
        pos = ch.Position, part = ch, marked = partMarked(ch),
        tr = (okT and tonumber(tr)) or -1,
        d = r and (ch.Position - r.Position).Magnitude or 0,
      }
    end
  end
  if #cand == 0 then
    log(("zWIDE %s parts=0 — فولدر التسليم فاضي فعلًا، ما علينا مهمة"):format(tostring(tag)))
    return nil
  end
  table.sort(cand, function(a, b)
    if a.marked ~= b.marked then return a.marked end
    return a.d < b.d
  end)
  local pick = cand[1]
  log(("zWIDE %s parts=%d pick=%s d=%.0f marked=%s tr=%s fresh=%s"):format(
    tostring(tag), n, asc(pick.part.Name), pick.d, tostring(pick.marked), tostring(pick.tr),
    tostring(folderFresh())))
  -- بدون دليل (علامة اللعبة على الجزء أو zFOLDER حديث) ما نمشي لأي جزء شكلّي بالماب
  if not pick.marked and not folderFresh() then
    log("zWIDE reject — لا Beam على الجزء ولا zFOLDER حديث — ما نضيع مشي على ديكور")
    return nil
  end
  if pick.d > CFG.TGT_MAXD then
    log(("zWIDE reject d=%.0f>%d"):format(pick.d, CFG.TGT_MAXD))
    return nil
  end
  return pick.pos, pick.part, "wide"
end

-- «علينا مهمة لسه ما سلمناها» — ثلاث أدلة من سيرك، ما واحد منهم تخمين وجهة:
--   end    = شفت نقطة تسليم ظاهرة داخل DeliveryCrates (أقوى دليل)
--   folder = (55) zFOLDER: نقطة CratesEndPoints انقلت من مخفية إلى ظاهرة — يعني اللعبة
--            فتحت مهمة «الآن». جزء جديد شفاف أو ديكور أو PointerPart ما يعدّون دليل.
--   locked = برومبت «اخذ صندوق» موجود ومقفل = ما يعطيك ثاني قبل التسليم
-- ملاحظة من سجلك: WS=16 مو دليل — هو وضع «مشي» حقك أنت (24 = ركض)، فطلعناه من الأدلة.
local function missionLive()
  local pos = nil
  pcall(function() pos = activeEnd() end)
  if pos then return true, "end" end
  if folderFresh() then return true, "folder(" .. folderChangedWhat .. ")" end
  local p = nil
  pcall(function() p = findChestPrompt() end)
  if p then
    local info = PRMAP[p]
    if not info then
      info = {}
      pcall(function() info = { en = p.Enabled, hold = p.HoldDuration, dist = p.MaxActivationDistance } end)
    end
    if info.en == false then return true, "locked" end
  end
  return false, "none"
end

-- (55) «علينا صندوق الآن؟» = فيه نقطة تسليم ظاهرة (activeEnd حي). أرخص دليل وأقواه:
-- اللي يبلع المهمة ويروح يقفل صندوق ثاني وهو لسه حامل = «يهلوس ويرجع ياخذ صندوق».
local function carryingNow()
  local pos = nil
  pcall(function() pos = activeEnd() end)
  return pos ~= nil
end

-- يرجع: pos, part, why  (pos = nil يعني ما فيه مهمة — الكول داون)
local function findDeliveryTarget()
  local pos, part, why, live, d, seen = activeEnd()
  if pos then
    log(("zEND live=%d nearest=%.0f seen=%d"):format(live, d, seen or -1))
    return pos, part, why
  end
  log(("zEND live=0 why=%s seen=%d — parts موجودة بس كلها مخفية؟"):format(why, seen or -1))
  if not CFG.TGT_GUESS then return nil, nil, why end
  -- ↓↓ التخمين القديم (v1.3) محفوظ، يشتغل فقط لو قلّبت «تخمين الوجهة» من الواجهة
  local char = lp.Character
  local marked = {}
  for _, obj in ipairs(Workspace:GetDescendants()) do
    if (obj:IsA("Beam") or obj:IsA("Highlight") or obj:IsA("BillboardGui")) and not (char and obj:IsDescendantOf(char)) then
      local part = obj.Parent
      if part and part:IsA("BasePart") and (part.Position - CFG.START_POS).Magnitude > 25 then
        marked[#marked + 1] = { pos = part.Position, part = part, d = (part.Position - CFG.START_POS).Magnitude }
      end
    end
  end
  table.sort(marked, function(a, b) return a.d > b.d end)
  if marked[1] then
    log(("zEND guess part=%s"):format(asc(marked[1].part and marked[1].part:GetFullName() or "?")))
    return marked[1].pos, marked[1].part, "guess"
  end
  -- (48) بدل نقطة واحدة ثابتة: أقرب نقطة تسليم مؤمنة من الفحص حسب مكاننا الحالي
  local r0 = rootOf()
  if r0 then
    local e = nearestEnd(r0.Position)
    if e then return e.p, nil, "ends-nearest:" .. e.n end
  end
  return CFG.FALLBACK_TGT, nil, "fallback"
end

-- ═══════════ قفل الدروب من لحظة سقوطه ═══════════
-- التسلسل المؤكد من مراقبك أنت (مو تخمين):
--   +369.4s  zNEW MeshPart NormalCrate parent=Effects p=224,941,-2800  +  Notification «لقد سقط دروب»
--   +407.8s  zPR NEW ProximityPrompt txt=[فتح الصناديق] hold=5  ← البرومبت يطلع عند الهبوط (38 ثانية مهلة)
--   +414.0s  zGONE — لاعب ثاني أخذه (عمره على الأرض 6.2 ثانية)
--   كشف الربح: برومبت 15.4s → UI حق E 24.5s → 30.2s أخذ → نقاط 985 -> 1085 (+100)
-- فالسرعة ما نياخذها بالطيران، نياخذها بالمهلة: نمشي له من أول ما ينزل من السماء
-- crateBusy معرّف فوق مع حالة الجلسة: walkToTarget يقرأه، ولو محلي هنا يصير global فاضي
local announcedAt = 0

local function cratePromptOn(crate)
  local ok, pr = pcall(function() return crate:FindFirstChildOfClass("ProximityPrompt") end)
  if ok and pr then return pr end
  local ok2, kids = pcall(function() return crate:GetChildren() end)
  if ok2 then
    for _, c in ipairs(kids) do if c:IsA("ProximityPrompt") then return c end end
  end
  return nil
end

local crateBusySince = 0
local function crateWork(crate)   -- جسم المطاردة: الغلاف يضمن إن crateBusy ينطفي حتى لو طاح خطأ
    crateBusy, crateBusySince = true, tick()
    DP.open("صندوق نازل")         -- (43) الحدث نفسه = الدروب صار أولوية، التسليم يستنى
    local p0, t0 = pts(), tick()
    local r0 = rootOf()
    local d0 = (r0 and r0.Position - crate.Position).Magnitude or -1
    log(("zLOCK crate=%s p=%.0f,%.0f,%.0f d=%.0f"):format(
      asc(crate.Name), crate.Position.X, crate.Position.Y, crate.Position.Z, d0))
    -- 1) نتابعه وهو نازل: نفس ذكاء مشي المهمة (pathfinding + تجاوز عوائق)، مو نشيد على الجدران
    local pr, info = nil, nil
    local follow = makeTracker(math.max(0.5, tonumber(CFG.FOLLOW_STEP) or 1.2)) -- ما نحسب مسار كل 0.12ث (يجيب لقمة)
    while isRunning and not RUN.dead and DROP_ON and LOCK_ON and (tick() - t0 < CFG.CRATE_LEAD) do
      if not crate.Parent then break end
      local cp = crate.Position
      pr = cratePromptOn(crate)
      if pr then
        pcall(function() prIndex(pr) end)
        info = PRMAP[pr]
        -- بوابة двойثة: برومبت على جسم الصندوق + نصه ما يكون شراء/كلبش/انتقال
        if info and info.en ~= false and classify(info) ~= "block" then break end
      end
      local r, hum = rootOf()
      if r and hum then
        local ground = Vector3.new(cp.X, r.Position.Y, cp.Z)
        local dg = (r.Position - ground).Magnitude
        if not CFG.SMART_DROP then
          hum:MoveTo(ground)                       -- السلوك القديم (نشيد مباشر) لو طفت الذكاء
        elseif cp.Y > CFG.LAND_Y and dg < 30 then
          hum:MoveTo(ground)                        -- وهو عالي ما له داعي مسار كل 0.12ث
        elseif cp.Y <= CFG.LAND_Y or dg > 60 then
          follow(ground)                            -- مسار حقيقي + تجاوز عوائق
        end
      end
      task.wait(0.12)
    end
    if not pr or not info or not isRunning or not DROP_ON then
      log(("zLOCK miss t=%.1f pr=%s run=%s"):format(tick() - t0, tostring(pr ~= nil), tostring(isRunning)))
      return
    end
    local secs = holdSecs(info)
    local hp = prHostPos(pr)
    local r = rootOf()
    local dd = (hp and r) and (hp - r.Position).Magnitude or 999
    log(("zLOCK go t=%.1f d=%.1f mad=%s hold=%s txt=[%s]"):format(
      tick() - t0, dd, tostring(info.dist), tostring(info.hold), info.txt))
    -- 2) ما نضغط من بعد: نلمس المدى أول (المشي عادة يكون خلّص من المهلة)
    if not hp then
      -- جسم البرومبت ما أعطى Position: نستخدم موقع الجزء نفسه بدل الوقوف بلا هدف (كان سبب «ما ينتقل»)
      hp = crate.Position
      dd = (r and (hp - r.Position).Magnitude) or 999
      log("zLOCK host-pos-nil — استعملنا موقع الصندوق")
    end
    -- (48) info.dist ممكن يكون nil لو البرومبت انمسح قبل ما نوصل للقارنة —
    -- و qارنة على nil كانت تقتل الثريد وتحبس crateBusy.
    local mad = tonumber(info.dist) or 10
    if dd > mad + 1 then
      -- النقل مو «نكتب ونمشي»: tpTo يتأكد إن السيرفر خلّانا، ولو رجّعنا نكمل مشي بدون ما نهلوس
      local moved = CFG.DROP_TP and tpTo(hp, "drop-lock")
      if not moved then
        StatusText.Text = "🎁 مشي للدروب..."
        walkToTarget(hp)
      end
    end
    -- 3) أمسك فورًا بالمدة الحقيقية — ما نستنى الدورة، الصندوق يعمر 6 ثواني بس
    StatusText.Text = "🎁 إمساك الدروب..."
    local why = holdPrompt({ p = pr, info = info }, secs)
    task.wait(0.3)
    local gain = pts() - p0
    if gain >= 50 then
      dropOK = dropOK + 1
      task.wait(CFG.BOX_GAP)   -- فاصل بين صندوقين: نفتح، نستنى، وبعدها نطارد التالي
    end
    log(("zDROP lock=%s result=%s +pts=%d t=%.1f hold=%.1f mad=%s drops=%d"):format(
      asc(crate.Name), tostring(why), gain, tick() - t0, secs, tostring(info.dist), dropOK))
    pcall(function()
      UI.DropLbl.Text = string.format("دروب اخذته الجلسة: %d  | hold=%s  المدى=%s",
        dropOK, tostring(info.hold), tostring(info.dist))
    end)
end

-- (48) قبل، القفل كان ينطفي داخل الثريد فقط: أي خطأ (قارنة على info.dist=nil، مشي،
-- إمساك) يقتل الثريد و crateBusy باقي true — فكل مشية تستنى 10 ثواني عند كل نقطة
-- والدورة تجمد لين يفكّها مراقب الـ 95 ثانية. هذا كان «المشي معطوب» بعينه.
-- الحين الغلاف يطفّي القفل دائمًا، والخطأ ينطبع بالسجل بدل ما يموت بصمت.
local function grabCrate(crate)
  if crateBusy then return end
  -- (55) حاملين صندوق: ما نبلع مهمتنا ونروح نقفل دروب ثاني (شكوى «ياخذ صندوق وهو بالمهمة»).
  -- الدروب ما يضيع — بعد ما نسلم ترجع الدورة تصيده لو لسه حي.
  if carryingNow() then
    if tick() - (HUNT.lastCarryLog or 0) > 6 then
      HUNT.lastCarryLog = tick()
      -- عدّاد موطّر مثل السطر: «كم مرة وقفنا الحارس» مو «كم صندوق رفضنا»
      HUNT.carrySkips = (HUNT.carrySkips or 0) + 1
      log("zLOCK skip — علينا مهمة شغالة (نقطة تسليم ظاهرة): نسلم أول، وما نقفل صندوق فوقها")
    end
    return
  end
  task.spawn(function()
    local ok, err = pcall(crateWork, crate)
    crateBusy = false
    if not ok then log("zLOCK error — " .. asc(tostring(err))) end
  end)
end

conn(Workspace.DescendantAdded:Connect(function(d)
  if crateBusy or not LOCK_ON or not isRunning or not DROP_ON then return end
  if not d:IsA("BasePart") then return end
  local p = d.Parent
  if not p or p.Name ~= "Effects" then return end
  local isCrateName = (d.Name:find("Crate", 1, true) ~= nil)
  local announced = (announcedAt > 0 and (tick() - announcedAt) < 60 and d.Position.Y > 300)
  if isCrateName or announced then grabCrate(d) end
end))

-- كنس الصندوق الموجود فعلًا: الحدث اللي فوق يفوت فقط لو الشغال جديد.
-- شكواك «أشغّل السكربت وما يفحص الدروب» = الصندوق كان نازل قبل ما نشغّل، فما أحد شافه.
local sweptRecently = setmetatable({}, { __mode = "k" })
local function sweepCrates(why)
  if crateBusy or not LOCK_ON or not isRunning or not DROP_ON then return end
  local eff = Workspace:FindFirstChild("Effects")
  local r = rootOf()
  if not eff or not r then return end
  local best, bestD = nil, math.huge
  for _, d in ipairs(eff:GetChildren()) do
    if d:IsA("BasePart") and d.Name:find("Crate", 1, true) and d.Parent then
      local okP, pos = pcall(function() return d.Position end)
      if okP and pos then
        local dd = (pos - r.Position).Magnitude
        if dd < bestD then best, bestD = d, dd end
      end
    end
  end
  if best and bestD <= CFG.SCAN_R then
    local last = sweptRecently[best] or 0
    if tick() - last >= CFG.SCAN_AGAIN then
      sweptRecently[best] = tick()
      log(("zSCAN %s crate=%s d=%.0f y=%.0f — قفلناه بدون ما نستنى حدث"):format(
        tostring(why), asc(best.Name), bestD, (best.Position and best.Position.Y) or -1))
      grabCrate(best)
    elseif VERBOSE then
      log(("zSCAN %s skip crate=%s last=%.0fث"):format(tostring(why), asc(best.Name), tick() - last))
    end
  end
end

-- إشارة «سقط دروب» = أول خبر ممكن يوصلنا (قراءة فقط، بلا أي hook)
pcall(function()
  local rem = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("Notification")
  if not rem then log("zDROP no-Notification-remote") return end
  conn(rem.OnClientEvent:Connect(function(_, msg)
    local s = tostring(msg or "")
    if s:find("سقط", 1, true) then
      announcedAt = tick()
      log(("zDROP announce txt=[%s]"):format(asc(s)))
    elseif s:find("نقطة", 1, true) or s:find("حصلت", 1, true) then
      log(("zDROP notify txt=[%s] pts=%d"):format(asc(s), pts()))
    end
  end))
end)

-- ═══════════ الدروب الاحتياطي: لو السكربت اشتغل والصندوق على الأرض أصلًا ═══════════
local dropTries = {}
-- دروب جرّبناه والإمساك فشل (gone/stop/fail): نسمّيه ميت مؤقتًا.
-- دونه كان يعدّ «usable» فطور الدروب يلفّ حوله 12 ثانية وكل مرة يسكته كول داون tryDrop
-- = العَرَض اللي شكا منه: «يجي للدروب ويتجاهله ويكمل المهمة».
local DROP_FAIL = setmetatable({}, { __mode = "k" })
-- القيمة = متى يخلص الحجز (tick + مدة)، والمدة على قد السوِب:
--   «out» (السيرفر رجّعنا برا المدى) = الدروب حي قدامنا، نعاود بعد كول داونtry العادي
--   «gone/stop/ما ربحنا» = نسمّيه ميت 20ث، وإلا طور الدروب يلفّ حوله كل شوي والمهمة معلّقة
local function tryDrop(radius)
  local list = nearPrompts(radius or CFG.DROP_RADIUS)
  if #list == 0 then return false, false end
  -- «usable» = فيه دروب حقيقي نستناه. برومبت «اخذ صندوق» مو دروب، وكان يعدّ له
  -- فويقف الدورة 45 ثانية وهي واقفة على الصندوق نفسه (شكواك: يوقف بدل ما يدور المهمة)
  local usable = 0
  for _, e in ipairs(list) do
    if not isRunning or not DROP_ON then return false, true end
    local info = e.info
    -- برومبت بداية الصناديق (اخذ صندوق) هذا شغل دورة التسليم، ما هو دروب
    if not (info.path and info.path:find("CratesStarter", 1, true)) then
      local fAt = DROP_FAIL[e.p]
      local alive = not (fAt and tick() < fAt)
      if not alive then
        if tick() - (HUNT.lastFailLog or 0) > 8 then
          HUNT.lastFailLog = tick()
          log(("zDROP dead d=%.1f txt=[%s] rest=%.0f/%d — إمساكه فشل قبل شوي: ما نلفّ حوله، نكمّل الشغل"):format(
            e.dist, info.txt, fAt - tick(), CFG.DROP_FAIL_HOLD))
        end
      else
        usable = usable + 1
        if crateBusy then
          if tick() - (HUNT.lastBusyLog or 0) > 8 then
            HUNT.lastBusyLog = tick()
            log(("zDROP busy d=%.1f txt=[%s] — القفل الجوي مشغول (%.0fث): ما نقدر نأخذ الحين"):format(
              e.dist, info.txt, tick() - crateBusySince))
          end
          return false, true
        end
        if not dropTries[e.p] or (tick() - dropTries[e.p] > CFG.DROP_CD) then
          dropTries[e.p] = tick()
          local secs = holdSecs(info)
          local hp = prHostPos(e.p) or e.host
          if hp and e.dist > info.dist + 1 then
            -- النقل يتأكد بنفسه: لو السيرفر ما خلّانا فوق الصندوق نمشي له، ما نقف ننتظر zHOLD OUT
            local moved = CFG.DROP_TP and tpTo(hp, "drop")
            if not moved then
              StatusText.Text = "🎁 مشي للدروب..."
              log(("zDROP walk d=%.1f need=%s tp=%s"):format(e.dist, tostring(info.dist), tostring(CFG.DROP_TP)))
              -- (47) ما نمشي لمركز الصندوق: نقطة داخل الحاجز = وقفة بلا حركة على جنبه.
              local rr4 = rootOf()
              timedWalk(rr4 and DEF.approach(rr4.Position, hp, info.dist) or hp, "drop")
            end
          end
          local p0, t0 = pts(), tick()
          StatusText.Text = "🎁 إمساك E..."
          log(("zDROP kind=%s why=%s hold=%.1f txt=[%s] host=%s"):format(
            tostring(e.kind), tostring(e.why), secs, info.txt, asc(info.path or "?")))
          local why = holdPrompt(e, secs)
          task.wait(0.35)
          local gain = pts() - p0
          -- (47) «قال ok وما جاب نقطة» = العدّة خلصت والسيرفر ما سجّلها (غالبًا رجّعنا خطوات
          -- ورا). قبل كان يسمّيه ميت 20ث ويمشي — وهذا «علّق وضل واقف». نعيد الإمساك مرة وحدة
          -- لو لسه داخل المدى، ونمشي له مرة لو الرجعة طلعته برا.
          if why == "ok" and gain <= 0 then
            local rr5 = rootOf()
            local hp5 = prHostPos(e.p) or e.host
            if rr5 and hp5 then
              local lim5 = tonumber(info.dist) or 10
              if (hp5 - rr5.Position).Magnitude > lim5 then
                log("zDROP ok-no-gain — السيرفر رجّعنا برا المدى: نخطي له ونمسك من جديد")
                timedWalk(DEF.approach(rr5.Position, hp5, lim5), "drop-back")
              else
                log("zDROP ok-no-gain — لسه فوقه: إمساك ثاني بدون ما نسمّيه ميت")
              end
              p0 = pts()
              why = holdPrompt(e, secs)
              gain = pts() - p0
            end
          end
          log(("zDROP result=%s +pts=%d t=%.1f hd=%s"):format(
            tostring(why), gain, tick() - t0, tostring(info.hold)))
          if gain > 0 then
            DROP_FAIL[e.p] = nil
            return true, true
          end
          -- «out» = طلعنا من المدى بمطاطية: الدروب لسه قدامنا حي، فنعاود بعد كول الداون العادي (6ث)
          -- بدل ما نحجزه 20ث — الحجز الطويل هو اللي يخلّيه «يجي للدروب ويتجاهله ثم يرجع له»
          local hold = (why == "out") and CFG.DROP_CD or CFG.DROP_FAIL_HOLD
          DROP_FAIL[e.p] = tick() + hold
          HUNT.fails = (HUNT.fails or 0) + 1
          log(("zDROP retry-in=%ds why=%s — %s"):format(hold, tostring(why),
            why == "out" and "طلعنا من المدى، نعاود قربه" or "نسمّيه ميت مؤقتًا ونكمّل الشغل"))
          return false, true
        end
      end
    end
  end
  return false, usable > 0
end

-- ── (43) آليّة النافذة: تُنادى من المراقب كل نص ثانية، ومن الطور، ومن قفل الصندوق النازل ──
-- «حي» = برومبت دروب داخل المدى، مو زر الصناديق (CratesStarter/DeliveryCrates)، ومو محجوز بفشل
DP.count = function()
  -- نفس مدى tryDrop بالضبط: دروب أبعد من DROP_RADIUS مو «حي»، وإلا النافذة تصحّل على شي ما يصله
  -- والإمساك ما يجيه = التحير اللي شكت منه (كان math.max(...,30))
  local ok, list = pcall(nearPrompts, math.max(8, tonumber(CFG.DROP_RADIUS) or 24))
  if not ok or type(list) ~= "table" then return DP.live end
  local n = 0
  for _, e in ipairs(list) do
    local ip = e.info and e.info.path
    if not (ip and (ip:find("CratesStarter", 1, true) or ip:find("DeliveryCrates", 1, true))) then
      local fAt = DROP_FAIL[e.p]
      if not (fAt and tick() < fAt) then n = n + 1 end
    end
  end
  return n
end
DP.open = function(why)
  if DP.on then return true end
  if not (CFG.DROP_FIRST and DROP_ON and isRunning) then return false end
  DP.on, DP.since, DP.pts0 = true, tick(), pts()
  DP.n = DP.n + 1
  log(("zPRIO #%d فتح(%s) — علّقنا التسليم: الدروب أول لين ينأخذ أو يختفي أو +%d نقطة"):format(
    DP.n, tostring(why), math.floor(tonumber(CFG.DROP_GOAL) or 100)))
  return true
end
-- «يفتح إذا فيه دروب حي فعلًا» — ما يفتح النافذة على فراغ فيوقف التسليم بلا سبب
DP.want = function(why)
  if DP.on then return true end
  if not (CFG.DROP_FIRST and DROP_ON and isRunning) then return false end
  -- (46) ضدّ التحير: الطور مقفول على التسليم (FLIP) أو الدروب مرفوع مؤقتًا (strikes) = ما نفتح فوقه
  if tick() < FLIP.lockUntil then return false end
  if tick() < DP.lockUntil then return false end
  DP.lastScan = tick()
  DP.live = DP.count()
  if DP.live > 0 then return DP.open(why) end
  return false
end
DP.close = function(why)
  if not DP.on then return end
  DP.on = false
  local gained = pts() - DP.pts0
  log(("zPRIO #%d إغلاق(%s) — +%d نقطة في %.0fث: نرجع للتسليم"):format(
    DP.n, tostring(why), gained, tick() - DP.since))
  -- (46) نافذة ما جابت ولا نقطة = فشل. ورا بعض نافذتين فاشلتين نرفع الدروب 40ث:
  -- هذا بالضبط «يدور ويعلق» اللي شكت منه — الدروب حي بس ما ينأخذ (وراء سياج/على سقف).
  if gained > 0 then
    DP.strikes = 0
  elseif tick() - DP.since >= (tonumber(CFG.DROP_GIVEUP) or 10) then
    DP.strikes = DP.strikes + 1
    if DP.strikes >= 2 then
      DP.strikes, DP.lockUntil = 0, tick() + (tonumber(CFG.DROP_LOCKT) or 40)
      log(("zPRIO strikes — نافذتين بلا غنيمة: نعلّق أولوية الدروب %dث والتسليم يخلص شغله"):format(
        tonumber(CFG.DROP_LOCKT) or 40))
    end
  end
end
DP.check = function()
  if not DROP_ON or not isRunning then return DP.close("off") end
  if not DP.on then
    DP.want("مسح")
    return
  end
  local gained = pts() - DP.pts0
  if gained >= (tonumber(CFG.DROP_GOAL) or 100) then return DP.close("وصلت الهدف") end
  if tick() - DP.since > (tonumber(CFG.DROP_WINDOW) or 30) then return DP.close("سقف الوقت") end
  if tick() - DP.lastScan >= 2 then
    DP.lastScan = tick()
    DP.live = DP.count()
    if DP.live == 0 then return DP.close("الدروب اختفت") end
  end
end

-- طور الدروب: نفس الكنس الواسع + اللف المحلي، بس بسقفين — عادي (12ث) أو أولوية (30ث/حتى تقفل النافذة)
local function dropPhase(capSecs, prio)
  local t = tick()
  local gotAny, sawAny = false, false
  -- (46) سقف إحباط: أولوية مفتوحة بلا أي غنيمة بهالثواني = نطلع منها. الدروب اللي وراء سياج
  -- كان يخلي النافذة مفتوحة 30ث وكل دورة تعيد نفس الدورة — «يتحير بين المهمة والدروب» بعينه.
  local giveUpAt = t + (prio and math.min(capSecs, tonumber(CFG.DROP_GIVEUP) or 10) or capSecs)
  if prio then pcall(function() StatusText.Text = "🎁 أولوية الدروب..." end) end
  if not crateBusy then gotAny = tryDrop(CFG.DROP_SCAN) and true or false end
  while isRunning and DROP_ON and (tick() - t < capSecs) and (not prio or DP.on) do
    if crateBusy then break end   -- القفل الجوي يشتغل لحاله، ما نجلس نكرر الفحص فوقه
    local got, any = tryDrop()
    if any then sawAny = true end
    if got then gotAny = true break end
    -- ما فيه دروب قريب أصلًا: نكمل شغلنا بدل ما نقف ننتظر شي ما جاي
    if not any then break end
    if tick() >= giveUpAt then
      log(("zDROP give-up %.0fث بلا غنيمة — نخلّص التسليم، والدروب المحيّل ما يوقفنا"):format(tick() - t))
      break
    end
    task.wait(0.6)
  end
  log(("zDROP phase=%.1fs got=%s saw=%s flips=%d prio=%s"):format(
    tick() - t, tostring(gotAny), tostring(sawAny), FLIP.n, tostring(prio)))
  if gotAny then DP.lastScan = tick() + 1.5 end   -- اللي انأخذ مو «حي»: نمنع فحص يخلي النافذة مفتوحة
  if not gotAny and sawAny then noteFlip("phase-no-pickup") end
  return gotAny
end

-- ═══════════ الكول داون (رقمك الحي: 8 ثوانٍ بالضبط بعد إنهاء المهمة) ═══════════
-- المشكلة اللي شفتها بسجلّك: بعد الضغط على بارد ما تنشط أي نقطة تسليم، فالسكربت كان
-- يروح للتخمين (HoveringText على ارتفاع 1540) يمشي 4 ثوانٍ ويرجع. هنا: ما نمشي إلا على نقطة حية.
local chestCdUntil = 0

-- نستنى نقطة التسليم تنشط، وبانتظارنا نصيد أي دروب (ما نضيّع الثواني واقفين)
local function waitActiveEnd(limit)
  local t0 = tick()
  while isRunning and not RUN.dead and DELIV_ON and (tick() - t0 < limit) do
    local pos, part, why = activeEnd()
    if pos then return pos, part, why, tick() - t0 end
    if DROP_ON and not crateBusy then tryDrop() end
    if not isRunning then break end
    task.wait(0.4)
  end
  return nil, nil, "timeout", tick() - t0
end

-- ═══════════ v2f: الميزات المشروعة من قائمته (الباقي تجاوز حماية — مرفوض، مذكور بالرد) ═══════════
-- (أ) إضاءة كاملة: كانت تعديل Lighting محلي — (49) انشلت من الواجهة ومن الكود
-- (ب) حفظ/استرجاع الإعدادات بملف — لو المنفذ ما يدعم writefile نقول ونسكت
-- (ج) تنبيه كلمات الشات: قراءة فقط، ما نرد ولا نمسح
-- (د) لو اللعبة كلبتك/سجنتك: نوقف ونستنى تخلص — ما نفك قيد ولا نهرب من زنزانة

local function cfgText()
  local parts = {}
  for k, v in pairs(CFG) do
    local t = type(v)
    if t == "boolean" or t == "number" then
      parts[#parts + 1] = string.format('"%s":%s', k, tostring(v))
    end
  end
  table.sort(parts)
  return "{" .. table.concat(parts, ",") .. "}"
end
local function saveCfg()
  local ok, err = pcall(function()
    if typeof(makefolder) ~= "function" or typeof(writefile) ~= "function" or typeof(isfolder) ~= "function" then
      error("no-file-api")
    end
    if not isfolder("RavenFarm") then makefolder("RavenFarm") end
    writefile(CFG.CFG_FILE, cfgText())
  end)
  if ok then log("zCFG saved -> " .. CFG.CFG_FILE)
  else log("zCFG save-fail " .. tostring(err) .. " — منفذك ما يدعم ملفات الـworkspace") end
  return ok
end
local function loadCfg()
  local n = 0
  local ok, err = pcall(function()
    if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" then error("no-file-api") end
    if not isfile(CFG.CFG_FILE) then error("no-file") end
    local s = readfile(CFG.CFG_FILE)
    for k, v in s:gmatch('"([%w_]+)":([%w%.%-%+]+)') do
      if CFG[k] ~= nil then
        if v == "true" then
          CFG[k] = true; n = n + 1
        elseif v == "false" then
          CFG[k] = false; n = n + 1
        else
          local num = tonumber(v)
          if num then CFG[k] = num; n = n + 1 end
        end
      end
    end
  end)
  log(("zCFG load ok=%s n=%d %s"):format(tostring(ok), n, (not ok and tostring(err)) or ""))
  return ok and n > 0
end

local CHAT_WORDS = { "هاك", "هاكر", "هكر", "تبليغ", "ابلاغ", "مبلغ", "مشرف", "استاف",
  "hack", "hacker", "cheat", "report", "exploit", "admin", "staff" }
local chatLast = 0
local function chatScan(txt)
  if not CFG.CHAT_ALERT or type(txt) ~= "string" or txt == "" then return end
  local hay = string.lower(txt)
  for _, w in ipairs(CHAT_WORDS) do
    if string.find(hay, w, 1, true) then
      if tick() - chatLast > 5 then
        chatLast = tick()
        log(("zCHAT كلمة=%s نص=%s — أحد يتكلم عنك، خذ بالك (قراءة فقط)"):format(
          asc(w), asc(txt):sub(1, 70)))
        pcall(function() StatusText.Text = "تنبيه شات" end)
      end
      return
    end
  end
end
task.spawn(function()
