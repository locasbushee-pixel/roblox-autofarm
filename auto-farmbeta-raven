-- نقاط التسليم الثلاث = Workspace.DeliveryCrates.CratesEndPoints
-- (كل جزء MeshPart 34×4.37×34، CanCollide=false، Transparency=1 — يلمسها السيرفر للتسليم)
-- نقطة الاستلام = Workspace.DeliveryCrates.CratesStarter.TakeChest (برومبت «اخذ صندوق»، HoldDuration=0، MaxDistance=10)
local ENDS = {
  { n = "CratesEndPoint1", p = Vector3.new(-87.97,  68.72, -2711.59) },
  { n = "CratesEndPoint2", p = Vector3.new( 362.85, 69.08, -2792.40) },
  { n = "CratesEndPoint3", p = Vector3.new(-394.78, 68.98, -2657.67) },
}
local CHEST_POS = Vector3.new(-36.28, 74.17, -3082.30)
local function nearestEnd(fromPos)
  local best, bd = nil, math.huge
  for _, e in ipairs(ENDS) do
    local d = (e.p - fromPos).Magnitude
    if d < bd then best, bd = e, d end
  end
  return best, bd
end

