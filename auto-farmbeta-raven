end
-- "block" = ما نلمسه أبدًا | "drop" = نصه يقول صندوق/دروب | "fresh" = طلع بعد الكنس (دروب حي) | "other"
local function classify(info)
  local low = (info.raw or ""):lower()
  local pth = info.path or ""
  -- الشراء/الكلبش/الانتقال مرفوضة دائمًا — «صندوق» يمكن تظهر بنص متجر
  if anyIn(low, BLOCK_HARD) or anyIn(pth, BLOCK_PATHS) then return "block" end
  local w = anyIn(low, DROP_WORDS)
  if w then return "drop", w end
  if anyIn(low, BLOCK_SOFT) then return "block" end
  if anyIn(pth, DROP_PATHS) then return "drop", "path" end
  if info.freshAt and info.freshAt > 0 and (tick() - info.freshAt) <= CFG.DROP_FRESH then
    return "fresh", "new"
  end
  return "other"
end
