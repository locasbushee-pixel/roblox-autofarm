do
  -- ═══ مكوّنات ═══
  local function round(inst, r)
    pcall(function()
      local c = Instance.new("UICorner")
      c.CornerRadius = UDim.new(0, r or 8)
      c.Parent = inst
    end)
  end
  local function stroke(inst, col, t)
    pcall(function()
      local s = Instance.new("UIStroke")
      s.Color = col
      s.Thickness = t or 1.2
      s.Transparency = 0.25
      s.Parent = inst
    end)
  end
  -- تدرّج ثابت لعنصر لا يغيّر لونه (شريط العنوان). ما نركّبه على زر حالته بالون:
  -- UIGradient يدهس BackgroundColor3، فزر «شغّال/مطفي» يفقد دلالته لو حطّينا عليه واحد.
  local function grad(inst, c1, c2, rot)
    pcall(function()
      local g = Instance.new("UIGradient")
      g.Color = ColorSequence.new(c1, c2)
      g.Rotation = rot or 0
      g.Parent = inst
    end)
  end
  -- تسجيل عنصر في قائمة التحجيم (x/y داخل أبوه، بالـ coordinates التصميمية)
  local function place(inst, x, y, w, h, ts)
    REG.layout[#REG.layout + 1] = { i = inst, x = x, y = y, w = w, h = h, ts = ts }
    return inst
  end

  local function uiBtn(parent, x, y, w, h, col, txt, name, ts)
    local b = Instance.new("TextButton")
    b.Name = name or "Btn"
    b.BackgroundColor3 = col
    b.Font = Enum.Font.GothamBold
    b.Text = txt
    b.TextColor3 = COL.WHITE
    b.TextSize = ts or 12
    b.AutoButtonColor = true
    b.BorderSizePixel = 0
    b.Parent = parent
    place(b, x, y, w, h, ts or 12)
    round(b, 8)
    -- ردّ فعل المؤشر بالشفافية فقط، مو باللون: setOn هو صاحب اللون (on/off)، ولو نافسناه
    -- بلون ثاني تصير الحالة تُقرأ من مصدرين يختلفون. الجوال ياخذ نفس التأثير بالدوس.
    b.MouseEnter:Connect(function() pcall(function() b.BackgroundTransparency = 0.16 end) end)
    b.MouseLeave:Connect(function() pcall(function() b.BackgroundTransparency = 0 end) end)
    return b
  end
  -- زر حالة: نقطة على اليسار + نص «: on/off» — الحالة مُرمّزة مرتين (لون + كلام)،
  -- لأن التمييز بالون وحده ما يفيد أحد (قاعدة color-not-only)
  local function uiTgl(parent, x, y, w, h, on, txt, name, onCol, ts)
    local b = uiBtn(parent, x, y, w, h, on and (onCol or COL.ON) or COL.OFF,
      txt .. ": " .. (on and "on" or "off"), name, ts)
    local d = Instance.new("Frame")
    d.BackgroundColor3 = on and COL.DOT_ON or COL.DOT_OFF
    d.BorderSizePixel = 0
    d.Parent = b
    place(d, 11, (h - 9) / 2, 9, 9)
    pcall(function()
      local c = Instance.new("UICorner")
      c.CornerRadius = UDim.new(1, 0)
      c.Parent = d
    end)
    REG.dots[b] = d
    return b
  end
  -- align: الشروح العربية تُحاذي اليمين (قرب مربع الرقم = تجميع صحيح)، والقراءات يسار
  local function uiLbl(parent, x, y, w, txt, size, col, bold, align, h)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.Text = txt
    l.TextColor3 = col or COL.CAP
    l.TextSize = size or 11
    l.TextXAlignment = (align == "left") and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
    l.BorderSizePixel = 0
    l.Parent = parent
    place(l, x, y, w, h or 20, size or 11)
    return l
  end
  -- مربع رقم مربوط بمفتاح CFG (مو بنسخة القيمة وقت الإنشاء):
  -- قبل، «استرجاع المحفوظ» كان يحمّل CFG وتبقى الصناديق تعرض أرقام الإقلاع.
  local function uiNum(parent, x, y, w, h, key, onApply)
    local box = Instance.new("TextBox")
    box.BackgroundColor3 = COL.PANEL
    box.BorderSizePixel = 0
    box.Font = Enum.Font.Code            -- أرقام بعرض ثابت = ما تنزح السطور
    box.TextColor3 = COL.NUM
    box.TextSize = 12
    box.Text = tostring(CFG[key])
    box.ClearTextOnFocus = false
    box.Parent = parent
    place(box, x, y, w, h, 12)
    round(box, 6)
    stroke(box, COL.LINE)
    box.FocusLost:Connect(function(entered)
      local n = tonumber(box.Text)
      if entered and n then box.Text = tostring(onApply(n)) else box.Text = tostring(CFG[key]) end
    end)
    REG.nums[#REG.nums + 1] = { box = box, key = key }
    return box
  end
  syncNumBoxes = function()
    for _, e in ipairs(REG.nums) do
      pcall(function() e.box.Text = tostring(CFG[e.key]) end)
    end
  end
  -- سطر حقل: شرح يمين + صندوق على طرفه (نفس الإيقاع في كل الأقسام)
  local function uiField(parent, x, y, lab, key, onApply, boxName)
    uiLbl(parent, x, y, 186, lab, 11, COL.CAP)
    local b = uiNum(parent, x + 194, y, 74, 22, key, onApply)
    if boxName then UI[boxName] = b end
    return b
  end

  -- ═══ النافذة ═══
