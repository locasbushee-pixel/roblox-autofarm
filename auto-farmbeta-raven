-- (47) نقطة اقتراب، مو مركز الهدف: مركز الصندوق جوه الحاجز — لو مشيناه له بالضبط الشخصية
-- تدفع الحائط وتوقف، وهذا عین «يمشي ويوقف» و«واقف جنب الدروب وما يروح له». نوقف على
-- ~نصف مدى الإمساك، وأفقيًا بس عشان ارتفاع الصندوق ما يخلّينا نطعّط فوقه.
DEF.approach = function(fromPos, hostPos, reach)
  local vx, vz = hostPos.X - fromPos.X, hostPos.Z - fromPos.Z
  local vm = math.sqrt(vx * vx + vz * vz)
  local keep = math.max(2, (tonumber(reach) or 8) * 0.55)
  if vm <= keep + 0.5 then return hostPos end
  return fromPos + Vector3.new(vx, 0, vz) * ((vm - keep) / vm)
end
