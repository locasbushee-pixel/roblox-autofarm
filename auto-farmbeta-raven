  -- ═══ التحجيم حسب الشاشة (يحلّ محل clampIntoScreen) ═══
  -- جوال/لمس = نفس النافذة أكبر شوي، ومربعات الأرقام ما تصير أصغر من 20px
  local touchOn = false
  pcall(function() touchOn = UserInputService.TouchEnabled end)
  REG.maxSc = touchOn and 1.05 or 1.0
  local dragging = false   -- (48) الاسم الصح: معَالج السحب كان يكتب dragging
                           -- وهو متغيّر عام ثاني، فما يعرف أحد أنه ان سحب
  local function applyLayout()
    pcall(function()
      local vp = ScreenGui.AbsoluteSize
      local fit = math.min((vp.X - 16) / REG.w, (vp.Y - 16) / REG.h)
      local k = math.max(0.55, math.min(REG.maxSc, fit))
      REG.sc = k
      REG.lh = math.max(12, math.floor(16 * k + 0.5))
      MainFrame.Size = UDim2.fromOffset(math.floor(REG.w * k), math.floor(REG.h * k))
      for _, e in ipairs(REG.layout) do
        e.i.Size = UDim2.fromOffset(math.floor(e.w * k + 0.5), math.floor(e.h * k + 0.5))
        e.i.Position = UDim2.fromOffset(math.floor(e.x * k + 0.5), math.floor(e.y * k + 0.5))
        if e.ts then
          local ts = math.max(9, math.floor(e.ts * k + 0.5))
          if touchOn then ts = math.max(11, ts) end
          pcall(function() e.i.TextSize = ts end)
        end
      end
      if not dragging then
        MainFrame.Position = UDim2.fromOffset(
          math.floor((vp.X - REG.w * k) / 2), math.max(4, math.floor((vp.Y - REG.h * k) / 2)))
      else
        -- ما تطلع النافذة عن الشاشة بعد السحب (بصورتك كانت مقطعة على اليسار)
        local px, py = MainFrame.AbsolutePosition.X, MainFrame.AbsolutePosition.Y
        MainFrame.Position = UDim2.new(0,
          math.max(4, math.min(vp.X - REG.w * k - 4, px)), 0,
          math.max(4, math.min(vp.Y - REG.h * k - 4, py)))
      end
    end)
  end

  showTab("drop")
  applyLayout()
  task.delay(0.15, applyLayout)
  pcall(function()
    conn(Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyLayout))
  end)

