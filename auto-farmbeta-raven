-- ═══ الموت: السكربت يوقف، ما يكمّل على الشخصية الجديدة (شكوى المنشور) ═══
-- قبل: ما كان فيه أي ربط على Humanoid.Died. المشية كانت تنقطع لأن rootOf() تصير nil،
-- وبعدها الدورة تمشي وتضغط E على الشخصية الجديدة وأنت تظن إن السكربت وقف.
-- الحين: Died = نفك الإمساك + نفرّغ قفل الدروب + RUN.dead يوقّف كل حلقات الحركة.
--   DEATH_STOP=on  → نوقف الفرم بالكامل وتدوس تشغيل بنفسك (افتراضي، وهو اللي الناس اشتكوه)
--   DEATH_STOP=off → نستنى ترجع وكمّل (سلوك قديم، صار صريح)
--   بعد DEATH_MAX موتات بالجلسة → وقف دائمًا: دورة موت لازم تُقرأ بالسجل، مو تُكمَّل
local function onDied()
  if RUN.dead then return end
  RUN.dead = true
  RUN.diedN = RUN.diedN + 1
  RUN.diedAt = tick()
  local ctx = string.format("crate=%s mission=%s tp=%d ws=%d",
    tostring(crateBusy), tostring(MISSION_HOT), tpCount, math.floor(SPD.ws + 0.5))
  releaseHold(nil, nil)
  crateBusy, crateBusySince = false, 0
  tpCount = 0
  log(("zDEATH #%d %s — وقّفنا الحركة والإمساك (طايح)"):format(RUN.diedN, ctx))
  local loop = RUN.diedN >= math.max(1, tonumber(CFG.DEATH_MAX) or 3)
  if CFG.DEATH_STOP or loop then
    isRunning = false
    halt()
    log(loop and ("zDEATH loop — %d موتات بالجلسة: وقّفنا نهائي، افتح السجل فيه سبب كل واحدة"):format(RUN.diedN)
      or "zDEATH stop — DEATH_STOP=on: ما نكمّل إلا بعد ما تدوس تشغيل")
    pcall(function()
      StatusText.Text = loop and ("متوقف — %d موتات"):format(RUN.diedN) or "متوقف — مُت"
      StatusText.TextColor3 = COL.WARN
      ToggleBtn.Text = "تشغيل"
      ToggleBtn.BackgroundColor3 = COL.ACCENT
      UI.DeathLbl.Text = string.format("موتات الجلسة: %d  |  آخر موتة: %s",
        RUN.diedN, os.date("%H:%M:%S", math.floor(RUN.diedAt)))
    end)
    refreshBtns()
  else
    pcall(function()
      StatusText.Text = "ميت — نستنى إعادة الظهور"
      StatusText.TextColor3 = COL.WARN
      UI.DeathLbl.Text = string.format("موتات الجلسة: %d  |  آخر موتة: %s",
        RUN.diedN, os.date("%H:%M:%S", math.floor(RUN.diedAt)))
    end)
  end
end
local function bindDeath(char)
  task.spawn(function()
    local h = nil
    pcall(function() h = char and char:WaitForChild("Humanoid", 10) end)
    if not h or not ALIVE or h == RUN.hum then return end
    RUN.hum = h
    if RUN.humConn then pcall(function() RUN.humConn:Disconnect() end) end
    RUN.humConn = conn(h.Died:Connect(onDied))
  end)
end
pcall(function() bindDeath(lp.Character) end)
pcall(function() conn(lp.CharacterAdded:Connect(bindDeath)) end)

-- ═══ عدّاد السرعة (قراءة — الكتابة الوحيدة في السكربت هي زر «سرعة ثابتة» تحت) ═══
-- نقيس من موقعك كل نص ثانية، ونقارن بالرقم اللي كاتبته اللعبة حقك.
-- كشفك الحي: أساس سرعتك 65، وأنت تقول اللعبة تنزّلها لـ16 وقت المهمة — هنا بنشوف اللحظة بالضبط (zSPD)
task.spawn(function()
  local lastP, lastT, ema = nil, 0, 0
  while ALIVE do
    task.wait(0.5)
    -- عدنا نغيّر «السرعة المثبّتة» من مربع الرقم: نطلّع اسم الزر (المربع ما يقدر ينادي
    -- refreshBtns — معرّف تحت، وبلوك الواجهة فوق = كان يطلع global nil ويسكّت FocusLost)
    if SPD.lockDirty then SPD.lockDirty = false; refreshBtns() end
    if TP.btnDirty then TP.btnDirty = false; refreshBtns() end
    -- (43) نافذة أولوية الدروب: تفتح نفسها أول ما ينزل دروب، وتسكر على الأخذ/الاختفاء/الهدف/السقف
    pcall(DP.check)
    local r, hum = rootOf()
    if r and hum then
      local p = r.Position
      if lastP then
        local dx, dz = p.X - lastP.X, p.Z - lastP.Z
        local dt = tick() - lastT
        if dt > 0.05 then
          local v = math.sqrt(dx * dx + dz * dz) / dt
          if v < 120 then   -- قفرة مطاطية/سقوط مو سرعة: ما تدخل بالمتوسط ولا بالقمّة
            ema = (ema == 0) and v or (ema * 0.55 + v * 0.45)
            if ema > SPD.peak then SPD.peak = ema end
            if v > 0.4 then SPD.sum, SPD.n = SPD.sum + v, SPD.n + 1 end
            SPD.now = ema
          end
        end
      end
      lastP, lastT = p, tick()
      local okW, wsv = pcall(function() return hum.WalkSpeed end)
      if okW and tonumber(wsv) then
        wsv = tonumber(wsv)
        -- الأساس ما نرفعه وقت ما اللعبة مخفّضتنا (وإلا يصير «أساسك 24» ويضيع كشف التخفيض)
        if wsv > SPD.wsBase and not SPD.miss then SPD.wsBase = wsv end
        if SPD.wsMin == 0 or (wsv > 0 and wsv < SPD.wsMin) then SPD.wsMin = wsv end
        if math.abs(wsv - SPD.ws) > 0.5 then
          local prev = SPD.ws
          SPD.ws = wsv
          -- مع «سرعة ثابتة» الشغّالة: ما نسمّيها مخاطرة — التخفيض اللي بيننا وبين الماب
          -- صايمناه نحن (zSPEEDLOCK)، فـ miss كان يكذب ويصبّر شريط السرعة بالبرتقالي
          SPD.miss = (not CFG.SPD_LOCK) and (
              (prev > 0 and wsv < prev * CFG.SLOW_FRAC)
              or (wsv <= CFG.LIVE_WS and SPD.wsBase >= 40))
          if prev > 0 and (tick() - SPD.wsLog) > 1.5 then
            SPD.wsLog = tick()
            -- هل التخفيض وقت مهمة حقيقية ولا اللعبة ناسية ترجّعك؟ نفحص بالنقطة الحية، ما نخمن
            local live, proof = false, "?"
            pcall(function() live, proof = missionLive() end)
            log(("zSPD walkSpeed %d -> %d top=%d low=%d liveMission=%s proof=%s lock=%s %s"):format(
              math.floor(prev), math.floor(wsv), math.floor(SPD.wsBase), math.floor(SPD.wsMin),
              tostring(live), tostring(proof), tostring(CFG.SPD_LOCK),
              SPD.miss and "— اللعبة مخفّضتك الحين"
                or (CFG.SPD_LOCK and "— «سرعة ثابتة» رجّعتها للتثبيت" or "— سرعتك رجعت")))
          end
        end
      end
      local avg = (SPD.n > 0) and (SPD.sum / SPD.n) or 0
      -- JUMP_COUNT: كل 100 متر مشي فعلي نقول كم قفزة احتجناها وكم وفّر التقطيع.
      -- الهدف رقم مو كلام: لو القفزات/100م طاحت والتقطيع زاد = القسم يشتغل، وإلا نقول.
      if CFG.JUMP_COUNT and JMP.meters >= 100 then
        local curb = SU.hops - (JMP.hops0 or 0)
        local cuts = LOS.cuts - (JMP.cuts0 or 0)
        local saved = LOS.saved - (JMP.saved0 or 0)
        local tot = JMP.n + curb
        log(("zMOVE 100m jumps=%d (path=%d curb=%d) per100m=%.1f | losCuts=%d saved=%.0fm | spd=%.1f ws=%d | pad use=%d refuse=%d"):format(
          tot, JMP.n, curb, tot * 100 / math.max(1, JMP.meters), cuts, saved,
          SPD.now, math.floor(SPD.ws + 0.5), PADST.uses, PADST.refused))
        JMP.meters, JMP.hops0, JMP.cuts0, JMP.saved0, JMP.since = 0, SU.hops, LOS.cuts, LOS.saved, tick()
      end
      pcall(function()
        SpeedText.Text = string.format("%.0f م/ث", SPD.now)
        SpeedText.TextColor3 = SPD.miss and Color3.fromRGB(255, 205, 120) or Color3.fromRGB(255, 255, 255)
        UI.SpeedLbl.Text = string.format("السرعة الآن: %.1f  |  قمّة: %.1f  |  WS: %d  |  تثبيت: %s  |  مطاطيات: %d",
          SPD.now, SPD.peak, math.floor(SPD.ws + 0.5),
          CFG.SPD_LOCK and tostring(math.floor((tonumber(CFG.SPD_LOCK_WS) or 32) + 0.5)) or "مطفي",
          rubberHits)
        UI.MovLbl.Text = string.format(
          "تقطيع %d (وفّر %.0f م) | قفزات مسار %d | طلعات رادّة %d | نقل %d/%d | مشي %d م",
          LOS.cuts, LOS.saved, JMP.n, SU.hops, PADST.uses, PADST.uses + PADST.refused, math.floor(JMP.meters))
        UI.DropLbl.Text = string.format(
          "دروب %d | مقاطعات محجوزة %d | مهملة %d | تبديلات %d/%d | %s",
          dropOK, HUNT.skips, HUNT.fails or 0, FLIP.n, CFG.FLIP_MAX,
          DP.on
            and ("نافذة دروب مفتوحة " .. math.floor(tick() - DP.since) .. "ث (+" .. math.floor(pts() - DP.pts0)
                 .. " نقطة) — التسليم مستني")
            or ((tick() < FLIP.lockUntil)
              and ("مقفل على التسليم " .. math.floor(FLIP.lockUntil - tick()) .. "ث")
              or (MISSION_HOT and "حاملين مهمة — التسليم يكسب" or "فاضي — الدروب يكسب")))
        UI.SpdLbl.Text = string.format("أعلى WS %d  |  الحين %d  |  أقل %d  |  متوسط %.1f  |  %s",
          math.floor(SPD.wsBase + 0.5), math.floor(SPD.ws + 0.5), math.floor(SPD.wsMin + 0.5), avg,
          CFG.SPD_LOCK
            and ("«سرعة ثابتة» شغّالة — أثبتنا " .. SPD.lockFix .. " مرة (كتابة WalkSpeed)")
            or ((SPD.ws > 0 and SPD.ws <= CFG.LIVE_WS)
              and "وضع «مشي» — زر الركض حق اللعبة: " .. (CFG.RUN_BTN and "نشغّله" or "مطفي")
              or "وضع «ركض»"))
      end)
    end
  end
end)

-- ═══ مراقب «سرعة ثابتة» (طلب locas) ═══
-- يعمل على ALIVE مو isRunning: طلبك «تبقى 32 لين السكربت ينطفي» = حتى والدورة مبطلة.
-- bindSpeedLock يغطّي respawn (Humanoid جديد)، وlockSpeedNow يغطّي أي قيمة غيّرتها الماب.
task.spawn(function()
  while ALIVE do
    task.wait(0.4)
    if CFG.SPD_LOCK then
      if not SPD.lockHum then
        engageSpeedLock()
      else
        bindSpeedLock()
        lockSpeedNow("watch")
      end
    end
  end
end)

-- زر «مشي/ركض» الخاص باللعبة: لو رجّعتك الماب لوضع المشي (WS 16 عندك) ندوس زر الركض حقها.
-- ما نكتب Humanoid.WalkSpeed — هذا الزر اللي الماب يعرضه لكل لاعب والسيرفر يثق فيه.
task.spawn(function()
  while ALIVE do
    task.wait(1.2)
    -- لو «سرعة ثابتة» شغّالة: ما ننافسها — زر الماب يطلعك 24 والتثبيت يرجّعه لرقمك = اهتزاز
    if isRunning and CFG.RUN_BTN and not CFG.SPD_LOCK and not holding and not crateBusy
       and SPD.ws > 0 and SPD.ws <= CFG.RUN_AT and (tick() - runAt) >= CFG.RUN_GAP then
      -- نستدعي pressRunButton مباشرة: كل خطوة داخلها مغلّفة بـ pcall أصلًا.
      -- لو غلّفناها بـ pcall من برا، المشغّلات القديمة ترمي «yield across C-call boundary»
      -- لأن الدالة تستنى (task.wait) بعد الضغطة — وهذا يوقف مراقب الركض للأبد.
      local ok = pressRunButton("watch")
      if not ok then log("zRUN watch-no-effect") end
    end
  end
end)

-- حارس crateBusy: القفل يشتغل بثريد منفصل، ولو طلع منه خطأ كان crateBusy يبقى true للأبد
-- = كشف الدروب ينطفي لبقية الجلسة (شكواك «الدروب معطوب»). نفكه ونقول لك.
task.spawn(function()
  while ALIVE do
    task.wait(5)
    if crateBusy and crateBusySince > 0 and (tick() - crateBusySince) > CFG.BUSY_MAX then
      crateBusy = false
      log(("zDROP busy-stale %.0fث — القفل علق، فككناه الحين عشان كشف الدروب ما يموت"):format(
        tick() - crateBusySince))
    end
  end
end)

-- ═══════════ (29-35) «الدفاع» + «انتقل لصديق» ═══════════
-- القاعدة: كل حارس يقرر من قراءتك أنت — Humanoid:GetState()، صحتك، موقعك، قيود الماب.
-- ولا واحد يرسم على لاعب ثاني ولا يقرأ صحته/رتبته/مسافته («مرفوض» برأس الملف)، ولا واحد
-- يفكّ قيد أو يمنع ضرر — شغلهم يوقفون السكربت عنك، وأنت اللي تتصرّف.
-- كل شي داخل do/end: السكربت chunk واحد وسقف Luau 200 متغيّر محلي فعّال. الدوال تُخزّن في
-- DEF (معرّف فوق مع RUN) وتبقى شغّالة كـ upvalues بعد ما يطلع البلوك من العد.
do
  local function panic(why)
    if not ALIVE then return end
    isRunning = false
    RUN.id = RUN.id + 1          -- أي مشية/دورة شغالة تُبطل نفسها عند أول فحص
    releaseHold(nil, nil)
    halt()
    crateBusy, crateBusySince = false, 0
    tpCount = 0
    DEF.panicN = DEF.panicN + 1
    log(("zPANIC #%d (%s) — دورة موقوفة + إمساك مفكّ + قفل دروب فارغ. «سرعة ثابتة» ما نلمسها إلا بزرّها"):format(
      DEF.panicN, asc(tostring(why))))
    pcall(function()
      StatusText.Text = "🛑 إيقاف فوري"
      StatusText.TextColor3 = COL.WARN
    end)
    refreshBtns()
  end
  DEF.panic = panic

  -- F7: الطوارئ لازم توصلك وأنت ما فتح الواجهة. gpe = الشات/اللعبة آخذين الكيبورد = ما نلخبط
  pcall(function()
    conn(UserInputService.InputBegan:Connect(function(inp, gpe)
      if CFG.PANIC_KEY and not gpe and inp.KeyCode == Enum.KeyCode.F7 then panic("F7") end
    end))
  end)
  log("zPANIC F7 bound — ضغطة وحدة توقف كل شي (تُلغى من زر «زر F7 للطوارئ»)")

  -- (30-32) فحص الحالة الموحد: يناديه المشي (كل 0.5ث) والمراقب تحت، بنفس الصاعة
  function DEF.probe(p, hum)
    DEF.stopWalk = false
    local now = tick()
    local why = heldByGame()   -- WS=0 / PlatformStand / Ragdoll / Physics / Dead / سجن / (ربط خارجي لو فتحته)
    -- (47) «Physics» و«FallingDown» حالتَي لمسة: تصير كل ما خبطت صندوق أو دفعك لاعب أو طلعت
    -- على حافة — وهي سبب العرجة: المشية كانت توقف نفسها وترجع كل نص ثانية وأنت تمشي طبيعي.
    -- القيد الحقيقي (كلبشة/WS=0/سجن/Ragdoll/ميت) يبقى فوري، واللمسة لازم تدوم CFG.HELD_MS.
    if why and (why == "Physics" or why == "FallingDown") then
      if DEF.trWhy ~= why then DEF.trWhy, DEF.trAt = why, now end
      if now - DEF.trAt < math.max(0.3, tonumber(CFG.HELD_MS) or 1) then why = nil end
    else
      DEF.trWhy, DEF.trAt = "", 0
    end
    if why then
      if DEF.heldWhy == "" then
        DEF.heldN, DEF.heldSince = DEF.heldN + 1, now
        if isRunning then
          log(("zFREEZE #%d %s — أنت مقيّد: ما ندفع شخصية مربوطة ولا نكمّل إمساك"):format(DEF.heldN, asc(why)))
        end
      end
      DEF.heldWhy = why
      if CFG.FREEZE_HELD then DEF.stopWalk = true end
    elseif DEF.heldWhy ~= "" then
      if isRunning then
        log(("zFREEZE off — تحرّرت بعد %.0fث (%s) — دوس تشغيل إذا تبغى نكمّل"):format(
          now - DEF.heldSince, asc(DEF.heldWhy)))
      end
      DEF.heldWhy = ""
    end
    -- آخر أرض وقفناها بثبات = نقطة الإرجاع (نفس الارتفاع بين عينتين، وما إحنا في سقوط/كربجة)
    local st = nil
    pcall(function() st = hum and hum.GetState and hum:GetState() end)
    local falling = (st == Enum.HumanoidStateType.Freefall) or (st == Enum.HumanoidStateType.FallingDown)
    if not falling and DEF.lastY > -900 and math.abs(p.Y - DEF.lastY) < 1.2 then
      DEF.groundY = p.Y
      if now - DEF.safeAt > 3 then
        DEF.safeAt, DEF.safePos = now, Vector3.new(p.X, p.Y, p.Z)
      end
    end
    DEF.lastY = p.Y
    if falling then
      -- (32) طايح تحت آخر أرض بـ VOID_DROP متر = مشي/إمساك ما له معنى: نوقف. ما نطفي القيد
      if (DEF.groundY - p.Y) >= tonumber(CFG.VOID_DROP) then
        if isRunning and (now - DEF.voidAt) > 12 and CFG.VOID_GUARD then
          DEF.voidAt, DEF.voidJust, DEF.voidN = now, true, DEF.voidN + 1
          log(("zVOID #%d y=%.0f تحت آخر أرض بـ%.0fم — وقّفنا المشي والإمساك (أنت طايح)"):format(
            DEF.voidN, p.Y, DEF.groundY - p.Y))
          releaseHold(nil, nil)
          halt()
          DEF.stopWalk = true
          -- (46) ما نطفي السكربت: راحة 6ث تقطع اندفاع المشية، وبعدها نكمّل (والإرجاع لو فعّلت النقل)
          RUN.restUntil = tick() + 6
        end
      end
    end
  end

  -- الإرجاع لمكانك الآمن = كتابة CFrame، فلا تسوي شي من نفسك: تحتاج «انتقال وقت الضرورة» أو «هرب بالانتقال»
  function DEF.consume()
    if not DEF.voidJust then return end
    DEF.voidJust = false
    if not (CFG.AUTO_TP or CFG.ESC_TP) or not DEF.safePos then
      log("zVOID — ما رجّعناك لآخر أرض: «انتقال وقت الضرورة» و«هرب بالانتقال» مطفيين (أو ما سجلنا أرض آمنة بعد)")
      return
    end
    local ok = autoTp(DEF.safePos, "void-rescue")
    log(("zVOID rescue -> آخر أرض y=%.0f ok=%s"):format(DEF.safePos.Y, tostring(ok)))
  end

  -- (31) حارس الاشتباك: نافذة PVP_WIN ثانية ونزول ≥ PVP_DROP نقطة = رصاص عليك، مو farming وقتل
  function DEF.combat(hum)
    if not CFG.PVP_GUARD or RUN.dead then return end
    local okH, hp = pcall(function() return tonumber(hum.Health) end)
    hp = (okH and hp) or nil
    if not hp then return end
    local now = tick()
    local win = tonumber(CFG.PVP_WIN) or 3
    if DEF.hpRefAt == 0 or (now - DEF.hpRefAt) >= win or hp > (DEF.hpRef or 0) then
      DEF.hpRef, DEF.hpRefAt = hp, now   -- بداية نافذة جديدة (أو تعافت: ما نحسبها نزول)
      return
    end
    local lost = (DEF.hpRef or 0) - hp
    if lost < (tonumber(CFG.PVP_DROP) or 15) then return end
    if (now - DEF.pvpLast) < (tonumber(CFG.PVP_CD) or 8) then return end
    DEF.pvpLast, DEF.pvpN = now, DEF.pvpN + 1
    if not isRunning then return end   -- مبطّل أصلًا: ما لنا سبب نغرق السجل وأنت تتضرب
    -- (46) «انضربت = السكربت يوقف» كان اعتراضك الصريح: صارت راحة PVP_COOL ثانية ثم يكمل لحاله،
    --      وما نلمس isRunning. ولو فعّلت «هرب بالانتقال» ننتقل لآخر أرض آمنة قبل الراحة.
    local cool = math.max(3, tonumber(CFG.PVP_COOL) or 12)
    releaseHold(nil, nil)
    halt()
    crateBusy, crateBusySince = false, 0
    RUN.restUntil = tick() + cool
    -- ما نزوّد RUN.id ولا ننشئ دورة: المشية الحالية تطلع نفسها بأول عيّنة بعد الراحة
    -- (شوف RUN.restUntil في حلقات walkToTarget) — دورتان تمشّيان نفس الشخصية = من شكوى المنشور
    if CFG.ESC_TP and DEF.safePos then
      local okE = autoTp(DEF.safePos, "pvp-escape")
      log(("zPVP escape -> آخر أرض آمنة y=%.0f ok=%s"):format(DEF.safePos.Y, tostring(okE)))
    end
    log(("zPVP #%d -%.0f نقطة خلال %.1fث (صحتك %d) — راحة %dث ونكمّل لحالنا (ما نطفي السكربت)"):format(
      DEF.pvpN, lost, now - DEF.hpRefAt, math.floor(hp), cool))
    pcall(function()
      StatusText.Text = "⚔ اشتباك — راحة قصيرة ثم نكمّل"
      StatusText.TextColor3 = COL.WARN
    end)
    refreshBtns()
  end

  -- (34) «انتقل لصديق»: اسم تكتبه أنت → CFrame على أرض جنبه. لا أوتوماتيك، لا تتبّع، لا حالة لاعب
  local function normName(s)
    return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
  end
  local function findFriend(q)
    local ql = string.lower(q)
    local exact, pre = {}, {}
    pcall(function()
      for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp then
          local n = string.lower(tostring(pl.Name))
          local dn = n
          pcall(function()
            local d = pl.DisplayName
            if d and d ~= "" then dn = string.lower(tostring(d)) end
          end)
          if n == ql or dn == ql then
            exact[#exact + 1] = pl
          elseif #ql >= 3 and (n:sub(1, #ql) == ql or dn:sub(1, #ql) == ql) then
            pre[#pre + 1] = pl   -- بادئة: نقبلها لو وحيدة، مو «أ» تطلّع لك كل السيرفر
          end
        end
      end
    end)
    if #exact == 1 then return exact[1], "اسم مطابق" end
    if #exact > 1 then return exact[1], "أكثر من واحد بنفس الاسم" end
    if #pre == 1 then return pre[1], "بادئة وحيدة" end
    if #pre > 1 then return nil, "البادئة تطلع أكثر من واحد — دوّق الحروف" end
    return nil, "ما له اسم في السيرفر"
  end
  local function friendTp(qRaw)
    if not CFG.FRIEND_TP then
      log("zFRIEND off — زر «انتقال لصديق» مطفي (طاب الحركة)")
      return
    end
    if RUN.dead then log("zFRIEND — أنت ميت: ما ننتقل ولا نحرّك شي") return end
    if holding or crateBusy then
      log("zFRIEND — في إمساك/قفل دروب شغال: خلّصه أول عشان ما ينكسر")
      return
    end
    local now = tick()
    if now - DEF.friendAt < 6 then
      log(("zFRIEND — نستنى %.0fث بين انتقال وانتقال (الكتابة المتكررة = مطاطية)"):format(6 - (now - DEF.friendAt)))
      return
    end
    local q = normName(qRaw)
    if q == "" then
      log("zFRIEND — اكتب الاسم أول: الأسماء الحاضرة في طاب «أهداف» (أسماء بس)")
      return
    end
    local pl, how = findFriend(q)
    if not pl then
      log(("zFRIEND no-match [%s] — %s"):format(asc(q), tostring(how)))
      return
    end
    if how == "أكثر من واحد بنفس الاسم" then
      log(("zFRIEND ambiguous [%s] — في أكثر من واحد بنفس الاسم: دوّق الحروف"):format(asc(q)))
      return
    end
    DEF.friendAt, DEF.friend, DEF.friendN = now, q, DEF.friendN + 1
    local tr, th = nil, nil
    pcall(function()
      local c = pl.Character
      if c then tr, th = c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid") end
    end)
    if not tr or not th or (tonumber(th.Health) or 0) <= 0 then
      log(("zFRIEND [%s] ما له شخصية واقفة الحين — ما ننتقل لواحد مو موجود"):format(asc(pl.Name)))
      return
    end
    local r = rootOf()
    if not r then return end
    -- جنبه، جهة مكاننا، وبرمشة على الأرض: ما ننزّل داخل جسمه ولا داخل جدار ولا في الهواء
    local tp = tr.Position
    local away = r.Position - tp
    away = Vector3.new(away.X, 0, away.Z)
    if away.Magnitude < 1 then away = Vector3.new(0, 0, -1) end
    local aim = tp + away.Unit * 4
    local hit = nil
    pcall(function()
      local ray = Workspace:Raycast(Vector3.new(aim.X, aim.Y + 5, aim.Z), Vector3.new(0, -16, 0), rayParams())
      hit = ray and ray.Position
    end)
    local dist = (tp - r.Position).Magnitude
    DEF.backPos, DEF.backName = r.Position, tostring(pl.Name)
    log(("zFRIEND #%d -> [%s] (%s) d=%.0f — كتابة CFrame بزر منك، و«ارجع لمكانك» تلغيها"):format(
      DEF.friendN, asc(pl.Name), asc(how), dist))
    if isRunning then
      -- مشية شغالة + كتابة CFrame بنفس اللحظة = مطاطية: نفكّ الإدخال ونخلي الدورة تعيد الحساب
      halt()
      log("zFRIEND — الفرم شغال: وقّفنا الإدخال، والمشية الحالية تعيد حساب المسار من مكانك الجديد")
    end
    local kept = tpTo(hit or aim, "friend:" .. tostring(pl.Name))
    pcall(function()
      UI.FriendBox.Text = q
      UI.FriendLbl.Text = string.format("آخر انتقال: %s (%s) %.0fم — %s %s",
        tostring(pl.Name), (hit and "أرض تحتـه" or "جنبه بدون رمشة"), dist,
        kept and "السيرفر خلّاك" or "رجّعك: نكمل مشي",
        DEF.backPos and ("| من " .. DEF.backName) or "| ما فيه مرجع")
    end)
  end
  local function friendBack()
    if not DEF.backPos then
      log("zFRIEND back — ما فيه مكان محفوظ: ما انتقلنا لصديق الحين")
      return
    end
    if RUN.dead or holding or crateBusy then
      log("zFRIEND back — في إمساك شغال أو أنت ميت: ما ننتقل")
      return
    end
    local p = DEF.backPos
    DEF.backPos, DEF.backName = nil, ""
    log(("zFRIEND back -> (%.0f, %.0f, %.0f) من [%s]"):format(p.X, p.Y, p.Z, asc(DEF.friend)))
    local kept = tpTo(p, "friend-back")
    pcall(function()
      UI.FriendLbl.Text = "الرجعة: " .. (kept and "السيرفر خلّاك" or "ما خلّاك — امشي أو دوس «استخدم أقرب نقل»")
    end)
  end

  -- مراقب الدفاع: قيد/أرض/اشتباك + قراءة «القياسات» — على ALIVE مو isRunning، عشان الأرض
  -- تنسجّل وأنت متمشّي عادي (نقطة الإرجاع تصير جاهزة قبل ما تحتاجها)
  task.spawn(function()
    while ALIVE do
      task.wait(0.6)
      local r, hum = rootOf()
      if r and hum then
        if tick() >= DEF.nextChk then
          DEF.nextChk = tick() + 0.5
          DEF.probe(r.Position, hum)
          DEF.consume()
          DEF.combat(hum)
        end
        local p = r.Position
        local up = math.max(0, tick() - BOOT)
        pcall(function()
          UI.DefLbl.Text = string.format(
            "قيد: %s  |  تجميد مشي %d  |  سقوط %d  |  اشتباك %d  |  أرض: %s",
            (DEF.heldWhy ~= "" and DEF.heldWhy) or "لا", DEF.frozenN, DEF.voidN, DEF.pvpN,
            DEF.groundY > -900 and string.format("%.1f", DEF.groundY) or "—")
          local ne, nd = nearestEnd(p)
          UI.PosLbl.Text = string.format(
            "موقعك: %.0f, %.1f, %.0f  |  أقرب تسليم: %s %.0fم  |  الصندوق: %.0fم  |  آخر أرض: %s",
            p.X, p.Y, p.Z,
            (ne and ne.n) or "—", (nd or 0),
            (CHEST_POS - p).Magnitude,
            (DEF.groundY > -900 and string.format("y=%.1f (%.0fم تحتك)", DEF.groundY, DEF.groundY - p.Y)) or "—")
          UI.RunLbl.Text = string.format(
            "جلسة %d:%02d  |  طوارئ %d  |  تجميد %d  |  قيد %d  |  اشتباك %d  |  انتقال صديق %d",
            math.floor(up / 60), math.floor(up % 60), DEF.panicN, DEF.frozenN,
            DEF.heldN, DEF.pvpN, DEF.friendN)
        end)
      end
    end
  end)

  UI.PanicBtn.MouseButton1Click:Connect(function() panic("زر") end)
  UI.GoBtn.MouseButton1Click:Connect(function()
    local q = nil
    pcall(function() q = UI.FriendBox.Text end)
    task.spawn(function() friendTp(q) end)   -- tpTo ينتظر (TP_VERIFY): ثريد لوحده، بلا pcall
  end)
  UI.BackBtn.MouseButton1Click:Connect(function() task.spawn(friendBack) end)
  UI.FriendBox.FocusLost:Connect(function(entered)
    local q = normName(UI.FriendBox.Text)
    UI.FriendBox.Text = q
    DEF.friend = q
    if entered then task.spawn(function() friendTp(q) end) end
  end)
  UI.KeyBtn.MouseButton1Click:Connect(function()
    CFG.PANIC_KEY = not CFG.PANIC_KEY
    log("zPANIC key=" .. tostring(CFG.PANIC_KEY) .. (CFG.PANIC_KEY and " — F7 يوقف كل شي" or " — F7 ما يسوي شي"))
    refreshBtns()
  end)
  UI.FreezeBtn.MouseButton1Click:Connect(function()
    CFG.FREEZE_HELD = not CFG.FREEZE_HELD
    log(("zFREEZE held=%s — %s"):format(tostring(CFG.FREEZE_HELD),
      CFG.FREEZE_HELD and "نوقف المشية لحظة ما تصير مقيّد"
        or "الفحص أول الدورة بس (سلوك v2h — لو شدّك واحد أثناء المشي كمّلنا ندفعك)"))
    refreshBtns()
  end)
  UI.AttachBtn.MouseButton1Click:Connect(function()
    CFG.ATTACH_SEE = not CFG.ATTACH_SEE
    log(("zFREEZE attach=%s — %s"):format(tostring(CFG.ATTACH_SEE),
      CFG.ATTACH_SEE and "الربط الخارجي/Anchored = قيد (لو وقّف الفرم وأنت راكب سيارة: أطفيها)"
        or "الربط الخارجي مو قيد: ما نوقف وأنت مربوط بمقعد/مقود"))
    refreshBtns()
  end)
  UI.VoidBtn.MouseButton1Click:Connect(function()
    CFG.VOID_GUARD = not CFG.VOID_GUARD
    log(("zVOID guard=%s — %s"):format(tostring(CFG.VOID_GUARD),
      CFG.VOID_GUARD and "السقوط تحت آخر أرض يوقف المشي (والإرجاع بس مع «انتقال وقت الضرورة»)"
        or "ما نتدخل وقت السقوط"))
    refreshBtns()
  end)
  UI.PvpBtn.MouseButton1Click:Connect(function()
    CFG.PVP_GUARD = not CFG.PVP_GUARD
    log(("zPVP guard=%s — %s"):format(tostring(CFG.PVP_GUARD),
      CFG.PVP_GUARD and ("نزول " .. tostring(CFG.PVP_DROP) .. " نقطة بـ" .. tostring(CFG.PVP_WIN) .. "ث = توقف")
        or "ما نقرأ النزول السريع: الفرم يكمّل وأنت تنضرب"))
    refreshBtns()
  end)
  UI.FriendBtn.MouseButton1Click:Connect(function()
    CFG.FRIEND_TP = not CFG.FRIEND_TP
    log(("zFRIEND enabled=%s — %s"):format(tostring(CFG.FRIEND_TP),
      CFG.FRIEND_TP and "زر الانتقال للصديق شغّال (بضغطة منك وباسم تكتبه)"
        or "مقفل: ولا انتقال باسم، ولا كتابة CFrame من هذا الباب"))
    refreshBtns()
  end)
end

-- ═══════════ (36-39) «تيسير»: رسم لأغراض اللعبة + فيزياء على هيومانك أنت ═══════════
-- الحدود هنا نفس حدود السكربت كله: الرسم على صناديق اللعبة نفسها — ونفس القائمة اللي الفرم
-- يمشي لها (nearPrompts، وفيها charHosted تطلع برومبتات الشخصيات) — فما يصير ولا Highlight
-- فوق راس لاعب. نسخة v7.1i كانت ترسم اسم/رتبة/صحة/مسافة كل لاعب + أيمبوت + كلبشة لاعب:
-- اللي يمسّ لاعب ثاني ما وافق ما جانا له، وحتى لو «ما اشتكى أحد» فالحظر يجي من السيرفر مو من المشتري.
-- الكتابة على الهيومانك (نطة) مسموحة لأنها جسمك أنت — تحت زر أحمر، وبرقم ترجّعه، مثل (28) تمامًا.
do
  local Q = {
    hl = {}, tg = {}, n = 0, blips = {}, radN = 0,
    jUse = nil, jVal = nil, jBase = "—", jWrites = 0, jFix = 0,
    fov0 = nil, fovSet = -1,
  }
  -- الرسم نعلّقه في PlayerGui (مكان BillboardGui/Highlight المضمون مع Adornee) — وما لقيناه نستخدم شاشتنا
  pcall(function() Q.pg = lp:FindFirstChild("PlayerGui") end)
  DEF.qol = Q

  -- البرومبت نفسه جزء، أو أول جزء داخل الكائن اللي عليه (بلا هذا الرسم يروح في لا-مكان)
  local function hostOf(d)
    local h = d and d.Parent
    if not h then return nil end
    local ok, p = pcall(function()
      if h:IsA("BasePart") then return h end
      return h:FindFirstChildWhichIsA("BasePart")
    end)
    if ok and p then return p end
    return nil
  end

  local function mark(key, part, txt, col, fill)
    if not key or not part or not part.Parent then return end
    local holder = Q.pg or ScreenGui
    local hl = Q.hl[key]
    if hl and hl.Parent == nil then hl = nil end
    if not hl then
      if Q.n >= 10 then return end   -- الحد الحقيقي 31 لكل عميل: تجاوزها = رسم ميت + لاق (v7.1i)
      local a = Instance.new("Highlight")
      a.FillColor = col; a.FillTransparency = fill
      a.OutlineColor = COL.WHITE; a.OutlineTransparency = 0.2
      a.Adornee = part
      a.Name = "RavenEsp"
      local okA = pcall(function() a.Parent = holder end)
      if not okA then a:Destroy(); return end
      local t = Instance.new("BillboardGui")
      t.Size = UDim2.new(0, 168, 0, 20)
      t.StudsOffset = Vector3.new(0, 2.6, 0)
      t.AlwaysOnTop = true
      t.MaxDistance = 480
      t.Adornee = part
      t.Name = "RavenEspTag"
      local l = Instance.new("TextLabel")
      l.BackgroundTransparency = 1
      l.Font = Enum.Font.GothamBold
      l.TextSize = 12
      l.TextXAlignment = Enum.TextXAlignment.Center
      l.TextStrokeTransparency = 0.15
      l.TextColor3 = col
      l.Text = txt
      l.Size = UDim2.new(1, 0, 1, 0)
      l.Parent = t
      local okT = pcall(function() t.Parent = holder end)
      if not okT then t:Destroy(); a:Destroy() return end
      Q.hl[key] = a; Q.tg[key] = { gui = t, lbl = l }; Q.n = Q.n + 1
    else
      local t = Q.tg[key]
      if t and t.lbl.Text ~= txt then t.lbl.Text = txt end
    end
  end

  local function dropOne(key)
    local hl = Q.hl[key]
    if hl then pcall(function() hl:Destroy() end) end
    local t = Q.tg[key]
    if t then pcall(function() t.gui:Destroy() end) end
    Q.hl[key], Q.tg[key] = nil, nil
    if hl or t then Q.n = math.max(0, Q.n - 1) end
  end
  local function clearEsp()
    for key in pairs(Q.hl) do dropOne(key) end
  end

  -- كنس واحد يخدم الرسم والرادار سوا: nearPrompts فيه charHosted يطلّع برومبتات الشخصيات،
  -- فكل نقطة تطلع من هنا هي لأغراض اللعبة (صندوق/نقل/نقطة تسليم) — ولا واحدة عن لاعب.
  -- (الدوال الأربعة تحت معلّقة حقول في Q، مو locals: سقف Luau 200 متغيّر فعّال للشنكل الواحد
  --  وهذا الشنكل الواحد قريب من السقف — الحقول ما تُعدّ بعد ما يخلص النطاق، فتخلّي المجال فاضي)
  Q.scan = function()
    local rng = math.max(tonumber(CFG.DROP_RADIUS) or 60, tonumber(CFG.RADAR_RANGE) or 180)
    local ok, list = pcall(nearPrompts, rng)
    if ok and type(list) == "table" then return list end
    return nil
  end

  local function refreshEsp(list)
    for key in pairs(Q.hl) do
      if not key.Parent then dropOne(key) end
    end
    Q.tpN = 0   -- كل كنس يعّد من الصفر: بلا هالسطر يبقى عدّ النقل القديم لو طفيت الزر
    local me = rootOf()
    if not me then return end
    if CFG.ESP_DROP and list then
      local dmax = tonumber(CFG.DROP_RADIUS) or 60
      for i = 1, math.min(#list, 10) do
        local e = list[i]
        if e.dist <= dmax then
          mark(e.p, hostOf(e.p), ("📦 دروب %.0fم"):format(e.dist), COL.WARN, 0.55)
        end
      end
    end
    if CFG.ESP_CRATE then
      local okC, cp = pcall(findChestPrompt)
      if okC and cp then mark(cp, hostOf(cp), "🎁 صندوق التسليم", COL.OK, 0.5) end
      local okA, _, part = pcall(activeEnd)
      if okA and part and part.Parent then
        mark(part, part, "🎯 نقطة التسليم", COL.NUM, 0.45)
      else
        -- (48) ما فيه نقطة تسليم حية (لسه ما استلمنا): الأجزاء الثلاثة ثابتة وشفافة،
        -- فما تشوفها بالعين. نلمّع الأقرب لك منها بس — تعرف وين تسلّم أول ما تستلم.
        local e = nearestEnd(me.Position)
        if e and (e.p - me.Position).Magnitude <= 400 then
          local okP, ep = pcall(function()
            return Workspace.DeliveryCrates.CratesEndPoints:FindFirstChild(e.n)
          end)
          if okP and ep then mark(ep, ep, ("🎯 %s %.0fم"):format(e.n, (e.p - me.Position).Magnitude), COL.NUM, 0.4) end
        end
      end
    end
    -- (50) نقاط النقل: أقرب ثلاث، باسمها الحيّ من البرومبت («ماب الشات»/«ماب ال afk»). رسم بس.
    if CFG.TP_SEE then
      local okT, tps = pcall(tpList, 400)
      if okT and type(tps) == "table" then
        Q.tpN = #tps
        for i = 1, math.min(#tps, 3) do
          local t = tps[i]
          local nm = "انتقال"
          pcall(function() if t.p.ActionText ~= "" then nm = tostring(t.p.ActionText) end end)
          mark(t.p, hostOf(t.p), ("🚪 %s %.0fم"):format(nm, t.dist), COL.BLUE, 0.5)
        end
      end
    end
  end

  -- ── (41) رادار الماب: إسقاط إحداثيات العالم على دائرة تدور مع كامرتك (فوق = أمامك) ──
  -- المصادر كلها اللعبة: قائمة الدروب المكتشفة + صندوق التسليم + نقطة التسليم الحية + نقاط
  -- النقل. مافي Players:GetPlayers() هنا ولا في أي مسار رسم: الرادار حق الصناديق مو حق الناس.
  Q.dot = function(i)
    local b = Q.blips[i]
    if not b then
      b = Instance.new("Frame")
      b.BorderSizePixel = 0
      b.Name = "RadarDot"
      pcall(function()
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = b
      end)
      pcall(function() b.Parent = UI.RadFrame end)
      Q.blips[i] = b
    end
    return b
  end

  Q.hide = function()
    for i = 1, #Q.blips do Q.blips[i].Visible = false end
    Q.radN = 0
  end

  Q.draw = function(list, r)
    if not r or not UI.RadFrame then return end
    local lv, rv = nil, nil
    local okF, l, rr = pcall(function()
      local cam = Workspace.CurrentCamera
      if not cam then return nil end
      return cam.CFrame.LookVector, cam.CFrame.RightVector
    end)
    if okF and l and rr then lv, rv = l, rr end
    if not lv then lv = Vector3.new(0, 0, -1); rv = Vector3.new(1, 0, 0) end
    local okR, dia = pcall(function() return UI.RadFrame.AbsoluteSize.X end)
    local R = (okR and dia or 0) * 0.5
    if R < 18 then return end
    local rng = math.max(60, tonumber(CFG.RADAR_RANGE) or 180)
    local scale = (R - 7) / rng
    local mx, mz = r.Position.X, r.Position.Z
    local n = 0
    local function put(pos, col, sz)
      if not pos or n >= 26 then return end
      n = n + 1
      local dx, dz = pos.X - mx, pos.Z - mz
      local ahead = dx * lv.X + dz * lv.Z
      local right = dx * rv.X + dz * rv.Z
      local dd = math.sqrt(ahead * ahead + right * right)
      if dd > rng then
        local kk = rng / dd
        ahead, right = ahead * kk, right * kk
      end
      local b = Q.dot(n)
      b.BackgroundColor3 = col
      b.Size = UDim2.fromOffset(sz, sz)
      b.Position = UDim2.new(0.5, right * scale - sz / 2, 0.5, -ahead * scale - sz / 2)
      b.Visible = true
    end
    if list then
      for i = 1, #list do
        local e = list[i]
        if e.dist <= rng then put(e.host, COL.WARN, 8) end
      end
    end
    local okC, cp = pcall(findChestPrompt)
    if okC and cp then
      local hp = hostOf(cp)
      if hp then put(hp.Position, COL.OK, 6) end
    else
      -- (48) صندوق الاستلام ثابت بالماب (TakeChest): نرسمه حتى لو ما عرفنا نقراه،
      -- عشان الرادار ما يكون فاضي وأنت تدور وين تستلم.
      put(CHEST_POS, COL.OK, 6)
    end
    local okA, _, part = pcall(activeEnd)
    if okA and part then
      put(part.Position, COL.BLUE, 6)
    else
      -- (48) نقاط التسليم الثلاث المؤكدة من الفحص: ترسم لما ما فيه نقطة تسليم حية،
      -- فالرادار يوريك وين تمشي بدل ما يصمت أطول وقت الرحلة. (أغراض لعبة — مافي لاعب)
      for _, e in ipairs(ENDS) do put(e.p, COL.BLUE, 5) end
    end
    -- (50) نقاط نقل الماب: نقطة زرقاء صغيرة + اسم بالسطر تحت، عشان تعرف وين الباب وأنت تدور
    if CFG.TP_SEE then
      local okT, tps = pcall(tpList, rng)
      if okT and type(tps) == "table" then
        for i = 1, math.min(#tps, 6) do put(tps[i].pos, COL.DOT_ON, 5) end
      end
    end
    if CFG.PAD_SEE then
      local okP, pads = pcall(padList, rng)
      if okP and type(pads) == "table" then
        for i = 1, math.min(#pads, 8) do put(pads[i].pos, COL.DOT_ON, 5) end
      end
    end
    for i = n + 1, #Q.blips do Q.blips[i].Visible = false end
    Q.radN = n
    pcall(function()
      UI.RadarLbl.Text = (n == 0) and "نقاط: 0 — ما فيه هدف بالمدى"
        or ("نقاط: %d  |  مدى %dم"):format(n, math.floor(rng))
    end)
  end

  -- (37) نطة عالية: كتابة على هيومانك أنت. نحفظ رقمك أول مرة ونرجّعه لما تطفّي.
  -- القوس بـ JumpHeight (متر)، وبـ JumpPower (legacy) لازم نحسبه من جاذبية الماب الحيّة:
  -- v = √(2gh) — لو كتبنا رقم ثابت على جاذبية مختلفة تطلع النطة أقصر أو تخطفك فوق السقف.
  local function applyJump(h)
    local want = math.max(4, math.min(20, tonumber(CFG.HJUMP_H) or 10))
    if Q.jVal == nil then
      local okR, use, val = pcall(function() return h.UseJumpPower, (h.UseJumpPower and h.JumpPower or h.JumpHeight) end)
      if not okR or val == nil then return end
      Q.jUse, Q.jVal = use, val
      Q.jWrites, Q.jFix = 0, 0   -- كل تشغيل جديد يبدأ عدّ من الصفر: «تثبيت» = اللعبة رجّعت رقمنا
      Q.jBase = use and tostring(math.floor((val or 0) + 0.5)) .. " قوة"
        or tostring(math.floor(((val or 0) * 10) + 0.5) / 10) .. "م"
    end
    local tgt = want
    if Q.jUse then
      local okG, g = pcall(function() return Workspace.Gravity end)
      tgt = math.sqrt(2 * ((okG and g and g > 20) and g or 196.2) * want)
    end
    local cur
    if Q.jUse then cur = prGet(h, "JumpPower", nil) else cur = prGet(h, "JumpHeight", nil) end
    if type(cur) ~= "number" or math.abs(cur - tgt) > 0.3 then
      local okW = pcall(function()
        if Q.jUse then h.JumpPower = tgt else h.JumpHeight = tgt end
      end)
      if okW then
        Q.jWrites = Q.jWrites + 1
        if Q.jWrites > 1 then Q.jFix = Q.jFix + 1 end   -- اللعبة رجّعت رقمنا وثبّتناه مرة ثانية
      end
    end
  end
  local function restoreJump(h)
    if Q.jVal == nil then return end
    local use, val = Q.jUse, Q.jVal
    Q.jVal, Q.jUse, Q.jBase = nil, nil, "—"
    pcall(function()
      if use then h.JumpPower = val else h.JumpHeight = val end
    end)
    log(("zJUMP off — رجّعنا رقمك (%s) بعد %d كتابة"):format(tostring(val), Q.jWrites))
  end

  -- (39) FOV: كامرتك أنت، وما نكتب الخاصية إلا عند التغيير (كتابة كل فريم = لاق كاميرا)
  local function applyFov()
    local okC, cam = pcall(function() return Workspace.CurrentCamera end)
    if not okC or not cam then return end
    if Q.fov0 == nil then Q.fov0 = cam.FieldOfView end
    local want = math.floor(tonumber(CFG.FOV) or 70)
    if Q.fovSet ~= want then
      if pcall(function() cam.FieldOfView = want end) then Q.fovSet = want end
    end
  end

  local function writeQolLbl()
    pcall(function()
      UI.QolLbl.Text = string.format(
        "رسم %d/10  |  رادار %d  |  نقل %d  |  نطة %s (أصلك %s)  |  تثبيت %d  |  كاميرا %d",
        Q.n, Q.radN, Q.tpN or 0,
        CFG.HJUMP and (tostring(math.floor((tonumber(CFG.HJUMP_H) or 10) + 0.5)) .. "م") or "مطفية",
        Q.jBase, Q.jFix, Q.fovSet > 0 and Q.fovSet or math.floor(tonumber(CFG.FOV) or 70))
    end)
  end

  -- (38) نطة مستمرة: دوس مسافة وأنت في السقوط الحر = نطة ثانية على هيومانك.
  -- لا رافعة (BodyVelocity/BodyGyro) ولا CanCollide=false ولا Gravity — رافعة = الطيران اللي رفضناه.
  conn(UserInputService.JumpRequest:Connect(function()
    if not CFG.INF_JUMP or not ALIVE or RUN.dead or holding then return end
    local _, hum = rootOf()
    if not hum then return end
    local okS, st = pcall(function() return hum:GetState() end)
    if okS and st == Enum.HumanoidStateType.Freefall then
      pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    end
  end))

  -- مراقب التيسير: 0.5ث — كنس واحد للرسم + الرادار، ثم النطة/الكاميرا/الأسطر الحيّة
  task.spawn(function()
    while ALIVE do
      task.wait(0.5)
      if not ALIVE then break end
      local r, hum = rootOf()
      local needEsp = CFG.ESP_DROP or CFG.ESP_CRATE or CFG.TP_SEE
      local needRad = CFG.RADAR and r ~= nil and panels.tgt.Visible
      local list = (needEsp or needRad) and Q.scan() or nil
      if needEsp then pcall(refreshEsp, list)
      elseif Q.n > 0 then pcall(clearEsp) end
      if needRad then pcall(Q.draw, list, r)
      elseif Q.radN > 0 then pcall(Q.hide) end
      if hum and not RUN.dead then
        if CFG.HJUMP then pcall(applyJump, hum)
        elseif Q.jVal ~= nil then pcall(restoreJump, hum) end
      elseif hum and Q.jVal ~= nil then
        pcall(restoreJump, hum)
      end
      pcall(applyFov)
      writeQolLbl()
    end
  end)

  -- الإقفال العام: امسح الرسم، رجّع النطة، رجّع الكاميرا (shutdown ينادي هذا قبل يفصل الاتصالات)
  DEF.qolStop = function()
    clearEsp()
    pcall(Q.hide)
    local _, hum = rootOf()
    if hum then restoreJump(hum) end
    local okC, cam = pcall(function() return Workspace.CurrentCamera end)
    if okC and cam and Q.fov0 then pcall(function() cam.FieldOfView = Q.fov0 end) end
  end

  UI.EspBtn.MouseButton1Click:Connect(function()
    CFG.ESP_DROP = not CFG.ESP_DROP
    -- قفل الفئة = نمسح الكل ونعيد رسم اللي بقي مسموح (السوِب يحذف الميت بس، مو المقلوب)
    if not CFG.ESP_DROP then pcall(clearEsp) end
    log(("zESP drops=%s — %s"):format(tostring(CFG.ESP_DROP),
      CFG.ESP_DROP and "نرسم الدروب اللي كشفناه (صناديق اللعبة، سقف 10)"
        or "طلعنا رسومات الدروب"))
    refreshBtns()
  end)
  UI.EspCrateBtn.MouseButton1Click:Connect(function()
    CFG.ESP_CRATE = not CFG.ESP_CRATE
    if not CFG.ESP_CRATE then pcall(clearEsp) end
    log(("zESP crate=%s — %s"):format(tostring(CFG.ESP_CRATE),
      CFG.ESP_CRATE and "نرسم صندوق التسليم + نقطة التسليم الحية"
        or "طلعنا رسومات التسليم"))
    refreshBtns()
  end)
  UI.TpEspBtn.MouseButton1Click:Connect(function()
    CFG.TP_SEE = not CFG.TP_SEE
    if not CFG.TP_SEE then pcall(clearEsp) end
    log(("zESP tp=%s — %s"):format(tostring(CFG.TP_SEE),
      CFG.TP_SEE and "نرسم أبواب الماب (OtherPlaceTps) على الشاشة والرادار — رسم فقط، ما نضغط باب"
        or "طلعنا رسومات أبواب الماب"))
    refreshBtns()
  end)
  UI.RadarBtn.MouseButton1Click:Connect(function()
    CFG.RADAR = not CFG.RADAR
    if not CFG.RADAR then pcall(Q.hide) end
    log(("zRADAR on=%s — %s"):format(tostring(CFG.RADAR),
      CFG.RADAR and ("رادار أهداف: دروب/صندوق/نقطة تسليم/نقل — مدى " .. tostring(math.floor((tonumber(CFG.RADAR_RANGE) or 180) + 0.5)) .. "م")
        or "طلعنا نقاط الرادار (الرسم على الشاشة يكمّل لو شغّاله)"))
    refreshBtns()
  end)
  UI.HJumpBtn.MouseButton1Click:Connect(function()
    CFG.HJUMP = not CFG.HJUMP
    if CFG.HJUMP then
      log(("zJUMP on %sم — نكتب JumpHeight على هيومانك ونثبّته لين تطفّي الزر. مخاطرة كشف أعلى من زر الماب:"):format(
        tostring(math.floor((tonumber(CFG.HJUMP_H) or 10) + 0.5))))
      log("zJUMP — ما نكتب Gravity ولا نطير: النطة نفسها ما توصلك لمكان فوق جدار")
    else
      -- المراقب (0.5ث) هو اللي يرجّع الرقم: مكان واحد يكتب الهيومان، فما يصير سباق بين الزر والمراقب
      log(("zJUMP off — نوقف الكتابة ونرجّع رقمك (%s) أول مراقب"):format(Q.jBase))
    end
    refreshBtns()
  end)
  UI.InfJumpBtn.MouseButton1Click:Connect(function()
    CFG.INF_JUMP = not CFG.INF_JUMP
    log(("zJUMP inf=%s — %s"):format(tostring(CFG.INF_JUMP),
      CFG.INF_JUMP and "مسافة بالنص = نطة ثانية (طلب قفزتك أنت)"
        or "نطة ثانية بس لما تلمس الأرض"))
    refreshBtns()
  end)
end

-- تراكِر نصّي للأهداف الحية: دروب + نقطة التسليم + كول داون + الوقت بالثواني
-- محسوب من سرعتك المقاسة فعليًا (SPD.now). القائمة نفسها بلا رسمة — الرسم الاختياري
-- في «تيسير» وعلى صناديق اللعبة فقط، وما فيه ولا رسمة على لاعب (شوف راس الملف).
local function trackLabel()
  local r = rootOf()
  if not r then return end
  local spd = SPD.now or 0
  local function eta(dd)
    if spd < 0.6 then return "—" end
    return string.format("%.0fث", dd / spd)
  end
  local list = {}
  for d, info in pairs(PRMAP) do
    if d.Parent then
      local k = classify(info)
      if k == "drop" or k == "fresh" then
        local hp = prHostPos(d)
        if hp then
          local fAt = DROP_FAIL[d]
          list[#list + 1] = {
            dd   = (hp - r.Position).Magnitude,
            t    = tostring(info.txt),
            hold = tonumber(info.hold) or 0,
            mad  = tonumber(info.dist) or 0,
            dead = (fAt and tick() < fAt) or false,
          }
        end
      end
    end
  end
  table.sort(list, function(a, b) return a.dd < b.dd end)
  local lines = {}
  local carrying = false
  pcall(function() carrying = missionLive() end)
  lines[1] = string.format("الحالة: %s | commit=%s | سرعتك %.1f م/ث (WS %d)",
    carrying and "حاملين مهمة — التسليم يكسب" or "فاضي — الدروب يكسب",
    tostring(CFG.COMMIT), spd, math.floor(SPD.ws + 0.5))
  if tick() < chestCdUntil then
    lines[#lines + 1] = string.format("⏳ كول داون الصندوق: %.1fث باقي", chestCdUntil - tick())
  end
  local pos = nil
  pcall(function() pos = activeEnd() end)
  if pos then
    local dd = (pos - r.Position).Magnitude
    lines[#lines + 1] = string.format("📍 نقطة التسليم: %.0fم ≈ %s", dd, eta(dd))
  else
    -- (50) ما فيه نقطة حية (لسه ما استلمنا / كول داون): نوري أقرب نقطة مؤكدة من الفحص
    local e, dd = nearestEnd(r.Position)
    if e then
      lines[#lines + 1] = string.format("📍 أقرب تسليم (%s): %.0fم ≈ %s", e.n, dd, eta(dd))
    end
  end
  if tick() < FLIP.lockUntil then
    lines[#lines + 1] = string.format("🔒 حارس التبديل: مقفل على التسليم %.0fث (تبديلات %d)",
      FLIP.lockUntil - tick(), FLIP.n)
  end
  if tick() < DP.lockUntil then
    lines[#lines + 1] = string.format("🧊 الدروب على الرفّ: %.0fث (نافذتين بلا غنيمة — عشان ما يتحرّج)",
      DP.lockUntil - tick())
  elseif DP.strikes > 0 then
    lines[#lines + 1] = string.format("⚠️ نافذة دروب فاشلة %d/2 — بعدها يروح على الرفّ", DP.strikes)
  end
  local n = 0
  for i = 1, math.min(6, #list) do
    local e = list[i]
    n = n + 1
    lines[#lines + 1] = string.format("%s🎁 [%s] %.0fم ≈ %s hold=%.1f mad=%.0f",
      e.dead and "✖" or "   ", e.t, e.dd, eta(e.dd), e.hold, e.mad)
  end
  if n == 0 then lines[#lines + 1] = "🎁 ما فيه دروب حي قريب (مدى الكنس " .. tostring(CFG.DROP_SCAN) .. "م)" end
  if HUNT.skips > 0 or (HUNT.fails or 0) > 0 or (HUNT.carrySkips or 0) > 0 then
    lines[#lines + 1] = string.format("سجّل: مقاطعات محجوزة %d | إمساك فشل %d | مهملة %d | رفضنا دروب وأنت حامل %d",
      HUNT.skips, HUNT.blocked, HUNT.fails or 0, HUNT.carrySkips or 0)
  end
  -- (35) الأسماء هنا مُلتَقِط لزر «انتقال لصديق» فقط — مش رادار ناس: تنمسح لما يكون الزر مطفي،
  -- وما فيها صحة ولا رتبة ولا مسافة ولا رسمة على جسم حد (اللي يمسّ لاعب ثاني في «مرفوض» فوق).
  if CFG.FRIEND_TP then
    local who = {}
    pcall(function()
      for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp then who[#who + 1] = tostring(pl.Name) end
      end
    end)
    table.sort(who)
    if #who > 0 then
      local show = {}
      for i = 1, math.min(8, #who) do show[#show + 1] = who[i] end
      lines[#lines + 1] = "🤝 أسماء للالتقاط (زر انتقال صديق): " .. table.concat(show, ", ") ..
        (#who > 8 and (" … والباقي " .. (#who - 8)) or "")
      lines[#lines + 1] = "   انسخ الاسم لطاب الحركة — لا صحة، لا رتبة، لا مسافة، لا رسم على أحد"
    end
  end
  pcall(function() UI.TgtTxt.Text = table.concat(lines, "\n") end)
end

